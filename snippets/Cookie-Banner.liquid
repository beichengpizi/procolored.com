        #shopify-pc__banner .shopify-pc__banner__content {
          width: 100% !important;
          max-width: none !important;
          margin: 0 !important;
          padding: 0 !important;
          background: transparent !important;
          border: 0 !important;
          box-shadow: none !important;
          border-radius: 0 !important;
        }
  
  
        #shopify-pc__banner h2,
        #shopify-pc__banner .shopify-pc__banner__title {
          margin:
            0
            0
            clamp(calc(24px * 0.667), calc(100vw * 24 / 1920), calc(24px * 2))
            0 !important;
          color: #000000 !important;
          font-size: clamp(calc(17px * 0.667), calc(100vw * 17 / 1920), calc(17px * 2)) !important;
          font-weight: 700 !important;
          line-height: 1.25 !important;
          letter-spacing: 0 !important;
        }
  
        #shopify-pc__banner p,
        #shopify-pc__banner .shopify-pc__banner__body,
        #shopify-pc__banner .shopify-pc__banner__message {
          margin:
            0
            0
            clamp(calc(15px * 0.667), calc(100vw * 15 / 1920), calc(15px * 2))
            0 !important;
          color: #000000 !important;
          font-size: clamp(calc(17px * 0.667), calc(100vw * 17 / 1920), calc(17px * 2)) !important;
          font-weight: 400 !important;
          line-height: 1.28 !important;
          letter-spacing: 0 !important;
        }
  
        #shopify-pc__banner a {
          color: #000000 !important;
          text-decoration: underline !important;
          text-underline-offset: 2px !important;
        }
  
        #shopify-pc__banner .shopify-pc__banner__btns,
        #shopify-pc__banner .shopify-pc__banner__buttons,
        #shopify-pc__banner .shopify-pc__banner__actions {
          display: flex !important;
          flex-direction: row !important;
          flex-wrap: nowrap !important;
          align-items: center !important;
          justify-content: flex-start !important;
          gap: clamp(calc(28px * 0.667), calc(100vw * 28 / 1920), calc(28px * 2)) !important;
          width: 100% !important;
          margin: 0 !important;
          padding: 0 !important;
        }
  
        #shopify-pc__banner .shopify-pc__banner__btn,
        #shopify-pc__banner .shopify-pc__banner__btn-wrapper {
          width: auto !important;
          max-width: none !important;
          flex: 0 0 auto !important;
          margin: 0 !important;
          padding: 0 !important;
        }
  
        #shopify-pc__banner button,
        #shopify-pc__banner #shopify-pc__banner__btn-manage-prefs,
        #shopify-pc__banner #shopify-pc__banner__btn-accept,
        #shopify-pc__banner #shopify-pc__banner__btn-decline {
          display: inline-flex !important;
          align-items: center !important;
          justify-content: center !important;
          width: auto !important;
          flex: 0 1 auto !important;
          min-width: clamp(calc(119px * 0.667), calc(100vw * 119 / 1920), calc(119px * 2)) !important;
          min-height: clamp(calc(37px * 0.667), calc(100vw * 37 / 1920), calc(37px * 2)) !important;
          margin: 0 !important;
          padding:
            clamp(calc(6px * 0.667), calc(100vw * 6 / 1920), calc(6px * 2))
            clamp(calc(10px * 0.667), calc(100vw * 10 / 1920), calc(10px * 2)) !important;
          border: 1px solid #000000 !important;
          border-radius: clamp(calc(5px * 0.667), calc(100vw * 5 / 1920), calc(5px * 2)) !important;
          background: #ffffff !important;
          color: #000000 !important;
          font-family: inherit !important;
          font-size: clamp(calc(17px * 0.667), calc(100vw * 17 / 1920), calc(17px * 2)) !important;
          font-weight: 400 !important;
          line-height: 1.2 !important;
          letter-spacing: 0 !important;
          text-align: center !important;
          text-decoration: none !important;
          white-space: nowrap !important;
          cursor: pointer !important;
          appearance: none !important;
          -webkit-appearance: none !important;
          box-shadow: none !important;
          transition: opacity 0.2s ease, transform 0.2s ease !important;
        }
  
        #shopify-pc__banner button:hover,
        #shopify-pc__banner #shopify-pc__banner__btn-manage-prefs:hover,
        #shopify-pc__banner #shopify-pc__banner__btn-accept:hover,
        #shopify-pc__banner #shopify-pc__banner__btn-decline:hover {
          opacity: 0.82 !important;
          
        }
  
        #shopify-pc__banner button:active,
        #shopify-pc__banner #shopify-pc__banner__btn-manage-prefs:active,
        #shopify-pc__banner #shopify-pc__banner__btn-accept:active,
        #shopify-pc__banner #shopify-pc__banner__btn-decline:active {
          transform: scale(0.98) !important;
        }
  
        #shopify-pc__banner #shopify-pc__banner__btn-manage-prefs {
          order: 1 !important;
          background: #ffffff !important;
          color: #000000 !important;
          font-size: 0 !important;
        }
  
        #shopify-pc__banner #shopify-pc__banner__btn-manage-prefs::after {
          content: "Preferences" !important;
          display: inline-block !important;
          color: #000000 !important;
          font-size: clamp(calc(17px * 0.667), calc(100vw * 17 / 1920), calc(17px * 2)) !important;
          font-weight: 400 !important;
          line-height: 1.2 !important;
          white-space: nowrap !important;
        }
  
        #shopify-pc__banner #shopify-pc__banner__btn-decline {
          order: 2 !important;
          min-width: clamp(calc(219px * 0.667), calc(100vw * 219 / 1920), calc(219px * 2)) !important;
          background: #000000 !important;
          color: #ffffff !important;
          font-size: 0 !important;
        }
  
        #shopify-pc__banner #shopify-pc__banner__btn-decline::after {
          content: "Necessary Cookies Only" !important;
          display: inline-block !important;
          color: #ffffff !important;
          font-size: clamp(calc(17px * 0.667), calc(100vw * 17 / 1920), calc(17px * 2)) !important;
          font-weight: 400 !important;
          line-height: 1.2 !important;
          white-space: nowrap !important;
        }
  
        #shopify-pc__banner #shopify-pc__banner__btn-accept {
          order: 3 !important;
          background: #000000 !important;
          color: #ffffff !important;
        }
  
        @media screen and (max-width: 768px) {
          #shopify-pc__banner {
            left: 0;
            width: 100vw !important;
            max-width: 100vw !important;
            border-right: 0 !important;
            padding:
              clamp(calc(10px * 0.85), calc(100vw * 10 / 375), calc(10px * 1.15))
              clamp(calc(16px * 0.85), calc(100vw * 16 / 375), calc(16px * 1.15)) !important;
          }
  
          #shopify-pc__banner h2,
          #shopify-pc__banner .shopify-pc__banner__title {
            margin-bottom: clamp(calc(10px * 0.85), calc(100vw * 10 / 375), calc(10px * 1.15)) !important;
            font-size: clamp(calc(16px * 0.85), calc(100vw * 16 / 375), calc(16px * 1.15)) !important;
            line-height: 1.25 !important;
          }
  
          #shopify-pc__banner p,
          #shopify-pc__banner .shopify-pc__banner__body,
          #shopify-pc__banner .shopify-pc__banner__message {
            margin-bottom: clamp(calc(18px * 0.85), calc(100vw * 18 / 375), calc(18px * 1.15)) !important;
            font-size: clamp(calc(12px * 0.85), calc(100vw * 12 / 375), calc(12px * 1.15)) !important;
            line-height: 1.35 !important;
          }
          #shopify-pc__banner .shopify-pc__banner__body{
            margin-bottom: 0 !important;
          }
  
          #shopify-pc__banner .shopify-pc__banner__btns,
          #shopify-pc__banner .shopify-pc__banner__buttons,
          #shopify-pc__banner .shopify-pc__banner__actions {
            display: flex !important;
            grid-template-columns: unset !important;
            flex-direction: row !important;
            flex-wrap: nowrap !important;
            align-items: center !important;
            justify-content: flex-start !important;
            gap: clamp(calc(8px * 0.85), calc(100vw * 8 / 375), calc(8px * 1.15)) !important;
            width: 100% !important;
            overflow: visible !important;
          }
  
          #shopify-pc__banner button,
          #shopify-pc__banner #shopify-pc__banner__btn-manage-prefs,
          #shopify-pc__banner #shopify-pc__banner__btn-accept,
          #shopify-pc__banner #shopify-pc__banner__btn-decline {
            width: auto !important;
            flex: 0 1 auto !important;
            min-height: clamp(calc(20px * 0.85), calc(100vw * 20 / 375), calc(20px * 1.15)) !important;
            padding:
              clamp(calc(6px * 0.85), calc(100vw * 6 / 375), calc(6px * 1.15))
              clamp(calc(8px * 0.85), calc(100vw * 8 / 375), calc(8px * 1.15)) !important;
            font-size: clamp(calc(11px * 0.85), calc(100vw * 11 / 375), calc(11px * 1.15)) !important;
            border-radius: clamp(calc(5px * 0.85), calc(100vw * 5 / 375), calc(5px * 1.15)) !important;
            white-space: nowrap !important;
          }
  
          #shopify-pc__banner #shopify-pc__banner__btn-manage-prefs {
            order: 1 !important;
          background: #ffffff !important;
          color: #000000 !important;
          font-size: 0 !important;
            min-width: clamp(calc(84px * 0.85), calc(100vw * 84 / 375), calc(84px * 1.15)) !important;
          }
  
          #shopify-pc__banner #shopify-pc__banner__btn-decline {
            font-size: 0 !important;
            min-width: clamp(calc(150px * 0.85), calc(100vw * 150 / 375), calc(150px * 1.15)) !important;
          }
  
          #shopify-pc__banner #shopify-pc__banner__btn-accept {
            min-width: clamp(calc(72px * 0.85), calc(100vw * 72 / 375), calc(72px * 1.15)) !important;
          }
  
          #shopify-pc__banner #shopify-pc__banner__btn-manage-prefs::after,
          #shopify-pc__banner #shopify-pc__banner__btn-decline::after {
            font-size: clamp(calc(11px * 0.85), calc(100vw * 11 / 375), calc(11px * 1.15)) !important;
            line-height: 1.2 !important;
            white-space: nowrap !important;
          }
        }
      `;

    const isBannerVisible = () => {
      const banner = document.querySelector(BANNER_SELECTOR);

      if (!banner || banner.hidden) {
        return false;
      }

      const computedStyle = window.getComputedStyle(banner);
      const rect = banner.getBoundingClientRect();

      return (
        computedStyle.display !== 'none' &&
        computedStyle.visibility !== 'hidden' &&
        computedStyle.opacity !== '0' &&
        rect.width > 0 &&
        rect.height > 0
      );
    };

    const injectCookieBannerStyle = () => {
      if (document.getElementById(STYLE_ID)) {
        return;
      }

      const style = document.createElement('style');
      style.id = STYLE_ID;
      style.textContent = COOKIE_BANNER_CSS;
      document.head.appendChild(style);
    };

    const removeCookieBannerStyle = () => {
      const style = document.getElementById(STYLE_ID);

      if (style) {
        style.remove();
      }
    };

    const updateCookieBannerStyle = () => {
      if (isBannerVisible()) {
        injectCookieBannerStyle();
      } else {
        removeCookieBannerStyle();
      }
    };

    updateCookieBannerStyle();

    const observer = new MutationObserver(() => {
      window.requestAnimationFrame(updateCookieBannerStyle);
    });

    observer.observe(document.documentElement, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['style', 'class', 'hidden', 'aria-hidden'],
    });

    window.addEventListener('resize', updateCookieBannerStyle);
    window.addEventListener('pageshow', updateCookieBannerStyle);
  })();
</script>

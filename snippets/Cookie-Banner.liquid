  (() => {
    const BANNER_SELECTOR = '#shopify-pc__banner';
    const STYLE_ID = 'custom-shopify-cookie-banner-style';

    const COOKIE_BANNER_CSS = `
        /* =========================================================
           Shopify Native Cookie Banner Custom Style
           仅当 #shopify-pc__banner 显示时才会被 JS 注入
           ========================================================= */
  
        #shopify-pc__banner {
   
        }
  

  window.ProcoloredPerformance.stabilizeSwiper(mySwiper, root);
  }

  window.setTimeout(function () {
  if (totalNums > displayNumberPerLine) {
  $root.find('.swiper-button-next-{{section.id}}').removeClass('swiper-button-disabled');

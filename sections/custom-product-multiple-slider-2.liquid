    bullet.classList.remove('page-dot-progress');
  });

  const activeBullet = root.querySelector(
    '.swiper-pagination-{{section.id}} .swiper-pagination-bullet-active'
  );

  if (activeBullet) {
    activeBullet.classList.add('page-dot-progress');
  }
  }

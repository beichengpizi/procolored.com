<script defer type="text/javascript">
  (function () {
  const sectionRoot = document.getElementById('detail-section6-{{section.id}}');
  if (!sectionRoot) return;

  const isSwiperAutoplay = {{ section.settings.is_swiper_autoplay }};
  const swiperAutoplayDelay = {{ section.settings.swiper_autoplay_delay | default: 2000 | plus: 0 }};
  const showSwiperPc = {{ section.settings.show_swiper_pc }};
  const showSwiperMobile = {{ section.settings.show_swiper_mobile }};
  const displayNumberPerLine = {{ section.settings.display_number_per_line | plus: 0 }};
  const displayNumberPerLineMobile = {{ section.settings.display_number_per_line_mobile | plus: 0 }};
  const totalNums = {{ section.blocks.size }};
  const detectMobile = function () {
  if (typeof window.isMobile === 'function') {
  return window.isMobile();
  }

  return window.innerWidth <= 768;
  };

  const updateTouchState = function (swiperInstance) {
  if (!swiperInstance) return;
  swiperInstance.allowTouchMove = detectMobile()
  ? totalNums !== displayNumberPerLineMobile
  : totalNums !== displayNumberPerLine;
  };

  const syncButtonVerticalAlign = function (root) {
  root
  .querySelectorAll('.swiper-button-next-{{section.id}}, .swiper-button-prev-{{section.id}}')
  .forEach(function (button) {
  const parent = button.offsetParent;
  if (!parent) return;

  const parentHeight = parent.getBoundingClientRect().height;
  const computedTop = parseFloat(window.getComputedStyle(button).top);
  const centeredTop = parentHeight / 2;
  const shouldCenter =
  Number.isFinite(computedTop) &&
  parentHeight > 0 &&
  Math.abs(computedTop - centeredTop) <= 1;

  button.style.transform = shouldCenter ? 'translateY(-50%)' : 'none';
  });
  };

  const initSection = function (root) {
  const $ = window.jQuery;
  if (!$ || typeof Swiper === 'undefined') return false;

  const $root = $(root);
  const $swiper = $root.find('.detail-section6-mySwiper-{{section.id}}');
  const $flexBox = $root.find('.multiple-flex-box-{{section.id}}');

  if (!$swiper.length) return true;

  if (!detectMobile() && !showSwiperPc) {
  $swiper.css('display', 'none');
  $flexBox.css('display', 'flex');
  return true;
  }

  if (!showSwiperMobile && detectMobile()) {
  $swiper.css('display', 'none');
  $flexBox.css('display', 'flex');
  return true;
  }

  $swiper.css('display', 'block');
  $flexBox.css('display', 'none');

  if ($swiper[0].swiper && !$swiper[0].swiper.destroyed) {
  updateTouchState($swiper[0].swiper);
  syncButtonVerticalAlign(root);
  return true;
  }

  const paginationEl = $root.find('.swiper-pagination-{{section.id}}')[0];
  const nextButtonEl = $root.find('.swiper-button-next-{{section.id}}')[0];
  const prevButtonEl = $root.find('.swiper-button-prev-{{section.id}}')[0];
  const scrollbarEl = $root.find('.swiper-scrollbar-{{section.id}}')[0];

  var mySwiper = new Swiper($swiper[0], {
  loop: totalNums > 1,
  loopedSlides: totalNums > 0 ? Math.min(totalNums, 10) : 1,
  observer: true,
  observeParents: true,
  noSwiping: true,
  autoplay: isSwiperAutoplay
  ? {
    delay: swiperAutoplayDelay,
    disableOnInteraction: false,
  }
  : false,
  slidesPerView: displayNumberPerLine,
  spaceBetween: 24,
  pagination: {
  el: paginationEl,
  clickable: true,
  },
  navigation: {
  nextEl: nextButtonEl,
  prevEl: prevButtonEl,
  },
  scrollbar: {
  el: scrollbarEl,
  hide: false,
  },
  on: {
  init: function () {
  updateTouchState(this);
  syncButtonVerticalAlign(root);

  window.setTimeout(function () {
    root.querySelectorAll('.swiper-pagination-{{section.id}} .swiper-pagination-bullet').forEach(function (
      bullet,
      idx
    ) {
      bullet.addEventListener('mouseenter', function () {
        mySwiper.slideToLoop(idx, 300, false);
      });
    });
  }, 0);
  },
  imagesReady: function () {

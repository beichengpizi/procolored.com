<style>
    :root {
        /* Font sizes */
        --text-h0-n: 56px;
        --text-h1-n: 40px;
        --text-h2-n: 30px;
        --text-h3-n: 26px;
        --text-h4-n: 24px;
        --text-h5-n: 20px;
        --text-h6-n: 16px;
        --text-xs-n: 12px;
        --text-sm-n: 14px;
        --text-base-n: 18px;
        --text-lg-n: 19px;
      }
      .text-xxs {
        font-size: 10px;
        line-height: 1.3;
      }

      .text-xs {
        font-size: var(--text-xs-n);
        line-height: 1.3;
      }

      .text-sm {
        font-size: var(--text-sm-n);
        line-height: 1.3;
      }

      .text-base {
        font-size: var(--text-base-n);
        line-height: 1.3;
      }
      .text-md {
        font-size: var(--text-md-n);
        line-height: 1.2;
      }

      .text-lg {
        font-size: var(--text-lg-n);
        line-height: 1.2;
      }
   /* 重置样式 start*/
   #detail-section6-{{section.id}}  .h0 {
    font-size: var(--text-h0-n) ;
    line-height: 1;

  }

  #detail-section6-{{section.id}}  h1,
  #detail-section6-{{section.id}}  .h1,
  #detail-section6-{{section.id}}  .prose h1:not(.h0, .h1, .h2, .h3, .h4, .h5, .h6) {
    font-size: var(--text-h1-n) ;
    line-height: 1.1;

  }

  #detail-section6-{{section.id}}  h2,
  #detail-section6-{{section.id}}  .h2,
  #detail-section6-{{section.id}}  .prose h2:not(.h0, .h1, .h2, .h3, .h4, .h5, .h6) {
    font-size: var(--text-h2-n);
    line-height: 1.1;

  }

  #detail-section6-{{section.id}}  h3,
  #detail-section6-{{section.id}}  .h3,
  #detail-section6-{{section.id}}  .prose h3:not(.h0, .h1, .h2, .h3, .h4, .h5, .h6) {
    font-size: var(--text-h3-n) ;
    line-height: 1.2;
  }

  #detail-section6-{{section.id}}  h4,
  #detail-section6-{{section.id}}  .h4,
  #detail-section6-{{section.id}}  .prose h4:not(.h0, .h1, .h2, .h3, .h4, .h5, .h6) {
    font-size: var(--text-h4-n) ;
    line-height: 1.3;
  }

  #detail-section6-{{section.id}}  h5,
  #detail-section6-{{section.id}}  .h5,
  #detail-section6-{{section.id}}  .prose h5:not(.h0, .h1, .h2, .h3, .h4, .h5, .h6) {
    font-size: var(--text-h5-n) ;
    line-height: 1.4;
  }

  #detail-section6-{{section.id}}  h6,
  #detail-section6-{{section.id}}  .h6,
  #detail-section6-{{section.id}}  .prose h6:not(.h0, .h1, .h2, .h3, .h4, .h5, .h6) {
    font-size: var(--text-h6-n) ;
    line-height: 1.4;
  }
  /* 重置样式 end*/
    /* 多个轮播 图文 */
    #detail-section6-{{section.id}}{
    background-color: {{section.settings.bg_color}};
    }
    #detail-section6-{{section.id}} .multiple-swiper-wrap {
      position: relative;
        {% if section.settings.show_full_width %}
          max-width:100%;
          padding: {{section.settings.padding_top}}px 50px {{section.settings.padding_bottom}}px 50px;
        {% else %}
        max-width:1200px;
        margin:auto;
        padding: {{section.settings.padding_top}}px 0 {{section.settings.padding_bottom}}px 0 ;
        {% endif %}
        {% if section.settings.swiper_button_position == '50' %}
          padding-left: calc({{section.settings.swiper_button_margin}}px + {{section.settings.swiper_button_size}}px);
          padding-right: calc({{section.settings.swiper_button_margin}}px + {{section.settings.swiper_button_size}}px);
        {% endif %}

    }

    #detail-section6-{{section.id}} .multiple-swiper-wrap .heading {
        text-align: center;
        color: {{section.settings.heading_text}};
        margin-bottom: {{section.settings.title_to_content_padding}}px;




    }

    #detail-section6-{{section.id}} .multiple-swiper-wrap .detail-section6-mySwiper-{{section.id}} {
        margin-left: auto;
        margin-right: auto;
        position: relative;
        overflow: hidden;
        list-style: none;
        z-index: 1;

    }
    {% if section.settings.swiper_button_position == '50' %}
      .detail-section6-mySwiper-{{section.id}} .swiper-slide:first-child {
        margin-left: 6px;
      }
    {% endif %}


    #detail-section6-{{section.id}} .multiple-swiper-wrap .swiper-slide-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: {{section.settings.card_bg_color}};
        padding: {{section.settings.card_padding_top_bottom}}px {{section.settings.card_padding_left_right}}px;
        border-radius: {{section.settings.card_radius_size}}px;
        width:99%;
    }



    #detail-section6-{{section.id}} .multiple-swiper-wrap .swiper-slide-content .content {

        text-align: {{ section.settings.text_position }};;
        color: {{section.settings.desc_text}};
        font-size:{{section.settings.desc_text_font_size}}px;
        line-height: 1.2;

    }
    #detail-section6-{{section.id}} .multiple-swiper-wrap .swiper-slide-content .image-container{
      position: relative;
      display: inline-block;
      overflow: hidden;
    }
    #detail-section6-{{section.id}} .multiple-swiper-wrap .swiper-slide-content .caption {
      position: absolute;
      bottom: {{section.settings.content_heading_top}}px;
      left: 0;
      right: 0;
      color: white;
      padding: 20px 0;
      transform: translateY(100%);
      transition: transform 0.3s ease-in-out;
      text-align: center;
      font-size: 15px;
      letter-spacing: 1px;

    }
    #detail-section6-{{section.id}} .multiple-swiper-wrap .swiper-slide-content .caption svg, #detail-section6-{{section.id}} .multiple-flex-box-{{section.id}} .multiple-flex-item .caption svg{
      fill: #fff;
      width: 12px;
      height: 12px;
      padding: 5.5px;
    }

    #detail-section6-{{section.id}} .multiple-swiper-wrap .swiper-slide-content .image-container:hover .caption {
      transform: translateY(0);
    }
    #detail-section6-{{section.id}} .multiple-swiper-wrap .swiper-slide img, #detail-section6-{{section.id}} .multiple-flex-box-{{section.id}} .multiple-flex-item img{
        max-width: 100%;
        max-height: 100%;
        margin-bottom: {{section.settings.content_heading_top}}px;
        border-radius: {{section.settings.image_radius_size}}px;
        {% if section.settings.show_icon_model %}
          margin-bottom:0;
        {% else %}
        width: 100%;
        {% endif %}
    }
    #detail-section6-{{section.id}} .video-banner .video-link{
      position:relative;

    }
    #detail-section6-{{section.id}} .video-banner .video-link .czvdo-play-icon-svg{
      position:absolute;
      top:50%;
      left:50%;
      transform:translate(-50%,-50%);
      font-size: 30px;
      color: #fff;

    }
    #detail-section6-{{section.id}}  .icon-image-wrap{
    min-height:{{  section.settings.icon_height_size }}px;
    }
    #detail-section6-{{section.id}}  .icon-image-container{
      padding: 12px;
      display: flex;
      {% if section.settings.show_icon_background %}
        background:{{  section.settings.icon_bg_color }};
      {% else %}

      {% endif %}
      justify-content: center;
      align-items: center;
      border-radius: 50%;
    }


    /* 修改swiper 前进 后退按钮样式 */
    #detail-section6-{{section.id}} .swiper-button-next ,
    #detail-section6-{{section.id}} .swiper-button-prev  {
    position: absolute;
    top: {{ section.settings.swiper_button_position }}%;
    width: {{section.settings.swiper_button_size}}px;
    height: {{section.settings.swiper_button_size}}px;
    margin-top: 0;
    background-color: {{ section.settings.swiper_button_bg_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;


    }
    #detail-section6-{{section.id}} .swiper-button-next svg,
    #detail-section6-{{section.id}} .swiper-button-prev svg {

        width: {{section.settings.swiper_button_icon_size}}px;
        height: {{section.settings.swiper_button_icon_size}}px;

    }
    #detail-section6-{{section.id}} .swiper-button-next svg path,
    #detail-section6-{{section.id}} .swiper-button-prev svg path {
      stroke: {{ section.settings.swiper_button_icon_color }};


    }

    {%- assign num = section.settings.display_number_per_line | plus: 0 -%}

    {% if section.blocks.size > num %}
      #detail-section6-{{section.id}}  .swiper-button-next.swiper-button-disabled, #detail-section6-{{section.id}}  .swiper-button-prev.swiper-button-disabled {
        opacity: 1;
        cursor: auto;
        pointer-events: none;
    }
    {% endif %}

  #detail-section6-{{section.id}} .swiper-button-next.swiper-button-disabled svg,
  #detail-section6-{{section.id}} .swiper-button-prev.swiper-button-disabled svg {

      width: {{section.settings.swiper_button_icon_size}}px;
      height: {{section.settings.swiper_button_icon_size}}px;

  }
  #detail-section6-{{section.id}} .swiper-button-next.swiper-button-disabled svg path,
  #detail-section6-{{section.id}} .swiper-button-prev.swiper-button-disabled svg path {
    stroke: {{ section.settings.swiper_button_icon_color }};

  }
    #detail-section6-{{section.id}} .swiper-button-next{

        {% if section.settings.swiper_button_position == '50' %}
          right: 0;
          {% else  %}
          right: 0;
        {% endif %}
    }

    #detail-section6-{{section.id}} .swiper-button-prev {

        {% if section.settings.swiper_button_position == '50' %}
          left: 0;
          {% else  %}
          left: 0;
        {% endif %}

    }
    #detail-section6-{{section.id}} .swiper-pagination-wrap{
      display: flex;
      justify-content: center;
      align-items: center;
      padding-top: 55px;
      height: auto;
    }
    #detail-section6-{{section.id}} .swiper-pagination-wrap .swiper-pagination-{{section.id}}{
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }
    #detail-section6-{{section.id}} .swiper-pagination-{{section.id}} .swiper-pagination-bullet::before {
      content: "";
      display: block;
      width: 100%;
      height: 100%;
      transition: transform 0.3s cubic-bezier(0.4,0,0.2,1);
    }
    #detail-section6-{{section.id}} .swiper-pagination-{{section.id}} .swiper-pagination-bullet:hover::before {
      transform: scale(1.15);
    }
    {% for block in section.blocks %}
      {% if block.type == 'multipleImageTextSlider' %}
        {% liquid
          assign pagination_desktop_image = block.settings.image_pc
          assign pagination_mobile_image = block.settings.image_mobile

          if pagination_desktop_image == blank
            assign pagination_desktop_image = pagination_mobile_image
          endif

          if pagination_mobile_image == blank
            assign pagination_mobile_image = pagination_desktop_image
          endif
        %}
        {% if pagination_desktop_image != blank %}
          #detail-section6-{{section.id}} .swiper-pagination-{{section.id}} .swiper-pagination-bullet:nth-child({{ forloop.index }})::before {
            background: url('{{ pagination_desktop_image | image_url: width: 304 }}') no-repeat center center / contain;
          }
        {% endif %}
      {% endif %}
    {% endfor %}
  {% comment %}
      #detail-section6-{{section.id}} .swiper-pagination-{{section.id}} .swiper-pagination-bullet:not(.swiper-pagination-bullet-active)::before {
        width: 100%;
        background: rgba(216, 216, 216, 0.9);
      }

      #detail-section6-{{section.id}} .swiper-pagination-{{section.id}} .swiper-pagination-bullet-active::before {
        animation: page-dot-progress 5s normal linear;
        -webkit-animation: page-dot-progress 5s normal linear;
      } {% endcomment %}

      #detail-section6-{{section.id}} .swiper-pagination-{{section.id}}  .swiper-pagination-bullet {
        width: 152px;
        height: 50px;
        display: inline-block;
        border-radius: 0;
        background: transparent;
        opacity: 1;
    }
      #detail-section6-{{section.id}} .swiper-pagination-{{section.id}} .swiper-pagination-bullet-active {
        width: 152px;
        height: 50px;
        border-radius: 0;
        background: transparent;
        opacity: 1;
        transform: scale(1.15);
      }

      {% comment %} #detail-section6-{{section.id}} .swiper-pagination-{{section.id}} .swiper-pagination-bullet.page-dot-progress::before {
        animation: page-dot-progress 5s normal linear;
        -webkit-animation: page-dot-progress 5s normal linear;
    }

    @keyframes page-dot-progress {
        0% {
          width: 0%;
        }

        100% {
          width: 100%;
        }
      } {% endcomment %}
    #detail-section6-{{section.id}} .show_desktop {
        display: flex;
      }
      #detail-section6-{{section.id}} .show_mobile {
        display: none;
      }
      #detail-section6-{{section.id}} .custom-heading-4 {
        padding: {{section.settings.content_heading_padding_top}}px 0 {{section.settings.content_heading_padding_bottom}}px 0;
        text-align: {{ section.settings.text_position }};
        margin: 0;
        color: {{section.settings.content_heading_color}};

        width: 100%;

        line-height: 1.2;




      }
      #detail-section6-{{section.id}} .multiple-flex-box-{{section.id}}{
        display: none;
        flex-wrap: wrap;
        justify-content: flex-start; /* 主轴上的对齐方式为从左到右 */
        column-gap: 15px;
        row-gap: 0;
        margin-top:35px;

      }
      {% unless section.settings.show_swiper_pc %}
        #detail-section6-{{section.id}} .detail-section6-mySwiper-{{section.id}} {
          display: none;
        }
        #detail-section6-{{section.id}} .multiple-flex-box-{{section.id}} {
          display: flex;
        }
      {% endunless %}
      {% assign nums = 100 | divided_by: section.settings.display_number_per_line_flex_mobile | round %}
      {% case section.settings.display_number_per_line_flex_mobile %}
        {% when '1' %}
          {% assign column_gap = 15 %}
        {% when '2' %}
          {% assign column_gap = 7.5 %}
        {% when '3' %}
          {% assign column_gap = 10 %}
        {% when '4' %}
          {% assign column_gap = 11.25 %}
        {% else %}
          {% assign column_gap = 15 %}
      {% endcase %}
      #detail-section6-{{section.id}} .multiple-flex-box-{{section.id}} .multiple-flex-item{
        margin-bottom: 10px; /* 间距 */
        flex-basis: calc(100% / {{ section.settings.display_number_per_line_flex_mobile | plus: 0 }} - {{ column_gap }}px); /* 计算每个项目的宽度，减去一半的间隙以确保总间隙为 15px */
         box-sizing: border-box; /* 包含 padding 和 border 在元素的总宽高之内 */
      }
    @media screen and (min-width: 320px) and (max-width: 769px){
      #detail-section6-{{section.id}} .swiper-pagination-wrap{
        display: flex;
        justify-content: center;
        align-items: center;
        padding-top: 30px;
        height: auto;
      }
      #detail-section6-{{section.id}} .swiper-pagination-{{section.id}}  .swiper-pagination-bullet {
        width: 70px;
        height: 22px;

    }
      #detail-section6-{{section.id}} .swiper-pagination-{{section.id}} .swiper-pagination-bullet-active {
        width: 70px;
        height: 22px;

      }
      {% for block in section.blocks %}
      {% if block.type == 'multipleImageTextSlider' %}
        {% liquid
          assign pagination_desktop_image = block.settings.image_pc
          assign pagination_mobile_image = block.settings.image_mobile

          if pagination_desktop_image == blank
            assign pagination_desktop_image = pagination_mobile_image
          endif

          if pagination_mobile_image == blank
            assign pagination_mobile_image = pagination_desktop_image
          endif
        %}
        {% if pagination_mobile_image != blank %}
          #detail-section6-{{section.id}} .swiper-pagination-{{section.id}} .swiper-pagination-bullet:nth-child({{ forloop.index }})::before {
            background: url('{{ pagination_mobile_image | image_url: width: 140 }}') no-repeat center center / contain;
          }
        {% endif %}
      {% endif %}
    {% endfor %}
      #detail-section6-{{section.id}} .multiple-swiper-wrap {
        {% if section.settings.show_full_width %}
          max-width:100%;
          padding: {{section.settings.padding_top_mobile}}px 24px {{section.settings.padding_bottom_mobile}}px 24px;
        {% else %}
        margin:auto;
        padding: {{section.settings.padding_top_mobile}}px 24px {{section.settings.padding_bottom_mobile}}px 24px ;
        {% endif %}
    }
    #detail-section6-{{section.id}} .multiple-swiper-wrap .swiper-slide-content {

        padding: {{section.settings.card_padding_top_bottom_mobile}}px {{section.settings.card_padding_left_right_mobile}}px;
        border-radius: {{section.settings.card_radius_size_mobile}}px;
    }
    #detail-section6-{{section.id}}  .icon-image-container{
      padding: 6px;

    }
      #detail-section6-{{section.id}} .multiple-swiper-wrap .heading {
        font-size: 27px;
        margin: 15px 0 0 0 ;
        line-height: 34px;
    }


    #detail-section6-{{section.id}} .detail .custom-heading-4 {
      padding: {{section.settings.content_heading_padding_top_mobile}}px 0 {{section.settings.content_heading_padding_bottom_mobile}}px 0;
      font-size: {{section.settings.content_heading_size_mobile}}px;
      line-height: 1.2;

  }

  #detail-section6-{{section.id}} .caption {
    transform: translateY(0) !important;
  }
  #detail-section6-{{section.id}} .multiple-swiper-wrap .swiper-slide-content .content, #detail-section6-{{section.id}} .multiple-flex-box-{{section.id}} .multiple-flex-item .content{

    font-size: {{section.settings.desc_text_font_size_mobile}}px;
    line-height: 1.2;
  }
  #detail-section6-{{section.id}} .multiple-flex-box-{{section.id}} .multiple-flex-item .custom-heading-4{
    padding-bottom:{{section.settings.content_heading_padding_bottom_mobile}}px;
    padding-top:{{section.settings.content_heading_padding_top_mobile}}px;
  }
  #detail-section6-{{section.id}} .multiple-flex-box-{{section.id}} .multiple-flex-item .content{
    padding-top:0;
  }

        #detail-section6-{{section.id}} .show_desktop {
            display: none;
          }
          #detail-section6-{{section.id}} .show_mobile {
            display: block;
          }
      {% if section.settings.show_swiper_mobile %}
        #detail-section6-{{section.id}} .detail-section6-mySwiper-{{section.id}} {
          display: block;
        }
        #detail-section6-{{section.id}} .multiple-flex-box-{{section.id}} {
          display: none;
        }
      {% else %}
        #detail-section6-{{section.id}} .detail-section6-mySwiper-{{section.id}} {
          display: none;
        }
        #detail-section6-{{section.id}} .multiple-flex-box-{{section.id}} {
          display: flex;
        }
      {% endif %}
    }
</style>

<!-- 多个轮播 图文 -->
<div id="detail-section6-{{section.id}}">
  <div class="multiple-swiper-wrap">
    {% if section.settings.title != empty %}
      <h3
        class="heading wow fadeInUp {{ section.settings.title_size }} {{ section.settings.title_font_family }}"
        data-wow-delay=".8s"
      >
        {{ section.settings.title }}
      </h3>
    {% endif %}

    <!-- 多个轮播模式 -->
    <div class="detail-section6-mySwiper-{{section.id}}">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {% case block.type %}
            {%- when 'multipleImageTextSlider' -%}
              {% style %}
                #detail-section6-{{section.id}} .multiple-swiper-wrap .swiper-slide .img-wrap-{{block.id}}{

                    {% if section.settings.show_icon_model %}
                      width: auto;
                      max-width: {{block.settings.icon_width_size}}px;
                      height: auto;
                      max-height: {{ section.settings.icon_height_size }}px;
                      object-fit: contain;
                      display: block;

                    {% else %}

                    {% endif %}
                }
                @media screen and (min-width: 320px) and (max-width: 769px){
                  #detail-section6-{{section.id}}  .icon-image-wrap{
                    min-height:{{  section.settings.icon_height_size_mobile  }}px;
                  }
                  #detail-section6-{{section.id}} .multiple-swiper-wrap .swiper-slide .img-wrap-{{block.id}}{

                    {% if section.settings.show_icon_model %}
                      width: auto;
                      max-width: {{ block.settings.icon_width_size_mobile }}px;
                      height: auto;
                      max-height: {{ section.settings.icon_height_size_mobile }}px;
                      object-fit: contain;
                      display: block;

                    {% else %}

                    {% endif %}
                    }
                }
              {% endstyle %}
              <div class="swiper-slide">
                <div class="swiper-slide-content">
                  <!-- Required swiper-lazy class and image source specified in data-src attribute -->
                  {%- if block.settings.button_link -%}
                    <a
                      class="image-container"
                      href="{{block.settings.button_link}}"
                    >
                  {% endif %}
                  {%- if section.settings.show_icon_model -%}
                    <span
                      class="icon-image-wrap"
                    >
                      <span
                        class="icon-image-container"
                      >
                  {% endif %}
                  {% liquid
                    assign desktop_image = block.settings.image_pc
                    assign mobile_image = block.settings.image_mobile
                    if desktop_image == blank
                      assign desktop_image = mobile_image
                    endif
                    if mobile_image == blank
                      assign mobile_image = desktop_image
                    endif
                    assign image_alt = block.settings.heading_mobile | default: block.settings.heading | strip_html | escape
                  %}
                  {%- if desktop_image -%}
                    {% assign image = desktop_image %}
                    {% assign size = 100 | divided_by: section.settings.display_number_per_line | round %}
                    <span class="show_desktop">
                      <img
                        style="aspect-ratio: {{ desktop_image.aspect_ratio }};"
                        data-sizes="{{ size }}vw"
                        width="{{ image.width }}"
                        height="{{ image.height }}"
                        data-srcset="
                          {%- if image.width >= 200 -%}{{ image | image_url: width: 200 }} 200w,{%- endif -%}
                          {%- if image.width >= 375 -%}{{ image | image_url: width: 375 }} 375w,{%- endif -%}
                          {%- if image.width >= 550 -%}{{ image | image_url: width: 550 }} 550w,{%- endif -%}
                          {%- if image.width >= 750 -%}{{ image | image_url: width: 750 }} 750w,{%- endif -%}
                          {%- if image.width >= 1100 -%}{{ image | image_url: width: 1100 }} 1100w,{%- endif -%}
                          {%- if image.width >= 1500 -%}{{ image | image_url: width: 1500 }} 1500w,{%- endif -%}
                          {%- if image.width >= 1780 -%}{{ image | image_url: width: 1780 }} 1780w,{%- endif -%}
                          {%- if image.width >= 2000 -%}{{ image | image_url: width: 2000 }} 2000w,{%- endif -%}
                          {%- if image.width >= 3000 -%}{{ image | image_url: width: 3000 }} 3000w,{%- endif -%}
                          {%- if image.width >= 3840 -%}{{ image | image_url: width: 3840 }} 3840w,{%- endif -%}
                          {{ image | image_url }} {{ image.width }}w
                        "

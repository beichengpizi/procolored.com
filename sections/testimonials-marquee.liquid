{% liquid
  assign heading_pc = section.settings.heading_html
  assign heading_mobile = section.settings.heading_html_mobile
  if heading_mobile == blank
    assign heading_mobile = heading_pc
  endif

  assign subtitle_pc = section.settings.subtitle_html
  assign subtitle_mobile = section.settings.subtitle_html_mobile
  if subtitle_mobile == blank
    assign subtitle_mobile = subtitle_pc
  endif

  assign footer_pc = section.settings.footer_text_html
  assign footer_mobile = section.settings.footer_text_html_mobile
  if footer_mobile == blank
    assign footer_mobile = footer_pc
  endif
%}

<section class="testimonials-section-{{ section.id }}" data-testimonials-section="{{ section.id }}">
  <style>
    .testimonials-section-{{ section.id }} {
      --tm-section-bg: {{ section.settings.section_bg }};
      --tm-card-bg: {{ section.settings.card_bg }};
      --tm-heading-color: {{ section.settings.heading_color }};
      --tm-subtitle-color: {{ section.settings.subtitle_color }};
      --tm-name-color: {{ section.settings.name_color }};
      --tm-role-color: {{ section.settings.role_color }};
      --tm-review-color: {{ section.settings.review_color }};
      --tm-link-color: {{ section.settings.link_color }};
      --tm-link-hover-color: {{ section.settings.link_hover_color }};
      --tm-quote-color: {{ section.settings.quote_color }};
      --tm-star-color: {{ section.settings.star_color }};
      --tm-avatar-bg: {{ section.settings.avatar_bg }};
      --tm-avatar-color: {{ section.settings.avatar_color }};
      --tm-marquee-distance: 50%;
      --tm-marquee-duration: {{ section.settings.carousel_duration_pc }}s;

      background: var(--tm-section-bg);
      overflow: hidden;
      padding-top: clamp(calc({{ section.settings.section_padding_top_pc }}px * 0.667), calc(100vw * {{ section.settings.section_padding_top_pc }} / 1920), calc({{ section.settings.section_padding_top_pc }}px * 2));
      padding-bottom: clamp(calc({{ section.settings.section_padding_bottom_pc }}px * 0.667), calc(100vw * {{ section.settings.section_padding_bottom_pc }} / 1920), calc({{ section.settings.section_padding_bottom_pc }}px * 2));
    }

    .testimonials-section-{{ section.id }} * {
      box-sizing: border-box;
    }

    .testimonials-section-{{ section.id }} .tm-header {
      max-width: clamp(calc({{ section.settings.header_max_width_pc }}px * 0.667), calc(100vw * {{ section.settings.header_max_width_pc }} / 1920), calc({{ section.settings.header_max_width_pc }}px * 2));
      margin: 0 auto clamp(calc({{ section.settings.header_margin_bottom_pc }}px * 0.667), calc(100vw * {{ section.settings.header_margin_bottom_pc }} / 1920), calc({{ section.settings.header_margin_bottom_pc }}px * 2));
      padding-left: clamp(calc({{ section.settings.header_padding_x_pc }}px * 0.667), calc(100vw * {{ section.settings.header_padding_x_pc }} / 1920), calc({{ section.settings.header_padding_x_pc }}px * 2));
      padding-right: clamp(calc({{ section.settings.header_padding_x_pc }}px * 0.667), calc(100vw * {{ section.settings.header_padding_x_pc }} / 1920), calc({{ section.settings.header_padding_x_pc }}px * 2));
      text-align: center;
    }

    .testimonials-section-{{ section.id }} .tm-heading {
      color: var(--tm-heading-color);
      font-size: clamp(calc({{ section.settings.heading_size_pc }}px * 0.667), calc(100vw * {{ section.settings.heading_size_pc }} / 1920), calc({{ section.settings.heading_size_pc }}px * 2));
      font-weight: {{ section.settings.heading_weight }};
      line-height: {{ section.settings.heading_line_height }};
      margin: 0 0 clamp(calc({{ section.settings.heading_margin_bottom_pc }}px * 0.667), calc(100vw * {{ section.settings.heading_margin_bottom_pc }} / 1920), calc({{ section.settings.heading_margin_bottom_pc }}px * 2));
    }

    .testimonials-section-{{ section.id }} .tm-subtitle {
      color: var(--tm-subtitle-color);
      font-size: clamp(calc({{ section.settings.subtitle_size_pc }}px * 0.667), calc(100vw * {{ section.settings.subtitle_size_pc }} / 1920), calc({{ section.settings.subtitle_size_pc }}px * 2));
      font-weight: {{ section.settings.subtitle_weight }};
      line-height: {{ section.settings.subtitle_line_height }};
      margin: 0;
    }

    .testimonials-section-{{ section.id }} .tm-carousel {
      width: 100%;
      overflow: hidden;
      position: relative;
    }

    .testimonials-section-{{ section.id }} .tm-track {
      display: flex;
      width: max-content;
      transform: translate3d(0, 0, 0);
      will-change: transform;
      backface-visibility: hidden;
      {% if section.settings.enable_autoplay %}
        animation: tm-marquee-{{ section.id }} var(--tm-marquee-duration) linear infinite;
      {% else %}
        animation: none;
      {% endif %}
    }

    {% if section.settings.pause_on_hover %}
      .testimonials-section-{{ section.id }} .tm-carousel:hover .tm-track {
        animation-play-state: paused;
      }
    {% endif %}

    .testimonials-section-{{ section.id }} .tm-group {
      display: flex;
      flex-shrink: 0;
      gap: clamp(calc({{ section.settings.card_gap_pc }}px * 0.667), calc(100vw * {{ section.settings.card_gap_pc }} / 1920), calc({{ section.settings.card_gap_pc }}px * 2));
      padding-right: clamp(calc({{ section.settings.card_gap_pc }}px * 0.667), calc(100vw * {{ section.settings.card_gap_pc }} / 1920), calc({{ section.settings.card_gap_pc }}px * 2));
    }

    .testimonials-section-{{ section.id }} .tm-card {
      flex: 0 0 auto;
      width: clamp(calc({{ section.settings.card_width_pc }}px * 0.667), calc(100vw * {{ section.settings.card_width_pc }} / 1920), calc({{ section.settings.card_width_pc }}px * 2));
      padding: clamp(calc({{ section.settings.card_padding_y_pc }}px * 0.667), calc(100vw * {{ section.settings.card_padding_y_pc }} / 1920), calc({{ section.settings.card_padding_y_pc }}px * 2)) clamp(calc({{ section.settings.card_padding_x_pc }}px * 0.667), calc(100vw * {{ section.settings.card_padding_x_pc }} / 1920), calc({{ section.settings.card_padding_x_pc }}px * 2));
      border-radius: clamp(calc({{ section.settings.card_radius_pc }}px * 0.667), calc(100vw * {{ section.settings.card_radius_pc }} / 1920), calc({{ section.settings.card_radius_pc }}px * 2));
      background: var(--tm-card-bg);
      position: relative;
    }

    .testimonials-section-{{ section.id }} .tm-card-header {
      display: flex;
      align-items: center;
      position: relative;
      margin-bottom: clamp(calc({{ section.settings.card_header_margin_pc }}px * 0.667), calc(100vw * {{ section.settings.card_header_margin_pc }} / 1920), calc({{ section.settings.card_header_margin_pc }}px * 2));
      padding-right: clamp(calc({{ section.settings.quote_size_pc }}px * 0.667), calc(100vw * {{ section.settings.quote_size_pc }} / 1920), calc({{ section.settings.quote_size_pc }}px * 2));
    }

    .testimonials-section-{{ section.id }} .tm-avatar-wrap {
      width: clamp(calc({{ section.settings.avatar_size_pc }}px * 0.667), calc(100vw * {{ section.settings.avatar_size_pc }} / 1920), calc({{ section.settings.avatar_size_pc }}px * 2));
      height: clamp(calc({{ section.settings.avatar_size_pc }}px * 0.667), calc(100vw * {{ section.settings.avatar_size_pc }} / 1920), calc({{ section.settings.avatar_size_pc }}px * 2));
      margin-right: clamp(calc({{ section.settings.avatar_gap_pc }}px * 0.667), calc(100vw * {{ section.settings.avatar_gap_pc }} / 1920), calc({{ section.settings.avatar_gap_pc }}px * 2));
      border-radius: 50%;
      overflow: hidden;
      flex: 0 0 auto;
      background: var(--tm-avatar-bg);
    }

    .testimonials-section-{{ section.id }} .tm-avatar {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
    }

    .testimonials-section-{{ section.id }} .tm-avatar-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      color: var(--tm-avatar-color);
      background: var(--tm-avatar-bg);
      font-size: clamp(calc({{ section.settings.avatar_text_size_pc }}px * 0.667), calc(100vw * {{ section.settings.avatar_text_size_pc }} / 1920), calc({{ section.settings.avatar_text_size_pc }}px * 2));
      font-weight: 800;
      line-height: 1;
      text-transform: uppercase;
    }

    .testimonials-section-{{ section.id }} .tm-user-info {
      min-width: 0;
    }

    .testimonials-section-{{ section.id }} .tm-name {
      color: var(--tm-name-color);
      font-size: clamp(calc({{ section.settings.name_size_pc }}px * 0.667), calc(100vw * {{ section.settings.name_size_pc }} / 1920), calc({{ section.settings.name_size_pc }}px * 2));
      font-weight: {{ section.settings.name_weight }};
      line-height: {{ section.settings.name_line_height }};
      word-break: break-word;
    }

    .testimonials-section-{{ section.id }} .tm-role {
      color: var(--tm-role-color);
      font-size: clamp(calc({{ section.settings.role_size_pc }}px * 0.667), calc(100vw * {{ section.settings.role_size_pc }} / 1920), calc({{ section.settings.role_size_pc }}px * 2));
      font-weight: {{ section.settings.role_weight }};
      line-height: {{ section.settings.role_line_height }};
      word-break: break-word;
    }

    .testimonials-section-{{ section.id }} .tm-quote {
      position: absolute;
      top: clamp(calc({{ section.settings.quote_top_pc }}px * 0.667), calc(100vw * {{ section.settings.quote_top_pc }} / 1920), calc({{ section.settings.quote_top_pc }}px * 2));
      right: 0;
      width: clamp(calc({{ section.settings.quote_size_pc }}px * 0.667), calc(100vw * {{ section.settings.quote_size_pc }} / 1920), calc({{ section.settings.quote_size_pc }}px * 2));
      height: clamp(calc({{ section.settings.quote_size_pc }}px * 0.667), calc(100vw * {{ section.settings.quote_size_pc }} / 1920), calc({{ section.settings.quote_size_pc }}px * 2));
      color: var(--tm-quote-color);
      pointer-events: none;
    }

    .testimonials-section-{{ section.id }} .tm-quote svg,
    .testimonials-section-{{ section.id }} .tm-star-fallback svg {
      display: block;
      width: 100%;
      height: 100%;
    }

    .testimonials-section-{{ section.id }} .tm-stars {
      display: block;
      width: auto;
      height: clamp(calc({{ section.settings.stars_height_pc }}px * 0.667), calc(100vw * {{ section.settings.stars_height_pc }} / 1920), calc({{ section.settings.stars_height_pc }}px * 2));
      margin-bottom: clamp(calc({{ section.settings.stars_margin_bottom_pc }}px * 0.667), calc(100vw * {{ section.settings.stars_margin_bottom_pc }} / 1920), calc({{ section.settings.stars_margin_bottom_pc }}px * 2));
    }

    .testimonials-section-{{ section.id }} .tm-star-fallback {
      display: flex;
      align-items: center;
      gap: clamp(calc(4px * 0.667), calc(100vw * 4 / 1920), calc(4px * 2));
      color: var(--tm-star-color);
      margin-bottom: clamp(calc({{ section.settings.stars_margin_bottom_pc }}px * 0.667), calc(100vw * {{ section.settings.stars_margin_bottom_pc }} / 1920), calc({{ section.settings.stars_margin_bottom_pc }}px * 2));
    }

    .testimonials-section-{{ section.id }} .tm-star-fallback svg {
      width: clamp(calc({{ section.settings.stars_height_pc }}px * 0.667), calc(100vw * {{ section.settings.stars_height_pc }} / 1920), calc({{ section.settings.stars_height_pc }}px * 2));
      height: clamp(calc({{ section.settings.stars_height_pc }}px * 0.667), calc(100vw * {{ section.settings.stars_height_pc }} / 1920), calc({{ section.settings.stars_height_pc }}px * 2));
      flex: 0 0 auto;
    }

    .testimonials-section-{{ section.id }} .tm-review {
      color: var(--tm-review-color);
      font-size: clamp(calc({{ section.settings.review_size_pc }}px * 0.667), calc(100vw * {{ section.settings.review_size_pc }} / 1920), calc({{ section.settings.review_size_pc }}px * 2));
      font-weight: {{ section.settings.review_weight }};
      line-height: {{ section.settings.review_line_height }};
      word-break: break-word;
    }

    .testimonials-section-{{ section.id }} .tm-footer {
      text-align: center;
      margin-top: clamp(calc({{ section.settings.footer_margin_top_pc }}px * 0.667), calc(100vw * {{ section.settings.footer_margin_top_pc }} / 1920), calc({{ section.settings.footer_margin_top_pc }}px * 2));
      padding-left: clamp(calc({{ section.settings.header_padding_x_pc }}px * 0.667), calc(100vw * {{ section.settings.header_padding_x_pc }} / 1920), calc({{ section.settings.header_padding_x_pc }}px * 2));
      padding-right: clamp(calc({{ section.settings.header_padding_x_pc }}px * 0.667), calc(100vw * {{ section.settings.header_padding_x_pc }} / 1920), calc({{ section.settings.header_padding_x_pc }}px * 2));
    }

    .testimonials-section-{{ section.id }} .tm-link {
      display: inline-block;
      color: var(--tm-link-color);
      font-size: clamp(calc({{ section.settings.footer_size_pc }}px * 0.667), calc(100vw * {{ section.settings.footer_size_pc }} / 1920), calc({{ section.settings.footer_size_pc }}px * 2));
      font-weight: {{ section.settings.footer_weight }};
      line-height: {{ section.settings.footer_line_height }};
      text-decoration: none;
      cursor: pointer;
      transition: color 0.2s ease;
    }

    .testimonials-section-{{ section.id }} .tm-link:hover {
      color: var(--tm-link-hover-color);
    }

    .testimonials-section-{{ section.id }} .tm-mobile {
      display: none;
    }

    @keyframes tm-marquee-{{ section.id }} {
      0% { transform: translate3d(0, 0, 0); }
      100% { transform: translate3d(calc(-1 * var(--tm-marquee-distance)), 0, 0); }
    }

    @media (prefers-reduced-motion: reduce) {
      .testimonials-section-{{ section.id }} .tm-track {
        animation: none;
        transform: none;
      }
    }

    @media (max-width: 768px) {
      .testimonials-section-{{ section.id }} {
        --tm-marquee-duration: {{ section.settings.carousel_duration_mobile }}s;
        padding-top: clamp(calc({{ section.settings.section_padding_top_mobile }}px * 0.85), calc(100vw * {{ section.settings.section_padding_top_mobile }} / 375), calc({{ section.settings.section_padding_top_mobile }}px * 1.15));
        padding-bottom: clamp(calc({{ section.settings.section_padding_bottom_mobile }}px * 0.85), calc(100vw * {{ section.settings.section_padding_bottom_mobile }} / 375), calc({{ section.settings.section_padding_bottom_mobile }}px * 1.15));
      }

      .testimonials-section-{{ section.id }} .tm-header {
        max-width: 100%;
        margin-bottom: clamp(calc({{ section.settings.header_margin_bottom_mobile }}px * 0.85), calc(100vw * {{ section.settings.header_margin_bottom_mobile }} / 375), calc({{ section.settings.header_margin_bottom_mobile }}px * 1.15));
        padding-left: clamp(calc({{ section.settings.header_padding_x_mobile }}px * 0.85), calc(100vw * {{ section.settings.header_padding_x_mobile }} / 375), calc({{ section.settings.header_padding_x_mobile }}px * 1.15));
        padding-right: clamp(calc({{ section.settings.header_padding_x_mobile }}px * 0.85), calc(100vw * {{ section.settings.header_padding_x_mobile }} / 375), calc({{ section.settings.header_padding_x_mobile }}px * 1.15));
      }

      .testimonials-section-{{ section.id }} .tm-heading {
        font-size: clamp(calc({{ section.settings.heading_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.heading_size_mobile }} / 375), calc({{ section.settings.heading_size_mobile }}px * 1.15));
        margin-bottom: clamp(calc({{ section.settings.heading_margin_bottom_mobile }}px * 0.85), calc(100vw * {{ section.settings.heading_margin_bottom_mobile }} / 375), calc({{ section.settings.heading_margin_bottom_mobile }}px * 1.15));
      }

      .testimonials-section-{{ section.id }} .tm-subtitle {
        font-size: clamp(calc({{ section.settings.subtitle_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.subtitle_size_mobile }} / 375), calc({{ section.settings.subtitle_size_mobile }}px * 1.15));
      }

      .testimonials-section-{{ section.id }} .tm-group {
        gap: clamp(calc({{ section.settings.card_gap_mobile }}px * 0.85), calc(100vw * {{ section.settings.card_gap_mobile }} / 375), calc({{ section.settings.card_gap_mobile }}px * 1.15));
        padding-right: clamp(calc({{ section.settings.card_gap_mobile }}px * 0.85), calc(100vw * {{ section.settings.card_gap_mobile }} / 375), calc({{ section.settings.card_gap_mobile }}px * 1.15));
      }

      .testimonials-section-{{ section.id }} .tm-card {
        width: clamp(calc({{ section.settings.card_width_mobile }}px * 0.85), calc(100vw * {{ section.settings.card_width_mobile }} / 375), calc({{ section.settings.card_width_mobile }}px * 1.15));
        padding: clamp(calc({{ section.settings.card_padding_y_mobile }}px * 0.85), calc(100vw * {{ section.settings.card_padding_y_mobile }} / 375), calc({{ section.settings.card_padding_y_mobile }}px * 1.15)) clamp(calc({{ section.settings.card_padding_x_mobile }}px * 0.85), calc(100vw * {{ section.settings.card_padding_x_mobile }} / 375), calc({{ section.settings.card_padding_x_mobile }}px * 1.15));
        border-radius: clamp(calc({{ section.settings.card_radius_mobile }}px * 0.85), calc(100vw * {{ section.settings.card_radius_mobile }} / 375), calc({{ section.settings.card_radius_mobile }}px * 1.15));
      }

      .testimonials-section-{{ section.id }} .tm-card-header {
        margin-bottom: clamp(calc({{ section.settings.card_header_margin_mobile }}px * 0.85), calc(100vw * {{ section.settings.card_header_margin_mobile }} / 375), calc({{ section.settings.card_header_margin_mobile }}px * 1.15));
        padding-right: clamp(calc({{ section.settings.quote_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.quote_size_mobile }} / 375), calc({{ section.settings.quote_size_mobile }}px * 1.15));
      }

      .testimonials-section-{{ section.id }} .tm-avatar-wrap {
        width: clamp(calc({{ section.settings.avatar_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.avatar_size_mobile }} / 375), calc({{ section.settings.avatar_size_mobile }}px * 1.15));
        height: clamp(calc({{ section.settings.avatar_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.avatar_size_mobile }} / 375), calc({{ section.settings.avatar_size_mobile }}px * 1.15));
        margin-right: clamp(calc({{ section.settings.avatar_gap_mobile }}px * 0.85), calc(100vw * {{ section.settings.avatar_gap_mobile }} / 375), calc({{ section.settings.avatar_gap_mobile }}px * 1.15));
      }

      .testimonials-section-{{ section.id }} .tm-avatar-placeholder {
        font-size: clamp(calc({{ section.settings.avatar_text_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.avatar_text_size_mobile }} / 375), calc({{ section.settings.avatar_text_size_mobile }}px * 1.15));
      }

      .testimonials-section-{{ section.id }} .tm-name {
        font-size: clamp(calc({{ section.settings.name_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.name_size_mobile }} / 375), calc({{ section.settings.name_size_mobile }}px * 1.15));
      }

      .testimonials-section-{{ section.id }} .tm-role {
        font-size: clamp(calc({{ section.settings.role_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.role_size_mobile }} / 375), calc({{ section.settings.role_size_mobile }}px * 1.15));
      }

      .testimonials-section-{{ section.id }} .tm-quote {
        top: clamp(calc({{ section.settings.quote_top_mobile }}px * 0.85), calc(100vw * {{ section.settings.quote_top_mobile }} / 375), calc({{ section.settings.quote_top_mobile }}px * 1.15));
        width: clamp(calc({{ section.settings.quote_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.quote_size_mobile }} / 375), calc({{ section.settings.quote_size_mobile }}px * 1.15));
        height: clamp(calc({{ section.settings.quote_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.quote_size_mobile }} / 375), calc({{ section.settings.quote_size_mobile }}px * 1.15));
      }

      .testimonials-section-{{ section.id }} .tm-stars,
      .testimonials-section-{{ section.id }} .tm-star-fallback {
        margin-bottom: clamp(calc({{ section.settings.stars_margin_bottom_mobile }}px * 0.85), calc(100vw * {{ section.settings.stars_margin_bottom_mobile }} / 375), calc({{ section.settings.stars_margin_bottom_mobile }}px * 1.15));
      }

      .testimonials-section-{{ section.id }} .tm-stars,
      .testimonials-section-{{ section.id }} .tm-star-fallback svg {
        height: clamp(calc({{ section.settings.stars_height_mobile }}px * 0.85), calc(100vw * {{ section.settings.stars_height_mobile }} / 375), calc({{ section.settings.stars_height_mobile }}px * 1.15));
      }

      .testimonials-section-{{ section.id }} .tm-star-fallback svg {
        width: clamp(calc({{ section.settings.stars_height_mobile }}px * 0.85), calc(100vw * {{ section.settings.stars_height_mobile }} / 375), calc({{ section.settings.stars_height_mobile }}px * 1.15));
      }

      .testimonials-section-{{ section.id }} .tm-review {
        font-size: clamp(calc({{ section.settings.review_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.review_size_mobile }} / 375), calc({{ section.settings.review_size_mobile }}px * 1.15));
      }

      .testimonials-section-{{ section.id }} .tm-footer {
        margin-top: clamp(calc({{ section.settings.footer_margin_top_mobile }}px * 0.85), calc(100vw * {{ section.settings.footer_margin_top_mobile }} / 375), calc({{ section.settings.footer_margin_top_mobile }}px * 1.15));
        padding-left: clamp(calc({{ section.settings.header_padding_x_mobile }}px * 0.85), calc(100vw * {{ section.settings.header_padding_x_mobile }} / 375), calc({{ section.settings.header_padding_x_mobile }}px * 1.15));
        padding-right: clamp(calc({{ section.settings.header_padding_x_mobile }}px * 0.85), calc(100vw * {{ section.settings.header_padding_x_mobile }} / 375), calc({{ section.settings.header_padding_x_mobile }}px * 1.15));
      }

      .testimonials-section-{{ section.id }} .tm-link {
        font-size: clamp(calc({{ section.settings.footer_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.footer_size_mobile }} / 375), calc({{ section.settings.footer_size_mobile }}px * 1.15));
      }

      .testimonials-section-{{ section.id }} .tm-pc {
        display: none;
      }

      .testimonials-section-{{ section.id }} .tm-mobile {
        display: block;
      }
    }
  </style>

  {% if heading_pc != blank or subtitle_pc != blank %}
    <div class="tm-header">
      {% if heading_pc != blank %}
        <div class="tm-heading tm-pc">{{ heading_pc }}</div>
        <div class="tm-heading tm-mobile">{{ heading_mobile }}</div>
      {% endif %}

      {% if subtitle_pc != blank %}
        <div class="tm-subtitle tm-pc">{{ subtitle_pc }}</div>
        <div class="tm-subtitle tm-mobile">{{ subtitle_mobile }}</div>
      {% endif %}
    </div>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <div class="tm-carousel" aria-label="{{ section.settings.carousel_aria_label | escape }}">
      <div class="tm-track" data-testimonials-track>
        {% for repeat_index in (1..2) %}
          <div class="tm-group" data-testimonials-group {% if repeat_index == 2 %}aria-hidden="true"{% endif %}>
            {% for block in section.blocks %}
              {% liquid
                assign avatar_pc = block.settings.avatar_image_pc
                assign avatar_mobile = block.settings.avatar_image_mobile
                if avatar_pc == blank and avatar_mobile != blank
                  assign avatar_pc = avatar_mobile
                endif
                if avatar_mobile == blank
                  assign avatar_mobile = avatar_pc
                endif

                assign stars_pc = block.settings.stars_image_pc
                assign stars_mobile = block.settings.stars_image_mobile
                if stars_pc == blank and stars_mobile != blank
                  assign stars_pc = stars_mobile
                endif
                if stars_mobile == blank
                  assign stars_mobile = stars_pc
                endif

                assign name_pc = block.settings.user_name_html
                assign name_mobile = block.settings.user_name_html_mobile
                if name_mobile == blank
                  assign name_mobile = name_pc
                endif

                assign role_pc = block.settings.user_role_html
                assign role_mobile = block.settings.user_role_html_mobile
                if role_mobile == blank
                  assign role_mobile = role_pc
                endif

                assign review_pc = block.settings.review_html
                assign review_mobile = block.settings.review_html_mobile
                if review_mobile == blank
                  assign review_mobile = review_pc
                endif

                assign avatar_text = block.settings.avatar_fallback_text
                if avatar_text == blank
                  assign avatar_text = name_pc | strip_html | remove: '@' | slice: 0, 1
                endif
                if avatar_text == blank
                  assign avatar_text = 'U'
                endif

                assign avatar_alt = block.settings.avatar_alt
                if avatar_alt == blank
                  assign avatar_alt = name_pc | strip_html
                endif

                assign stars_alt = block.settings.stars_alt
                if stars_alt == blank
                  assign stars_alt = '5 Stars'
                endif
              %}

              <div class="tm-card" {% if repeat_index == 1 %}{{ block.shopify_attributes }}{% endif %}>
                <div class="tm-card-header">
                  <div class="tm-avatar-wrap">
                    {% if avatar_pc != blank %}
                      <picture>
                        {% if avatar_mobile != blank %}
                          <source
                            media="(max-width: 768px)"
                            data-srcset="{{ avatar_mobile | image_url: width: 80 }} 80w, {{ avatar_mobile | image_url: width: 120 }} 120w, {{ avatar_mobile | image_url: width: 160 }} 160w"
                            sizes="54px"
                          >
                        {% endif %}
                        <img
                          class="tm-avatar lazyload"
                          src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
                          data-src="{{ avatar_pc | image_url: width: 160 }}"
                          data-srcset="{{ avatar_pc | image_url: width: 80 }} 80w, {{ avatar_pc | image_url: width: 120 }} 120w, {{ avatar_pc | image_url: width: 160 }} 160w, {{ avatar_pc | image_url: width: 240 }} 240w"
                          sizes="(max-width: 768px) 54px, 62px"
                          width="{{ avatar_pc.width }}"
                          height="{{ avatar_pc.height }}"
                          alt="{{ avatar_alt | escape }}"
                        >
                      </picture>
                    {% else %}
                      <div class="tm-avatar-placeholder" aria-hidden="true">
                        {{ avatar_text | strip_html | slice: 0, 2 }}
                      </div>
                    {% endif %}
                  </div>

                  <div class="tm-user-info">
                    {% if name_pc != blank %}
                      <div class="tm-name tm-pc">{{ name_pc }}</div>
                      <div class="tm-name tm-mobile">{{ name_mobile }}</div>
                    {% endif %}

                    {% if role_pc != blank %}
                      <div class="tm-role tm-pc">{{ role_pc }}</div>
                      <div class="tm-role tm-mobile">{{ role_mobile }}</div>
                    {% endif %}
                  </div>

                  {% if section.settings.show_quote_icon %}
                    <div class="tm-quote" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" fill="none">
                        <path d="M12.0645 18.6018H5.32652V5.73438H18.2403V17.2026C18.6147 24.8476 14.9652 30.5359 7.29158 34.2651L4.20312 30.0687C9.44328 27.2727 12.0645 23.4496 12.0645 18.6018ZM24.1366 34.2651L21.0482 30.0687C26.1005 27.2727 28.7218 23.4496 28.9084 18.6018H22.1704V5.73438H35.0853V17.2026C35.4598 24.8476 31.8102 30.5359 24.1366 34.2651Z" fill="currentColor" />
                      </svg>
                    </div>
                  {% endif %}
                </div>

                {% if stars_pc != blank %}
                  <picture>
                    {% if stars_mobile != blank %}
                      <source
                        media="(max-width: 768px)"
                        data-srcset="{{ stars_mobile | image_url: width: 100 }} 100w, {{ stars_mobile | image_url: width: 160 }} 160w, {{ stars_mobile | image_url: width: 220 }} 220w"
                        sizes="120px"
                      >
                    {% endif %}
                    <img
                      class="tm-stars lazyload"
                      src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
                      data-src="{{ stars_pc | image_url: width: 220 }}"
                      data-srcset="{{ stars_pc | image_url: width: 100 }} 100w, {{ stars_pc | image_url: width: 160 }} 160w, {{ stars_pc | image_url: width: 220 }} 220w, {{ stars_pc | image_url: width: 320 }} 320w"
                      sizes="(max-width: 768px) 120px, 160px"
                      width="{{ stars_pc.width }}"
                      height="{{ stars_pc.height }}"
                      alt="{{ stars_alt | escape }}"
                    >
                  </picture>
                {% else %}
                  <div class="tm-star-fallback" role="img" aria-label="{{ stars_alt | escape }}">
                    {% for star_index in (1..5) %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2.75l2.86 5.79 6.39.93-4.62 4.5 1.09 6.36L12 17.32l-5.72 3.01 1.09-6.36-4.62-4.5 6.39-.93L12 2.75z"/>
                      </svg>
                    {% endfor %}
                  </div>
                {% endif %}

                {% if review_pc != blank %}
                  <div class="tm-review tm-pc">{{ review_pc }}</div>
                  <div class="tm-review tm-mobile">{{ review_mobile }}</div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if footer_pc != blank %}
    <div class="tm-footer">
      {% if section.settings.footer_link != blank %}
        <a class="tm-link tm-pc" href="{{ section.settings.footer_link }}" {% if section.settings.footer_open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ footer_pc }}</a>
        <a class="tm-link tm-mobile" href="{{ section.settings.footer_link }}" {% if section.settings.footer_open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ footer_mobile }}</a>
      {% else %}
        <span class="tm-link tm-pc">{{ footer_pc }}</span>
        <span class="tm-link tm-mobile">{{ footer_mobile }}</span>
      {% endif %}
    </div>
  {% endif %}

  <script>
    (() => {
      const init = () => {
        const section = document.querySelector('[data-testimonials-section="{{ section.id }}"]');
        if (!section || section.dataset.testimonialsReady === 'true') return;

        section.dataset.testimonialsReady = 'true';

        const track = section.querySelector('[data-testimonials-track]');
        const firstGroup = section.querySelector('[data-testimonials-group]');
        if (!track || !firstGroup) return;

        // 计算第一组真实宽度作为动画位移，避免固定 -50% 导致首尾接缝、跳动或空白。
        const updateDistance = () => {
          const distance = firstGroup.getBoundingClientRect().width;
          if (!distance) return;

          track.style.setProperty('--tm-marquee-distance', `${distance}px`);

          if (track.getAnimations) {
            track.getAnimations().forEach((animation) => {
              animation.cancel();
              animation.play();
            });
          }
        };

        // 若主题未安装 lazysizes，则做兜底加载，避免图片一直停留在透明占位图。
        const lazyloadFallback = () => {
          if (window.lazySizes) return;

          section.querySelectorAll('img.lazyload').forEach((img) => {
            const dataSrc = img.getAttribute('data-src');
            const dataSrcset = img.getAttribute('data-srcset');

            if (dataSrcset && !img.getAttribute('srcset')) {
              img.setAttribute('srcset', dataSrcset);
            }

            if (dataSrc && img.getAttribute('src') !== dataSrc) {
              img.setAttribute('src', dataSrc);
            }

            img.classList.remove('lazyload');
            img.classList.add('lazyloaded');
          });

          section.querySelectorAll('source[data-srcset]').forEach((source) => {
            if (!source.getAttribute('srcset')) {
              source.setAttribute('srcset', source.getAttribute('data-srcset'));
            }
          });
        };

        const scheduleUpdate = () => window.requestAnimationFrame(updateDistance);

        lazyloadFallback();
        scheduleUpdate();

        window.addEventListener('load', scheduleUpdate, { once: true });
        window.addEventListener('resize', scheduleUpdate);

        if ('ResizeObserver' in window) {
          const observer = new ResizeObserver(scheduleUpdate);
          observer.observe(firstGroup);
          observer.observe(section);
        }

        if (window.Shopify && Shopify.designMode) {
          document.addEventListener('shopify:block:select', (event) => {
            if (!section.contains(event.target)) return;
            track.style.animationPlayState = 'paused';
          });

          document.addEventListener('shopify:block:deselect', (event) => {
            if (!section.contains(event.target)) return;
            track.style.animationPlayState = '';
            scheduleUpdate();
          });
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init, { once: true });
      } else {
        init();
      }
    })();
  </script>
</section>


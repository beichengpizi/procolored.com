<style>
  :root {
    /* Font sizes */
    --text-h0-n: 56px;
    --text-h0-sm-n: 48px;
    --text-h1-n: 40px;
    --text-h2-n: 30px;
    --text-h3-n: 26px;
    --text-h4-n: 24px;
    --text-h5-n: 20px;
    --text-h6-n: 16px;
    --text-xs-n: 12px;
    --text-sm-n: 14px;
    --text-base-n: 18px;
    --text-lg-n: 19px;
  }

  .text-xxs {
    font-size: 10px;
    line-height: 1.2;
  }

  .text-xs {
    font-size: var(--text-xs-n);
    line-height: 1.2;
  }

  .text-sm {
    font-size: var(--text-sm-n);
    line-height: 1.2;
  }

  .text-base {
    font-size: var(--text-base-n);
    line-height: 1.2;
  }

  .text-md {
    font-size: var(--text-md-n);
    line-height: 1.2;
  }

  .text-lg {
    font-size: var(--text-lg-n);
    line-height: 1.2;
  }

  /* 重置样式 start */
  .customer-testimonials-{{ section.id }} .h0 {
    font-size: var(--text-h0-n);
    line-height: 1;
    font-family: ItalianPlateNo2Expanded-Bold, sans-serif;
  }

  .customer-testimonials-{{ section.id }} .h0-sm {
    font-size: var(--text-h0-sm-n);
    line-height: 1;
    font-family: ItalianPlateNo2Expanded-Bold, sans-serif;
  }

  .customer-testimonials-{{ section.id }} h1,
  .customer-testimonials-{{ section.id }} .h1,
  .customer-testimonials-{{ section.id }} .prose h1:not(.h0, .h1, .h2, .h3, .h4, .h5, .h6) {
    font-size: var(--text-h1-n);
    line-height: 1.1;
    font-family: ItalianPlateNo2Expanded-Bold, sans-serif;
  }

  .customer-testimonials-{{ section.id }} h2,
  .customer-testimonials-{{ section.id }} .h2,
  .customer-testimonials-{{ section.id }} .prose h2:not(.h0, .h1, .h2, .h3, .h4, .h5, .h6) {
    font-size: var(--text-h2-n);
    line-height: 1.1;
    font-family: ItalianPlateNo2Expanded-Bold, sans-serif;
  }

  .customer-testimonials-{{ section.id }} h3,
  .customer-testimonials-{{ section.id }} .h3,
  .customer-testimonials-{{ section.id }} .prose h3:not(.h0, .h1, .h2, .h3, .h4, .h5, .h6) {
    font-size: var(--text-h3-n);
    line-height: 1.2;
  }

  .customer-testimonials-{{ section.id }} h4,
  .customer-testimonials-{{ section.id }} .h4,
  .customer-testimonials-{{ section.id }} .prose h4:not(.h0, .h1, .h2, .h3, .h4, .h5, .h6) {
    font-size: var(--text-h4-n);
    line-height: 1.2;
  }

  .customer-testimonials-{{ section.id }} h5,
  .customer-testimonials-{{ section.id }} .h5,
  .customer-testimonials-{{ section.id }} .prose h5:not(.h0, .h1, .h2, .h3, .h4, .h5, .h6) {
    font-size: var(--text-h5-n);
    line-height: 1.2;
  }

  .customer-testimonials-{{ section.id }} h6,
  .customer-testimonials-{{ section.id }} .h6,
  .customer-testimonials-{{ section.id }} .prose h6:not(.h0, .h1, .h2, .h3, .h4, .h5, .h6) {
    font-size: var(--text-h6-n);
    line-height: 1.2;
  }
  /* 重置样式 end */
  .customer-testimonials-{{ section.id }} {
    background-color: {{ section.settings.bgColor }};
    overflow: hidden;
  }
  .customer-testimonials-{{ section.id }}  .ct-wrapper {
    padding-top: {{ section.settings.ct_padding_top }}px;
    padding-bottom: {{ section.settings.ct_padding_bottom }}px;
    overflow: hidden;
    margin-left: calc(calc(100vw - 1400px) / 2);
  }
  .customer-testimonials-{{ section.id }} .swiper-ct {
    margin-top: 40px;
  }
  .customer-testimonials-{{ section.id }} .swiper-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-direction: column;
    max-width: 60%;
  }
  .customer-testimonials-{{ section.id }} .swiper-header h3.swiper-title {
    margin: 0;
    font-weight: bold;
    line-height: 1.1;
    color: {{ section.settings.title_color }};
  }
  .customer-testimonials-{{ section.id }} .swiper-description {
    color: #5D5D5D;
    font-size: 24px;
    padding-top: 20px;
  }

  .customer-testimonials-{{ section.id }} .swiper-button-next,
  .customer-testimonials-{{ section.id }} .swiper-button-prev {
    margin: 0;
    left: 0;
    right: 0;
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: 48px;
    background-color: #000;
  }
  .customer-testimonials-{{ section.id }} .swiper-button-next:after,
  .customer-testimonials-{{ section.id }} .swiper-button-prev:after {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 16px;
    color: #fff;
  }
  .customer-testimonials-{{ section.id }} .swiper-button-next svg,
  .customer-testimonials-{{ section.id }} .swiper-button-prev svg {
      fill: #fff;
      width: 16px;
      height: 16px;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);

  }
  .customer-testimonials-{{ section.id }} .swiper-btn {
    display: flex;
  }
  .customer-testimonials-{{ section.id }} .swiper-btn div:first-child {
    margin-right: 15px;
  }
  .customer-testimonials-{{ section.id }} .swiper-slide {
    max-width: {{ section.settings.content_card_max_width }}px;
    min-height: {{ section.settings.content_card_min_height }}px;
    overflow: hidden;
    border-radius: 20px;
    padding: {{ section.settings.content_card_padding }}px;
    background-color: {{ section.settings.content_bgColor }};
  }
  .customer-testimonials-{{ section.id }} .customer-info {
    display: flex;
    align-items: center;
  }
  .customer-testimonials-{{ section.id }} .customer-info .head {
    width: {{ section.settings.customer_img_size }}px;
    height: {{ section.settings.customer_img_size }}px;
    border-radius: 50%;
    overflow: hidden;
  }
  .customer-testimonials-{{ section.id }} .customer-  info .head img{
    object-fit: cover;
  }
  .customer-testimonials-{{ section.id }} .customer-info .name {
    margin: 0 0 0 8px;
    color: {{ section.settings.customer_name_color }};
    line-height: 1.3;
    flex: 1;
    padding-right: 50px;
  }
  .customer-testimonials-{{ section.id }} .customer-info .name p {
    margin: 0;
  }
  .customer-testimonials-{{ section.id }} .slide-box {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .customer-testimonials-{{ section.id }} .slide-box .text-title
   {
    font-weight: bold;
    margin-top: {{ section.settings.testimonials_title_margin_top }}px;
    margin-bottom: {{ section.settings.testimonials_title_margin_bottom }}px;
    line-height: 1.3;
    color: {{ section.settings.testimonials_title_color }};
  }
  .customer-testimonials-{{ section.id }} .slide-box .text-info
  {
    color: {{ section.settings.testimonials_info_color }};
    line-height: 1.3;
  }
  .customer-testimonials-{{ section.id }} .slide-box .text-info p
  {

    margin-bottom: {{ section.settings.testimonials_info_margin_bottom }}px;
    line-height: 1.3;
  }
  .customer-testimonials-{{ section.id }} .slide-box .text-url {
    display: block;
    line-height: 1.3;
    color: {{ section.settings.testimonials_url_color }};
  }

  .customer-testimonials-{{ section.id }} .customer-name {
    color: #000;
    font-size: 24px;
    font-weight: 800;
    line-height: 31.92px; /* 133% */
  }

  .customer-testimonials-{{ section.id }} .star-wrapper {
    padding-top: 16px;
  }

  .customer-testimonials-{{ section.id }} .quote {
    position: absolute;
    right: 20px;
    top: 20px;
  }

  @media screen and (max-width:1400px) {
    .customer-testimonials-{{ section.id }} .ct-wrapper{
      padding-left: 24px;
      padding-right: 0;
      overflow: hidden;
      max-width: 100%;
      margin-left: 0;
    }
  }
  @media screen and (max-width:768px) {
    .customer-testimonials-{{ section.id }}  .ct-wrapper {
      width: 100%;
      margin-left: 0;
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;

    }

    .customer-testimonials-{{ section.id }}  .ct-wrapper .swiper-description {
      font-size: 16px;
      text-align: center;
    }

    .customer-testimonials-{{ section.id }} .customer-name {
      font-size: 18px;
    }

    .customer-testimonials-{{ section.id }} .swiper-button{
      display: none;
    }
    .customer-testimonials-{{ section.id }} .swiper-header h3.swiper-title{
      font-size: {{ section.settings.title_size_mobile }}px;
      line-height: 1.3;
      text-align: center;
      padding: 0 16px;
    }
    .customer-testimonials-{{ section.id }} .swiper-slide{
      max-width: {{ section.settings.content_card_min_width_mobile }}px;
      min-height: {{ section.settings.content_card_min_height_mobile }}px;
      padding: {{ section.settings.content_card_padding_mobile }}px;
      height: auto;
      border-radius: 10px;
    }
    .customer-testimonials-{{ section.id }} .customer-info .name{
      font-size: {{ section.settings.customer_name_size_mobile }}px;
      line-height: 1.2;
      padding-right: 28px;
    }
    .customer-testimonials-{{ section.id }} .slide-box .text-title{
      margin-top: {{ section.settings.testimonials_title_margin_top_mobile }}px;
      margin-bottom: {{ section.settings.testimonials_title_margin_bottom_mobile }}px;
      font-size: {{ section.settings.testimonials_title_size_mobile}}px;
      line-height:  1.2;
    }
    .customer-testimonials-{{ section.id }} .customer-info .head {
      width: {{ section.settings.customer_img_size_mobile }}px;
      height: {{ section.settings.customer_img_size_mobile }}px;
    }
    .customer-testimonials-{{ section.id }} .slide-box .text-info p
    {
      margin-bottom: {{ section.settings.testimonials_info_margin_bottom_mobile }}px;


    }
    .customer-testimonials-{{ section.id }} .quote svg {
      width: 28px;
      height: 28px;
    }

    .customer-testimonials-{{ section.id }} .swiper-header {
      max-width: 100%;
      padding-right: 24px;
    }

    .customer-testimonials-{{ section.id }} .slide-box .text-info,.customer-testimonials-{{ section.id }} .slide-box .text-info p{
      font-size: {{ section.settings.testimonials_info_size_mobile}}px;
      line-height:  1.2;
    }
    .customer-testimonials-{{ section.id }} .slide-box .text-url{
      font-size: {{ section.settings.testimonials_url_size_mobile}}px;
    }
  }
</style>
<div class="customer-testimonials-{{ section.id }}">
  <div class="ct-wrapper">
    <div class="swiper-header">
      <h3 class="swiper-title {{ section.settings.title_size }}">{{ section.settings.ct_title }}</h3>
      <div class="swiper-description">{{ section.settings.description }}</div>
    </div>
    <div class="swiper swiper-ct">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide">
            <div class="slide-box">
              <div class="box-top">
                <div class="quote">
                  <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none">
                    <path d="M12.0636 18.6018H5.32555V5.73438H18.2393V17.2026C18.6138 24.8476 14.9642 30.5359 7.2906 34.2651L4.20215 30.0687C9.4423 27.2727 12.0636 23.4496 12.0636 18.6018ZM24.1356 34.2651L21.0472 30.0687C26.0995 27.2727 28.7208 23.4496 28.9074 18.6018H22.1694V5.73438H35.0843V17.2026C35.4588 24.8476 31.8092 30.5359 24.1356 34.2651Z" fill="#E7E7E7"/>
                  </svg>
                </div>
                <div class="customer-info">
                  <div class="head">
                    <img
                      class="lazyload"
                      data-src="{{ block.settings.customer_img |  image_url: width: master }}"
                      alt=""
                    >
                  </div>
                  <div class="name {{ section.settings.customer_name_size }}">
                    <div class="customer-name">
                      {{ block.settings.customer_name }}
                    </div>

                    <div>
                      {{ block.settings.customer_description }}
                    </div>
                  </div>
                </div>
                <div class="star-wrapper">
                  {% for i in (1..block.settings.star) %}
                    ⭐
                  {% endfor %}
                </div>
                <div class="text-title {{ section.settings.testimonials_title_size }}">
                  {{ block.settings.testimonials_title }}
                </div>
                <div class="text-info {{ section.settings.testimonials_info_size }}">
                  {{ block.settings.testimonials_info }}
                </div>
              </div>
              {% if block.settings.testimonials_url != blank %}
                <div class="box-bottom">
                  <a
                    class="text-url {{ section.settings.testimonials_url_size }}"
                    href="{{ block.settings.testimonials_url }}"
                    >Learn more &gt;</a
                  >
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
<script>
  new Swiper('.customer-testimonials-{{ section.id }} .swiper-ct', {
    slidesPerView: 'auto',
    spaceBetween: 16,
    slidesOffsetBefore: 16,
    slidesOffsetAfter: 16,
    grabCursor: true,      // 鼠标变成抓手样式（体验更好）
    breakpoints: {
      768: {
        slidesOffsetBefore: 0,
        // 👉 桌面可以取消或调整
        slidesOffsetAfter: 0,
        spaceBetween: 10,
      },
    },
    navigation: {
      nextEl: '.swiper-button-next-{{ section.id }}',
      prevEl: '.swiper-button-prev-{{ section.id }}',
    },
  });
</script>

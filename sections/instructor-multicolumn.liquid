      padding-left: 0;
      padding-right: 0;
    }

    .member-benefits-container-{{ section.id }} .swiper-pagination {
      display: block;
    }

    .member-benefits-container-{{ section.id }} .heading {
      font-size: clamp(calc({{ section.settings.headding_size_mobile }}px * 0.85), calc({{ section.settings.headding_size_mobile }} / 375 * 100vw), calc({{ section.settings.headding_size_mobile }}px * 1));

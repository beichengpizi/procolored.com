    .member-benefits-container-{{ section.id }} .member-benefits-content .item .buttom-wrap a {
      padding: 12px 28px;
      min-width: 108px;
      font-size: 12px;
    }

    .member-benefits-wrap-{{ section.id }}__footer {
      margin-top: clamp(calc(20px * 0.85), calc(20 / 375 * 100vw), calc(20px * 1));
    }

    .member-benefits-wrap-{{ section.id }}_footer_button {
      padding: clamp(calc(20px * 0.85), calc(20 / 375 * 100vw), calc(20px * 1)) clamp(calc(48px * 0.85), calc(48 / 375 * 100vw), calc(48px * 1));
    }

    .member-benefits-container-{{ section.id }} .member-benefits-content .item .mobileShow {
      display: block;
      {% if section.settings.show_icon_max_height %}
        {% if section.settings.show_icon_in_headding %}
          width: 20%;
          max-height: max-content;
        {% else %}
          max-height: clamp(calc({{ section.settings.icon_max_height_mobile }}px * 0.85), calc({{ section.settings.icon_max_height_mobile }} / 375 * 100vw), calc({{ section.settings.icon_max_height_mobile }}px * 1));
        {% endif %}
      {% endif %}
    }

    .member-benefits-container-{{ section.id }} .member-benefits-content .item .desktopShow {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Instructor multicolumn",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "配置项"
    },
    {
      "type": "select",
      "id": "section_max_width",
      "label": "模块最大宽度",
      "options": [
        {
          "value": "none",
          "label": "全屏"
        },
        {
          "value": "1400",
          "label": "1400px"
        },
        {
          "value": "1200",
          "label": "1200px"
        },
        {
          "value": "980",
          "label": "980px"
        }
      ],
      "default": "1200"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "显示标签",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_icon_max_height",
      "label": "开启图标最大高度",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_icon_in_headding",
      "label": "开启图标在主标题内部",
      "default": false,
      "info": "目前仅支持移动端，开启后，图标会显示在主标题内部，而不是在主标题外部"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "背景颜色",
      "default": "#f5f5f5"
    },
    {
      "type": "range",
      "id": "item_border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "卡片边框圆角大小",
      "default": 20
    },
    {
      "type": "range",
      "id": "item_border_radius_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "卡片边框圆角大小（移动端）",
      "default": 20
    },

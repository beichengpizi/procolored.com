      text-align: {{ section.settings.title_alignment_mobile }};
      margin-bottom: clamp(calc({{ section.settings.title_margin_bottom_mobile }}px * 0.85), calc({{ section.settings.title_margin_bottom_mobile }} / 375 * 100vw), calc({{ section.settings.title_margin_bottom_mobile }}px * 1));
    }


        margin-bottom: clamp(calc({{ section.settings.headding_margin_bottom_mobile }}px * 0.85), calc({{ section.settings.headding_margin_bottom_mobile }} / 375 * 100vw), calc({{ section.settings.headding_margin_bottom_mobile }}px * 1));
      {% else %}
        margin-top: 0;
        margin-bottom: 0;

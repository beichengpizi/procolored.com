{% liquid
  assign row_count = section.settings.row | default: 4

  case row_count
    when 2
      assign row = 'lg:grid-cols-2'
    when 3
      assign row = 'lg:grid-cols-3'
    when 4
      assign row = 'lg:grid-cols-4'
    when 5
      assign row = 'lg:grid-cols-5'
    else
      assign row = 'lg:grid-cols-4'
  endcase

  assign footer_button_href = section.settings.button_link | default: '#'
%}

<div
  class="member-benefits-wrap-{{ section.id }}"
  data-section-type="member-benefits"
  style="background: {{ section.settings.bg_color }};"
>
  <div
    class="member-benefits-container-{{ section.id }} swiper swiper-container"
    data-member-benefits-container="{{ section.id }}"
  >
    <h2 class="heading m-0 {{ section.settings.heading_font_family }}">
      {{ section.settings.headding }}
    </h2>

    {% if section.settings.descriptiton != blank %}
      <div class="member-benefits-description-{{ section.id }} {{ section.settings.desc_font_family }}">
        {{ section.settings.descriptiton }}
      </div>
    {% endif %}

    <div class="member-benefits-content w-full inline-grid md:grid-cols-2 {{ row }} swiper-wrapper">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'member' -%}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              {% render 'member-benefits', type: 'member', block: block %}
            </div>
          {%- else -%}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              {% render 'member-benefits', type: 'item', block: block %}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {% if section.settings.button_text != blank %}
      {% if customer %}
        <div class="member-benefits-wrap-{{ section.id }}__footer">
          <a
            class="member-benefits-wrap-{{ section.id }}_footer_button"
            href="{{ footer_button_href }}"
          >
            {{ section.settings.button_text }}
          </a>
        </div>
      {% else %}
        <modal-login client:idle class="member-benefits-wrap-{{ section.id }}__footer">
          <a
            data-login
            class="member-benefits-wrap-{{ section.id }}_footer_button"
            href="/account"
          >
            {{ section.settings.button_text }}
          </a>
        </modal-login>
      {% endif %}
    {% endif %}

    <div class="swiper-pagination"></div>
  </div>
</div>

<script>
  (() => {
    const sectionId = '{{ section.id }}';
    const containerSelector = '.member-benefits-container-{{ section.id }}';
    const mobileQuery = window.matchMedia('(max-width: 768px)');
    const rowCount = {{ section.settings.row | default: 4 }};
    const desktopGap = {{ section.settings.item_gap | default: 16 }};
    const mobileGap = {{ section.settings.item_gap_mobile | default: 16 }};
    const maxRetryCount = 20;

    let retryCount = 0;
    let swiperInstance = null;
    let currentMode = '';
    let resizeTimer = null;

    const getContainer = () => document.querySelector(containerSelector);

    const getMode = () => {
      return mobileQuery.matches ? 'mobile' : 'desktop';
    };

    const getSwiperOptions = () => {
      const isMobile = mobileQuery.matches;

      return {
        slidesPerView: isMobile ? 1.2 : rowCount,
        spaceBetween: isMobile ? mobileGap : desktopGap,
        slidesOffsetBefore: isMobile ? 24 : 0,
        slidesOffsetAfter: isMobile ? 24 : 0,
        allowTouchMove: isMobile,
        watchOverflow: true,
        observer: true,
        observeParents: true,
        pagination: {
          el: `${containerSelector} .swiper-pagination`,
          clickable: true,
        },
      };
    };

    const destroySwiper = () => {
      if (swiperInstance && typeof swiperInstance.destroy === 'function') {
        swiperInstance.destroy(true, true);
      }

      swiperInstance = null;
      currentMode = '';
    };

    const initSwiper = () => {
      const container = getContainer();

      if (!container) return;

      if (typeof Swiper === 'undefined') {
        if (retryCount < maxRetryCount) {
          retryCount += 1;
          window.setTimeout(initSwiper, 100);
        }
        return;
      }

      const wrapper = container.querySelector('.member-benefits-content');
      const slides = container.querySelectorAll('.swiper-slide');

      if (!wrapper || slides.length === 0) return;

      const nextMode = getMode();

      if (swiperInstance && currentMode === nextMode) {
        if (typeof swiperInstance.update === 'function') {
          swiperInstance.update();
        }
        return;
      }

      destroySwiper();

      currentMode = nextMode;
      swiperInstance = new Swiper(containerSelector, getSwiperOptions());
    };

    const handleResize = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(initSwiper, 150);
    };

    const handleSectionLoad = (event) => {
      if (event.detail && event.detail.sectionId === sectionId) {
        initSwiper();
      }
    };

    const handleSectionUnload = (event) => {
      if (event.detail && event.detail.sectionId === sectionId) {
        destroySwiper();

        window.removeEventListener('resize', handleResize);
        document.removeEventListener('shopify:section:load', handleSectionLoad);
        document.removeEventListener('shopify:section:unload', handleSectionUnload);

        if (mobileQuery.removeEventListener) {
          mobileQuery.removeEventListener('change', initSwiper);
        } else if (mobileQuery.removeListener) {
          mobileQuery.removeListener(initSwiper);
        }
      }
    };

    initSwiper();

    window.addEventListener('resize', handleResize, { passive: true });
    document.addEventListener('shopify:section:load', handleSectionLoad);
    document.addEventListener('shopify:section:unload', handleSectionUnload);

    if (mobileQuery.addEventListener) {
      mobileQuery.addEventListener('change', initSwiper);
    } else if (mobileQuery.addListener) {
      mobileQuery.addListener(initSwiper);
    }
  })();
</script>


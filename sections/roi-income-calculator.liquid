                  <div class="modal__header">
                      <div class="modal__title" id="machineModalTitle">Select Machine</div>
                      <div class="modal__close" data-close-modal="machine" aria-label="Close machine picker">
                          <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24"
                              fill="none">
                              <path d="M5.88055 17.6418L17.6417 5.88068M5.88055 5.88068L17.6417 17.6418" stroke="black"
                                  stroke-width="2" stroke-linecap="round" />

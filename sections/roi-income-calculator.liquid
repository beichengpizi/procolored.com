              function renderMaterialPicker() {
                  dom.materialPicker.innerHTML = materialCatalog.map(material => `
          <div class="picker-card ${state.pendingMaterialIds.includes(material.id) ? "is-selected" : ""}"  data-material-option="${material.id}">
            <div class="picker-card__top">
              <div class="picker-card__check" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 16 16" fill="none">
    <path d="M12 0C14.2091 0 16 1.79086 16 4V12C16 14.2091 14.2091 16 12 16H4C1.79086 16 0 14.2091 0 12V4C0 1.79086 1.79086 0 4 0H12ZM12.7539 4.88574C12.4192 4.55103 11.8758 4.55109 11.541 4.88574L7.10547 9.32031L4.45801 6.67285L4.3623 6.58984C4.02679 6.3409 3.5504 6.36866 3.24609 6.67285C2.91142 7.00753 2.91153 7.55002 3.24609 7.88477L6.47656 11.1152L6.57227 11.1982C6.78953 11.3594 7.06509 11.4018 7.31543 11.3311C7.47597 11.2991 7.62948 11.2221 7.75391 11.0977L12.7539 6.09766L12.8369 6.00195C13.0857 5.66644 13.0581 5.19 12.7539 4.88574Z" fill="#FF8F1C"/>
  </svg>
              </div>
              ${renderPickerArt(material.imgUrl, materialSvg(material), material.name)}
            </div>
            <div class="picker-card__title">${escapeHtml(material.name)}</div>
            <div class="picker-card__price">${escapeHtml(currency(material.unitPrice, true))}</div>
          </div>
        `).join("");
              }
  
              function syncMachinePickerSelection() {
                  dom.machinePicker?.querySelectorAll("[data-machine-option]").forEach(option => {
                      const isSelected = option.dataset.machineOption === state.pendingMachineId;
                      option.classList.toggle("is-selected", isSelected);
                  });
              }
  
              function syncMaterialPickerSelection() {
                  dom.materialPicker?.querySelectorAll("[data-material-option]").forEach(option => {
                      const isSelected = state.pendingMaterialIds.includes(option.dataset.materialOption);
                      option.classList.toggle("is-selected", isSelected);
                  });
              }
  
              function getWorkingDays() {
                  return state.materials.length * WORKING_DAYS_PER_MONTH;
              }
  
              function getCostPeriodLabel(period = state.costPeriod) {
                  return COST_PERIOD_LABELS[period] || COST_PERIOD_LABELS.monthly;
              }
  
              // 将当前选择的周期换算成成本饼图使用的固定业务系数。
              function getCostPeriodFactors(period = state.costPeriod) {
                  switch (period) {
                      case "daily":
                          return {
                              printerFactor: 1 / HALF_YEAR_DAYS,
                              printheadFactor: 1 / HALF_YEAR_DAYS,
                              materialsFactor: 1 / WORKING_DAYS_PER_MONTH
                          };
                      case "weekly":
                          return {
                              printerFactor: 7 / HALF_YEAR_DAYS,
                              printheadFactor: 7 / HALF_YEAR_DAYS,
                              materialsFactor: 7 / WORKING_DAYS_PER_MONTH
                          };
                      case "monthly":
                          return {
                              printerFactor: WORKING_DAYS_PER_MONTH / HALF_YEAR_DAYS,
                              printheadFactor: WORKING_DAYS_PER_MONTH / HALF_YEAR_DAYS,
                              materialsFactor: 1
                          };
                      case "halfYearly":
                          return {
                              printerFactor: 1,
                              printheadFactor: 1,
                              materialsFactor: HALF_YEAR_DAYS / WORKING_DAYS_PER_MONTH
                          };
                      case "yearly":
                          return {
                              printerFactor: 1,
                              printheadFactor: 2,
                              materialsFactor: 12
                          };
                      default:
                          return {
                              printerFactor: WORKING_DAYS_PER_MONTH / HALF_YEAR_DAYS,
                              printheadFactor: WORKING_DAYS_PER_MONTH / HALF_YEAR_DAYS,
                              materialsFactor: 1
                          };
                  }
              }
  
              function getCostPartShare(value, total) {
                  return total > 0 ? Math.round((value / total) * 100) : 0;
              }
  
              function getCostPartLabelText(label, compact = false) {
                  const normalizedLabel = String(label).replace(/\(\$\)/g, "").replace(/\n/g, " ").trim();
                  if (compact && /Waste Rate$/i.test(normalizedLabel)) return "Waste";
                  return normalizedLabel;
              }
  
              function getCostLegendSelectedMap(parts = state.costBreakdownParts) {
                  return parts.reduce((selected, part) => {
                      selected[part.label] = state.costLegendSelected[part.label] !== false;
                      return selected;
                  }, {});
              }
  
              // 窄屏下对较长的饼图标签做换行处理，但不改动原始标签文本。
              function formatCostLabel(label, compact = false) {
                  if (!compact && /Waste Rate\(\$\)$/.test(label)) return label.replace(/ Waste Rate\(\$\)$/, " Waste\nRate($)");
                  if (compact) return getCostPartLabelText(label, true);
                  return label;
              }
  
              function isMobileViewport() {
                  return (window.innerWidth || document.documentElement.clientWidth || 0) <= 860;
              }
  
              function isMobileCostLayout() {
                  return isMobileViewport();
              }
  
              function getSafeMobileMaterialIndex() {
                  if (!state.materials.length) return -1;
                  return clamp(Number(state.mobileMaterialIndex) || 0, 0, state.materials.length - 1);
              }
  
              function getMobileMaterialCards() {
                  return dom.materialStack ? [...dom.materialStack.querySelectorAll(".nc-mat-card")] : [];
              }
  
              function updateMobileMaterialPager(materialCards, shouldPaginate) {
                  dom.mobileMaterialCount.textContent = materialCards.length ? `${state.mobileMaterialIndex + 1} / ${materialCards.length}` : "0 / 0";
                  const showPager = shouldPaginate && materialCards.length > 1;
                  dom.mobileMaterialPager.hidden = !showPager;
                  dom.mobileMaterialPrev.disabled = materialCards.length <= 1;
                  dom.mobileMaterialNext.disabled = materialCards.length <= 1;
                  dom.materialStack.classList.toggle("is-mobile-swipeable", shouldPaginate && materialCards.length > 1);
              }
  
              function scrollToMobileMaterial(index, behavior = "smooth") {
                  const materialCards = getMobileMaterialCards();
                  if (!dom.materialStack || !materialCards.length || !isMobileViewport()) return;
                  const safeIndex = clamp(index, 0, materialCards.length - 1);
                  const targetCard = materialCards[safeIndex];
                  if (!targetCard) return;
                  state.mobileMaterialIndex = safeIndex;
                  dom.materialStack.scrollTo({
                      left: targetCard.offsetLeft,
                      behavior
                  });
                  updateMobileMaterialPager(materialCards, true);
              }
  
              function syncMobileMaterialPresentation(options = {}) {
                  if (!dom.materialStack || !dom.mobileMaterialPager || !dom.mobileMaterialCount || !dom.mobileMaterialPrev || !dom.mobileMaterialNext) {
                      return;
                  }
  
                  const materialCards = getMobileMaterialCards();
                  const shouldPaginate = isMobileViewport() && materialCards.length > 0;
  
                  if (!materialCards.length) {
                      state.mobileMaterialIndex = 0;
                      dom.mobileMaterialPager.hidden = true;
                      dom.mobileMaterialCount.textContent = "0 / 0";
                      dom.mobileMaterialPrev.disabled = true;
                      dom.mobileMaterialNext.disabled = true;
                      dom.materialStack.classList.remove("is-mobile-swipeable");
                      return;
                  }
  
                  state.mobileMaterialIndex = getSafeMobileMaterialIndex();
                  materialCards.forEach((card, index) => {
                      card.hidden = false;
                      card.classList.toggle("is-mobile-active", index === state.mobileMaterialIndex);
                  });
                  updateMobileMaterialPager(materialCards, shouldPaginate);
  
                  if (shouldPaginate && options.syncScroll !== false) {
                      window.requestAnimationFrame(() => {
                          scrollToMobileMaterial(state.mobileMaterialIndex, options.behavior || "auto");
                      });
                      return;
                  }
  
                  if (!shouldPaginate) {
                      dom.materialStack.scrollLeft = 0;
                  }
              }
  
              function shiftMobileMaterial(step) {
                  const total = getMobileMaterialCards().length;
                  if (total <= 1) return;
                  scrollToMobileMaterial((getSafeMobileMaterialIndex() + step + total) % total);
              }
  
              function handleMobileMaterialScroll() {
                  if (!isMobileViewport()) return;
                  const materialCards = getMobileMaterialCards();
                  if (materialCards.length <= 1) return;
                  if (mobileMaterialScrollFrameId !== null) {
                      window.cancelAnimationFrame(mobileMaterialScrollFrameId);
                  }
  
                  mobileMaterialScrollFrameId = window.requestAnimationFrame(() => {
                      mobileMaterialScrollFrameId = null;
                      const currentScrollLeft = dom.materialStack.scrollLeft;
                      const nextIndex = materialCards.reduce((closestIndex, card, index, cards) => {
                          const currentDistance = Math.abs(card.offsetLeft - currentScrollLeft);
                          const closestDistance = Math.abs(cards[closestIndex].offsetLeft - currentScrollLeft);
                          return currentDistance < closestDistance ? index : closestIndex;
                      }, 0);
  
                      if (nextIndex !== state.mobileMaterialIndex) {
                          state.mobileMaterialIndex = nextIndex;
                      }
  
                      materialCards.forEach((card, index) => {
                          card.classList.toggle("is-mobile-active", index === state.mobileMaterialIndex);
                      });
                      updateMobileMaterialPager(materialCards, true);
                  });
              }
  
              function shouldShowDesktopCostGuide() {
                  return !isMobileCostLayout() && state.showCostGuide;
              }
  
              function getSafeCostPartIndex(parts = state.costBreakdownParts, candidate = state.activeCostPartIndex) {
                  if (!parts.length) return -1;
                  const parsedCandidate = Number(candidate);
                  if (!Number.isFinite(parsedCandidate)) return 0;
                  if (parsedCandidate < 0) return -1;
                  return clamp(parsedCandidate, 0, parts.length - 1);
              }
  
              function resetDesktopCostCallout() {
                  state.costGuideAnchor = null;
                  dom.costBreakdownCallout?.removeAttribute("data-align");
                  dom.costBreakdownCallout?.removeAttribute("style");
              }
  
              function clearCostGuideOverlay() {
                  if (!dom.costGuideOverlay) return;
                  dom.costGuideOverlay.innerHTML = "";
                  dom.costGuideOverlay.setAttribute("viewBox", `0 0 ${dom.costGuideOverlay.clientWidth || 0} ${dom.costGuideOverlay.clientHeight || 0}`);
              }
  
              function getCostCalloutLayout(partKey) {
                  return COST_CALLOUT_LAYOUTS[partKey] || COST_CALLOUT_LAYOUTS.printer;
              }
  
              function getCostPieLayout() {
                  const isMobile = isMobileCostLayout();
                  if (isMobile) {
                      return {
                          radius: ["0%", "48%"],
                          center: ["50%", "67%"],
                          left: 18,
                          right: 18,
                          top: 8,
                          bottom: 6
                      };
                  }
  
                  const viewportWidth = window.innerWidth || document.documentElement.clientWidth || 0;
                  if (viewportWidth <= 1180) {
                      return {
                          radius: ["0%", "48%"],
                          center: ["50%", "47%"],
                          left: 34,
                          right: 34,
                          top: 86,
                          bottom: 106
                      };
                  }
  
                  return {
                      radius: ["0%", "50%"],
                      center: ["50%", "47%"],
                      left: 38,
                      right: 38,
                      top: 88,
                      bottom: 108
                  };
              }
  
              function getCostGuideTargetPoint(stageRect, partKey) {
                  const layout = getCostCalloutLayout(partKey);
                  return {
                      x: stageRect.width * layout.x,
                      y: stageRect.height * layout.y,
                      align: layout.align
                  };
              }
  
              function getCostPieGeometry(stageRect) {
                  const layout = getCostPieLayout();
                  const centerX = stageRect.width * (parseFloat(layout.center[0]) / 100);
                  const centerY = stageRect.height * (parseFloat(layout.center[1]) / 100);
                  const outerRadius = Math.min(stageRect.width, stageRect.height) * (parseFloat(layout.radius[1]) / 200);
                  return { centerX, centerY, outerRadius };
              }
  
              function getCostGuidePathPoints(parts, activeIndex, stageRect) {
                  const part = parts[activeIndex];
                  if (!part) return null;
  
                  const total = parts.reduce((sum, item) => sum + item.value, 0);
                  if (!total) return null;
  
                  const consumedRatio = parts.slice(0, activeIndex).reduce((sum, item) => sum + item.value, 0) / total;
                  const partRatio = part.value / total;
                  const middleAngleDegrees = 90 - ((consumedRatio + partRatio / 2) * 360);
                  const middleAngleRadians = middleAngleDegrees * (Math.PI / 180);
                  const { centerX, centerY, outerRadius } = getCostPieGeometry(stageRect);
                  const startX = centerX + Math.cos(middleAngleRadians) * (outerRadius - 2);
                  const startY = centerY - Math.sin(middleAngleRadians) * (outerRadius - 2);
                  const elbowX = centerX + Math.cos(middleAngleRadians) * (outerRadius + 18);
                  const elbowY = centerY - Math.sin(middleAngleRadians) * (outerRadius + 18);
                  const target = state.costGuideAnchor || getCostGuideTargetPoint(stageRect, part.key);
  
                  return {
                      part,
                      startX,
                      startY,
                      elbowX,
                      elbowY,
                      targetX: target.x,
                      targetY: target.y
                  };
              }
  
              function renderDesktopCostGuideLine(parts = state.costBreakdownParts) {
                  if (!dom.costGuideOverlay || !dom.costStage) return;
                  if (!shouldShowDesktopCostGuide()) {
                      clearCostGuideOverlay();
                      return;
                  }
  
                  const activeIndex = getSafeCostPartIndex(parts);
                  if (activeIndex === -1) {
                      clearCostGuideOverlay();
                      return;
                  }
  
                  const stageRect = dom.costStage.getBoundingClientRect();
                  if (!stageRect.width || !stageRect.height) {
                      clearCostGuideOverlay();
                      return;
                  }
  
                  const points = getCostGuidePathPoints(parts, activeIndex, stageRect);
                  if (!points) {
                      clearCostGuideOverlay();
                      return;
                  }
  
                  dom.costGuideOverlay.setAttribute("viewBox", `0 0 ${Math.round(stageRect.width)} ${Math.round(stageRect.height)}`);
                  dom.costGuideOverlay.innerHTML = `
          <path d="M ${points.startX.toFixed(1)} ${points.startY.toFixed(1)} L ${points.elbowX.toFixed(1)} ${points.elbowY.toFixed(1)} L ${points.targetX.toFixed(1)} ${points.targetY.toFixed(1)}"
            fill="none"
            stroke="${points.part.color}"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <circle cx="${points.targetX.toFixed(1)}" cy="${points.targetY.toFixed(1)}" r="4" fill="${points.part.color}"></circle>
        `;
              }
  
              function positionDesktopCostCallout(partKey) {
                  if (!dom.costBreakdownCallout || !dom.costStage) return;
  
                  const layout = getCostCalloutLayout(partKey);
                  const stageRect = dom.costStage.getBoundingClientRect();
                  if (!stageRect.width || !stageRect.height) return;
  
                  const margin = 16;
                  const offset = 14;
                  const desiredX = stageRect.width * layout.x;
                  const desiredY = stageRect.height * layout.y;
                  const calloutWidth = dom.costBreakdownCallout.offsetWidth;
                  const calloutHeight = dom.costBreakdownCallout.offsetHeight;
                  const prefersLeftSide = layout.align === "right";
  
                  let left = prefersLeftSide ? desiredX - calloutWidth - offset : desiredX + offset;
                  left = clamp(left, margin, Math.max(margin, stageRect.width - calloutWidth - margin));
  
                  let top = desiredY - calloutHeight / 2;

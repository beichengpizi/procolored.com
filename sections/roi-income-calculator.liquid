                  dom.costBreakdownCallout.innerHTML = `
          <div class="nc-cost-callout-value">${currency(part.value, true)}</div>
          <p class="nc-cost-callout-inline">${escapeHtml(part.label)}: ${percent}%</p>
        `;
                  positionDesktopCostCallout(part.key);
                  renderDesktopCostGuideLine(parts);
              }
  
              function syncCostBreakdownSelection(parts = state.costBreakdownParts) {
                  const activeIndex = getSafeCostPartIndex(parts);
                  const syncButtons = container => {
                      container?.querySelectorAll("[data-cost-part-index]").forEach(button => {
                          const isActive = activeIndex !== -1 && Number(button.dataset.costPartIndex) === activeIndex;
                          button.classList.toggle("is-active", isActive);
                          button.setAttribute("aria-pressed", String(isActive));
                      });
                  };
                  if (activeIndex === -1) {
                      syncButtons(dom.costBreakdownList);
                      syncButtons(dom.costMobileBreakdown);
                      renderCostBreakdownCallout(parts);
                      clearCostGuideOverlay();
                      return;
                  }
  
                  state.activeCostPartIndex = activeIndex;
                  syncButtons(dom.costBreakdownList);
                  syncButtons(dom.costMobileBreakdown);
                  renderCostBreakdownCallout(parts);
              }
  
              function syncCostChartActiveState(chart = charts.cost) {
                  if (!chart) return;
                  const activeIndex = getSafeCostPartIndex();
                  const shouldActivate = activeIndex !== -1;
                  chart.dispatchAction({ type: "downplay", seriesIndex: 0 });
                  if (shouldActivate) {
                      chart.dispatchAction({
                          type: "highlight",
                          seriesIndex: 0,
                          dataIndex: activeIndex
                      });
                  }
              }
  
              function clearActiveCostPart(options = {}) {
                  const shouldSyncChart = options.syncChart !== false;
                  state.activeCostPartIndex = -1;
                  state.showCostGuide = false;
                  syncCostBreakdownSelection();
                  if (shouldSyncChart && charts.cost) {
                      if (isMobileCostLayout()) {
                          charts.cost.setOption(getCostChartOption(state.costBreakdownParts), { notMerge: true });
                      }
                      syncCostChartActiveState(charts.cost);
                  }
              }
  
              function setActiveCostPart(index, options = {}) {
                  const parts = options.parts || state.costBreakdownParts;
                  const nextIndex = getSafeCostPartIndex(parts, index);
                  if (nextIndex === -1) return;
  
                  if (typeof options.showGuide === "boolean") {
                      state.showCostGuide = options.showGuide;
                  }
  
                  const shouldSyncChart = options.syncChart !== false;
                  const didChange = nextIndex !== state.activeCostPartIndex;
                  state.activeCostPartIndex = nextIndex;
                  syncCostBreakdownSelection(parts);
  
                  if (shouldSyncChart && (didChange || options.force || typeof options.showGuide === "boolean")) {
                      if (isMobileCostLayout() && charts.cost) {
                          charts.cost.setOption(getCostChartOption(parts), { notMerge: true });
                      }
                      syncCostChartActiveState();
                  }
              }
  
              function hideCostGuide(options = {}) {
                  if (!state.showCostGuide && !options.force) return;
                  state.showCostGuide = false;
                  syncCostBreakdownSelection();
                  syncCostChartActiveState();
                  clearCostGuideOverlay();
              }
  
              function syncMachineHeader() {
                  const machine = getSelectedMachine();
                  dom.selectedMachineName.textContent = machine.name;
                  dom.selectedMachineName.title = machine.name;
                  dom.selectedMachinePrice.textContent = currency(machine.bundlePrice, true);
              }
  
              // 汇总指标继续使用 unitConsumables，确保利润和 ROI 的既有口径不被这次数据结构调整影响。
              function calculateMetrics() {
                  const machine = getSelectedMachine();
                  const machineCost = machine.bundlePrice;
                  const perUnitConsumables = machine.unitConsumables || {};
  
                  let totalUnits = 0;
                  let materialCost = 0;
                  let totalRevenue = 0;
                  let paybackContribution = 0;
                  let inkCost = 0;
                  let powderCost = 0;
                  let filmCost = 0;
                  let printheadCost = 0;
  
                  state.materials.forEach(material => {
                      const sales = Number(material.monthlySales) || 0;
                      totalUnits += sales;
                      materialCost += Number(material.unitCost) * sales;
                      totalRevenue += Number(material.unitPrice) * sales;
                      paybackContribution += (Number(material.unitPrice) - Number(material.unitCost)) * sales;
                      inkCost += perUnitConsumables.ink * sales;
                      powderCost += perUnitConsumables.powder * sales;
                      filmCost += perUnitConsumables.film * sales;
                      printheadCost += perUnitConsumables.printhead * sales;
                  });
  
                  const operatingBase = materialCost + inkCost + powderCost + filmCost + printheadCost;
                  const wasteCost = operatingBase * WASTE_RATE;
                  const totalOperatingCost = operatingBase + wasteCost;
                  const totalCost = machineCost + totalOperatingCost;
                  const monthlyProfit = totalRevenue - totalOperatingCost;
                  const monthlyGrossProfit = totalRevenue - materialCost;
                  // Match the requested formula:
                  // Equipment Investment / Σ((Unit Price - Unit Cost) * Monthly Units) per material card.
                  const paybackMonths = paybackContribution > 0 ? machineCost / paybackContribution : null;
  
                  return {
                      totalUnits,
                      fabricCost: materialCost,
                      totalCost,
                      totalRevenue,
                      monthlyProfit,
                      monthlyGrossProfit,
                      paybackMonths,
                      annualRevenue: totalRevenue * 12,
                      annualNetProfit: monthlyProfit * 12,
                      machineCost,
                      equipmentBreakdown: buildEquipmentBreakdown(machine, state.materials),
                      workingDays: getWorkingDays()
                  };
              }
  
              function formatPaybackPeriod(paybackMonths) {
                  if (paybackMonths === null) {
                      return { value: "--", unit: "month(s)" };
                  }
  
                  if (paybackMonths > 0 && paybackMonths < 1) {
                      const paybackDays = Math.min(30, Math.max(1, Math.ceil(paybackMonths * WORKING_DAYS_PER_MONTH)));
                      return {
                          value: String(paybackDays),
                          unit: "day(s)"
                      };
                  }
  
                  return {
                      value: (Math.ceil(paybackMonths * 10) / 10).toFixed(1),
                      unit: "month(s)"
                  };
              }
  
              function updateMetricsUI(metrics) {
                  dom.metricTotalUnits.textContent = number(metrics.totalUnits);
                  dom.metricTotalCost.textContent = currency(metrics.fabricCost, true);
                  dom.metricTotalRevenue.textContent = currency(metrics.totalRevenue, true);
                  dom.annualRevenueValue.textContent = currency(metrics.annualRevenue, true);
                  dom.annualProfitValue.textContent = currency(metrics.annualNetProfit, true);
                  dom.costBreakdownTotal.textContent = currency(metrics.equipmentBreakdown.total, true);
                  if (dom.workingDaysValue) {
                      dom.workingDaysValue.textContent = String(metrics.workingDays);
                  }
                  state.costBreakdownParts = metrics.equipmentBreakdown.parts;
                  renderCostPeriodControls();
                  renderCostBreakdownList(state.costBreakdownParts);
                  renderMobileCostBreakdown(state.costBreakdownParts);
                  setActiveCostPart(state.activeCostPartIndex, {
                      parts: state.costBreakdownParts,
                      syncChart: false,
                      force: true
                  });
  
                  const paybackDisplay = formatPaybackPeriod(metrics.paybackMonths);
                  dom.paybackValue.textContent = paybackDisplay.value;
                  if (dom.paybackUnit) {
                      dom.paybackUnit.textContent = paybackDisplay.unit;
                  }
              }
  
              function ensureProfitChart() {
                  if (!window.echarts) {
                      dom.profitChartStatus.classList.add("is-visible");
                      return null;
                  }
                  dom.profitChartStatus.classList.remove("is-visible");
                  if (charts.profit) return charts.profit;
                  charts.profit = window.echarts.init(dom.profitChart);
  
                  return charts.profit;
              }
  
              function ensureCostChart() {
                  if (!window.echarts) {
                      dom.costChartStatus.classList.add("is-visible");
                      return null;
                  }
                  dom.costChartStatus.classList.remove("is-visible");
                  if (charts.cost) return charts.cost;
                  charts.cost = window.echarts.init(dom.costChart);
                  charts.cost.on("legendselectchanged", event => {
                      state.costLegendSelected = { ...state.costLegendSelected, ...event.selected };
                  });
                  charts.cost.on("click", event => {
                      if (event.componentType !== "series" || !Number.isInteger(event.dataIndex)) return;
                      if (isMobileCostLayout() && state.activeCostPartIndex === event.dataIndex) {
                          clearActiveCostPart({ syncChart: true });
                          return;
                      }
                      setActiveCostPart(event.dataIndex, {
                          showGuide: !isMobileCostLayout(),
                          force: true
                      });
                  });
                  charts.cost.getZr().on("click", event => {
                      if (event.target || !isMobileCostLayout() || state.activeCostPartIndex === -1) return;
                      clearActiveCostPart({ syncChart: true });
                  });
  
                  return charts.cost;
              }
  
              function updateCharts(metrics) {
                  const profitChart = ensureProfitChart();
                  const costChart = state.activeInsight === "cost" || charts.cost ? ensureCostChart() : null;
  
                  if (profitChart) {
                      profitChart.setOption(getProfitChartOption(metrics), { notMerge: true });
                  }
  
                  if (costChart) {
                      costChart.setOption(getCostChartOption(metrics.equipmentBreakdown.parts), { notMerge: true });
                      syncCostChartActiveState(costChart);
                  }
              }
  
              function syncMaterialControls(card, material, field) {
                  const { min, max, step } = getFieldConfig(material, field);
                  const rangeConfig = getRangeFieldConfig(material, field);
                  const value = Number(material[field]);
                  const rangeInput = card.querySelector(`[data-range-input="${field}"]`);
                  const numberInput = card.querySelector(`[data-number-input="${field}"]`);
  
                  if (rangeInput) {
                      rangeInput.min = String(rangeConfig.min);
                      rangeInput.max = String(rangeConfig.max);
                      rangeInput.step = String(rangeConfig.step);
                      rangeInput.value = formatFieldValue(field, value);
                      rangeInput.style.background = getSliderBackground(value, rangeConfig.min, rangeConfig.max);
                  }
  
                  if (numberInput) {
                      numberInput.min = String(min);
                      numberInput.max = String(max);
                      numberInput.step = String(step);
                      numberInput.value = formatFieldValue(field, value);
                  }
              }
  
              function syncMaterialCard(materialId) {
                  const material = findMaterialById(materialId);
                  const card = dom.materialStack.querySelector(`[data-material-id="${materialId}"]`);
                  if (!material || !card) return;
  
                  syncMaterialControls(card, material, "unitCost");
                  syncMaterialControls(card, material, "unitPrice");
                  syncMaterialControls(card, material, "monthlySales");
              }
  
              function cancelScheduledDashboardUpdate() {
                  if (dashboardFrameId === null) return;
                  window.cancelAnimationFrame(dashboardFrameId);
                  dashboardFrameId = null;
              }
  
              function resizeCharts() {
                  charts.profit?.resize();
                  charts.cost?.resize();
              }
  
              function syncMobileInsightLayout() {
                  if (!dom.calculator) return;
                  dom.calculator.classList.toggle("is-mobile-cost-active", isMobileViewport() && state.activeInsight === "cost");
              }
  
              function refreshDashboard() {
                  cancelScheduledDashboardUpdate();
                  syncMobileInsightLayout();
                  syncMachineHeader();
                  resizeCharts();
                  const metrics = calculateMetrics();
                  updateMetricsUI(metrics);
                  updateCharts(metrics);
                  if (dom.mobileProfitNote) {
                      dom.mobileProfitNote.hidden = !(isMobileViewport() && state.activeInsight === "profit");
                  }
                  syncMobileMaterialPresentation();
              }
  
              function scheduleDashboardUpdate() {
                  if (dashboardFrameId !== null) return;
                  dashboardFrameId = window.requestAnimationFrame(() => {
                      dashboardFrameId = null;
                      refreshDashboard();
                  });
              }
  
              function renderCalculator(options = {}) {
                  if (options.renderMaterials) {
                      renderMaterialStack();
                  }
  
                  refreshDashboard();
              }
  
              function openModal(name) {
                  const target = dom.modals[name];
                  if (!target) return;
                  target.classList.add("is-open");
                  target.setAttribute("aria-hidden", "false");
                  document.body.style.overflow = "hidden";
                  target.querySelector(".modal__close")?.focus();
              }
  
              function closeModal(name) {
                  const target = dom.modals[name];
                  if (!target) return;
                  target.classList.remove("is-open");
                  target.setAttribute("aria-hidden", "true");
                  if (!root.querySelector(".modal.is-open")) {
                      document.body.style.overflow = "";
                  }
              }
  
              function handleMaterialControls(event) {
                  const input = event.target;
  
                  if (input.dataset.nameInput) {
                      const material = findMaterialById(input.dataset.nameInput);
                      if (material) material.name = input.value;
                      return;
                  }
  
                  const materialId = input.dataset.materialId;
                  if (!materialId) return;
  
                  const field = input.dataset.rangeInput || input.dataset.numberInput;
                  if (!field) return;
  
                  const material = findMaterialById(materialId);
                  if (!material) return;
  
                  const value = normalizeMaterialValue(material, field, input.value);
                  material[field] = value;
                  syncCoupledMaterialValues(material, field);
  
                  syncMaterialCard(materialId);
                  scheduleDashboardUpdate();
              }
  
              function handleInsightTab(tabName) {
                  state.activeInsight = tabName;
                  const isProfit = tabName === "profit";
                  dom.tabProfit.classList.toggle("is-active", isProfit);
                  dom.tabCost.classList.toggle("is-active", !isProfit);
                  dom.tabProfit.setAttribute("aria-selected", String(isProfit));
                  dom.tabCost.setAttribute("aria-selected", String(!isProfit));
                  dom.panelProfit.classList.toggle("is-active", isProfit);
                  dom.panelCost.classList.toggle("is-active", !isProfit);
                  syncMobileInsightLayout();
                  window.requestAnimationFrame(() => {
                      refreshDashboard();
                  });
              }
  
              function bindGlobalEvents() {
                  root.addEventListener("click", event => {
                      const openTrigger = event.target.closest("[data-open-modal]");
                      if (openTrigger) {
                          const name = openTrigger.dataset.openModal;
                          if (name === "machine") {
                              state.pendingMachineId = state.selectedMachineId;
                              renderMachinePicker();
                          }
                          if (name === "material") {
                              state.pendingMaterialIds = [];
                              renderMaterialPicker();
                          }
                          openModal(name);
                          return;
                      }
  
                      const closeTrigger = event.target.closest("[data-close-modal]");
                      if (closeTrigger) {
                          closeModal(closeTrigger.dataset.closeModal);
                          return;
                      }
  
                      const removeTrigger = event.target.closest("[data-remove-material]");
                      if (removeTrigger) {
                          const id = removeTrigger.dataset.removeMaterial;
                          state.materials = state.materials.filter(material => material.id !== id);
                          state.mobileMaterialIndex = getSafeMobileMaterialIndex();
                          renderCalculator({ renderMaterials: true });
                      }
                  });
  
                  document.addEventListener("keydown", event => {
                      if (event.key !== "Escape") return;
                      const activeModalEntry = Object.entries(dom.modals).find(([, modal]) => modal.classList.contains("is-open"));
                      if (activeModalEntry) {
                          closeModal(activeModalEntry[0]);
                      }
                  });
  
                  Object.entries(dom.modals).forEach(([name, modal]) => {
                      modal.addEventListener("click", event => {
                          if (event.target === modal) {
                              closeModal(name);
                          }
                      });
                  });
  
                  dom.materialStack.addEventListener("input", event => {
                      if (event.target.dataset.rangeInput || event.target.dataset.nameInput) {
                          handleMaterialControls(event);
                      }
                  });
                  dom.materialStack.addEventListener("change", handleMaterialControls);
                  dom.materialStack.addEventListener("scroll", handleMobileMaterialScroll, { passive: true });
                  dom.tabProfit.addEventListener("click", () => handleInsightTab("profit"));
                  dom.tabCost.addEventListener("click", () => handleInsightTab("cost"));
                  dom.costPeriodControls.addEventListener("change", event => {
                      const nextPeriod = event.target.value;
                      if (!nextPeriod || nextPeriod === state.costPeriod) return;
                      state.showCostGuide = false;
                      state.costPeriod = nextPeriod;
                      refreshDashboard();
                  });
                  const handleCostPartInteraction = event => {
                      const trigger = event.target.closest("[data-cost-part-index]");
                      if (!trigger) return;
                      const nextIndex = Number(trigger.dataset.costPartIndex);
                      if (!Number.isInteger(nextIndex)) return;
                      setActiveCostPart(nextIndex, { showGuide: !isMobileCostLayout() });
                  };
                  dom.costBreakdownList.addEventListener("mouseover", handleCostPartInteraction);
                  dom.costBreakdownList.addEventListener("focusin", handleCostPartInteraction);
                  dom.costBreakdownList.addEventListener("click", handleCostPartInteraction);
                  dom.costBreakdownList.addEventListener("mouseleave", () => {
                      if (!isMobileCostLayout()) hideCostGuide();
                  });
                  dom.costBreakdownList.addEventListener("focusout", event => {
                      if (isMobileCostLayout()) return;
                      if (event.relatedTarget && dom.costBreakdownList.contains(event.relatedTarget)) return;
                      hideCostGuide();
                  });
                  dom.costMobileBreakdown?.addEventListener("click", handleCostPartInteraction);
  
                  dom.machinePickerSave.addEventListener("click", () => {
                      state.selectedMachineId = state.pendingMachineId;
                      closeModal("machine");
                      renderCalculator({ renderMaterials: true });
                  });
  
                  dom.materialPickerSave.addEventListener("click", () => {
                      prependSelectedMaterials(state.pendingMaterialIds);
                      state.pendingMaterialIds = [];
                      closeModal("material");
                      renderCalculator({ renderMaterials: true });
                  });
  
                  dom.btnQuickCustom.addEventListener("click", () => {
                      state.materials.unshift(createCustomMaterial());
                      state.mobileMaterialIndex = 0;
                      renderCalculator({ renderMaterials: true });
                  });
  
                  dom.mobileMaterialPrev.addEventListener("click", () => {
                      shiftMobileMaterial(-1);
                  });
  
                  dom.mobileMaterialNext.addEventListener("click", () => {
                      shiftMobileMaterial(1);
                  });
  
                  dom.machinePicker.addEventListener("click", event => {
                      const option = event.target.closest("[data-machine-option]");
                      if (!option) return;
                      state.pendingMachineId = option.dataset.machineOption;
                      syncMachinePickerSelection();
                  });
  
                  dom.materialPicker.addEventListener("click", event => {
                      const option = event.target.closest("[data-material-option]");
                      if (!option) return;
                      const id = option.dataset.materialOption;
                      if (state.pendingMaterialIds.includes(id)) {
                          state.pendingMaterialIds = state.pendingMaterialIds.filter(item => item !== id);
                      } else {
                          state.pendingMaterialIds.push(id);
                      }
                      syncMaterialPickerSelection();
                  });
              }
  
              function collectDom() {
                  dom.calculator = root.querySelector("#income-calculator");
                  dom.materialStack = root.querySelector("#materialStack");
                  dom.machinePicker = root.querySelector("#machinePicker");
                  dom.materialPicker = root.querySelector("#materialPicker");
                  dom.profitChart = root.querySelector("#profitChart");
                  dom.costChart = root.querySelector("#costChart");
                  dom.selectedMachineName = root.querySelector("#selectedMachineName");
                  dom.selectedMachinePrice = root.querySelector("#selectedMachinePrice");
                  dom.metricTotalUnits = root.querySelector("#metricTotalUnits");
                  dom.metricTotalCost = root.querySelector("#metricTotalCost");
                  dom.metricTotalRevenue = root.querySelector("#metricTotalRevenue");
                  dom.paybackValue = root.querySelector("#paybackValue");
                  dom.annualRevenueValue = root.querySelector("#annualRevenueValue");
                  dom.annualProfitValue = root.querySelector("#annualProfitValue");
                  dom.workingDaysValue = root.querySelector("#workingDaysValue");
                  dom.costBreakdownTotal = root.querySelector("#costBreakdownTotal");
                  dom.costPeriodControls = root.querySelector("#costPeriodControls");
                  dom.costBreakdownList = root.querySelector("#costBreakdownList");
                  dom.costMobileBreakdown = root.querySelector("#costMobileBreakdown");
                  dom.costBreakdownCallout = root.querySelector("#costBreakdownCallout");
                  dom.costGuideOverlay = root.querySelector("#costGuideOverlay");
                  dom.costStage = root.querySelector(".nc-cost-stage");
                  dom.profitChartStatus = root.querySelector("#profitChartStatus");
                  dom.costChartStatus = root.querySelector("#costChartStatus");
                  dom.tabProfit = root.querySelector("#tabProfit");
                  dom.tabCost = root.querySelector("#tabCost");
                  dom.panelProfit = root.querySelector("#panelProfit");
                  dom.panelCost = root.querySelector("#panelCost");
                  dom.btnQuickCustom = root.querySelector("#btn-quick-custom");
                  dom.machinePickerSave = root.querySelector("#machinePickerSave");
                  dom.materialPickerSave = root.querySelector("#materialPickerSave");
                  dom.mobileMaterialPager = root.querySelector("#mobileMaterialPager");
                  dom.mobileMaterialPrev = root.querySelector("#mobileMaterialPrev");
                  dom.mobileMaterialNext = root.querySelector("#mobileMaterialNext");
                  dom.mobileMaterialCount = root.querySelector("#mobileMaterialCount");
                  dom.mobileProfitNote = root.querySelector("#mobileProfitNote");
                  dom.paybackUnit = root.querySelector(".paybackUnit");
                  dom.modals = {
                      machine: root.querySelector("#machineModal"),
                      material: root.querySelector("#materialModal")
                  };
              }
  
              
              function ensureEcharts() {
                  const scriptUrl = sectionConfig.echartsScriptUrl || 'https://cdn.jsdelivr.net/npm/echarts@6.0.0/dist/echarts.min.js';
                  if (window.echarts) return Promise.resolve(window.echarts);
                  const registry = window.__roiCalculatorEchartsRegistry = window.__roiCalculatorEchartsRegistry || {};
                  if (registry[scriptUrl]) return registry[scriptUrl];
  
                  registry[scriptUrl] = new Promise((resolve, reject) => {
                      const existingScript = document.querySelector(`script[data-roi-echarts-loader="${scriptUrl}"]`);
                      const handleLoad = () => resolve(window.echarts);
                      const handleError = () => reject(new Error('Failed to load ECharts.'));
  
                      if (existingScript) {
                          if (window.echarts) {
                              resolve(window.echarts);
                              return;
                          }
                          existingScript.addEventListener('load', handleLoad, { once: true });
                          existingScript.addEventListener('error', handleError, { once: true });
                          return;
                      }
  
                      const script = document.createElement('script');
                      script.src = scriptUrl;
                      script.defer = true;
                      script.dataset.roiEchartsLoader = scriptUrl;
                      script.addEventListener('load', handleLoad, { once: true });
                      script.addEventListener('error', handleError, { once: true });
                      document.head.appendChild(script);
                  });
  
                  return registry[scriptUrl];
              }
  
              function init() {
                  collectDom();
                  state.materials = getInitialMaterials();
                  syncMobileInsightLayout();
                  renderMachinePicker();
                  renderMaterialPicker();
                  renderCalculator({ renderMaterials: true });
                  bindGlobalEvents();
                  window.addEventListener("resize", scheduleDashboardUpdate);
              }
  
              init();
              ensureEcharts()
                  .then(() => {
                      scheduleDashboardUpdate();
                  })
                  .catch(() => {
                      scheduleDashboardUpdate();
                  });
          })();
  </script>
  

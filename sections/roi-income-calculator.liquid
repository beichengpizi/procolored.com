              </div>
          </div>
    <script type="application/json" data-roi-config>
      {
        "workingDaysPerMonth": {{ section.settings.working_days_per_month | json }},
        "minUnitCost": {{ section.settings.min_unit_cost | json }},
        "maxUnitCost": {{ section.settings.max_unit_cost | json }},
        "minUnitPrice": {{ section.settings.min_unit_price | json }},
        "maxUnitPrice": {{ section.settings.max_unit_price | json }},
        "minMonthlySales": {{ section.settings.min_monthly_sales | json }},
        "maxMonthlySales": {{ section.settings.max_monthly_sales | json }},
        "halfYearDays": {{ section.settings.half_year_days | json }},
        "wasteRatePercent": {{ section.settings.waste_rate_percent | json }},
        "locale": {{ section.settings.locale | json }},
        "currencyCode": {{ section.settings.currency_code | json }},
        "echartsScriptUrl": {{ section.settings.echarts_script_url | json }},
        "monthLabelsJson": {{ section.settings.month_labels_json | json }},
        "costPeriodLabelsJson": {{ section.settings.cost_period_labels_json | json }},
        "costBreakdownMetaJson": {{ section.settings.cost_breakdown_meta_json | json }},
        "costCalloutLayoutsJson": {{ section.settings.cost_callout_layouts_json | json }},
        "customMaterialUnitCost": {{ section.settings.custom_material_unit_cost | json }},
        "customMaterialUnitPrice": {{ section.settings.custom_material_unit_price | json }},
        "customMaterialMonthlySales": {{ section.settings.custom_material_monthly_sales | json }},
        "customMaterialSpeedModifier": {{ section.settings.custom_material_speed_modifier | json }},
        "machineCatalog": [
          {%- for block in machine_blocks -%}
            {%- liquid
              assign machine_product = block.settings.product
              assign machine_id = block.settings.machine_id | strip
              if machine_id == blank
                assign machine_id = block.id
              endif
              assign machine_name = block.settings.name | strip
              if machine_name == blank and machine_product != blank
                assign machine_name = machine_product.title
              endif
              if machine_name == blank
                assign machine_name = 'Machine'
              endif
              assign machine_short_name = block.settings.short_name | strip
              if machine_short_name == blank
                assign machine_short_name = machine_name
              endif
              assign machine_image_url = ''
              if block.settings.image != blank
                assign machine_image_url = block.settings.image | image_url: width: 900
              elsif machine_product != blank and machine_product.featured_image != blank
                assign machine_image_url = machine_product.featured_image | image_url: width: 900
              endif
              assign machine_bundle_price = block.settings.bundle_price
              if machine_bundle_price == blank and machine_product != blank and machine_product.selected_or_first_available_variant != blank
                assign machine_bundle_price = machine_product.selected_or_first_available_variant.price | divided_by: 100.0
              endif
              if machine_bundle_price == blank
                assign machine_bundle_price = 0
              endif
            -%}
            {
              "id": {{ machine_id | json }},
              "name": {{ machine_name | json }},
              "shortName": {{ machine_short_name | json }},
              "bundlePrice": {{ machine_bundle_price | json }},
              "speed": {{ block.settings.speed | default: 0 | json }},
              "accent": {{ block.settings.accent | json }},
              "imgUrl": {{ machine_image_url | json }},
              "productHandle": {{ machine_product.handle | json }},
              "defaultSelected": {{ block.settings.default_selected | json }},
              "unitConsumables": {
                "ink": {{ block.settings.unit_ink | default: 0 | json }},
                "powder": {{ block.settings.unit_powder | default: 0 | json }},
                "film": {{ block.settings.unit_film | default: 0 | json }},
                "printhead": {{ block.settings.unit_printhead | default: 0 | json }}
              },
              "consumables": {
                "printhead": {{ block.settings.printhead_cost | default: 0 | json }}
              }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "materialCatalog": [
          {%- for block in material_blocks -%}
            {%- liquid
              assign material_product = block.settings.product
              assign material_id = block.settings.material_id | strip
              if material_id == blank
                assign material_id = block.id
              endif
              assign material_name = block.settings.name | strip
              if material_name == blank and material_product != blank
                assign material_name = material_product.title
              endif
              if material_name == blank
                assign material_name = 'Material'
              endif
              assign material_image_url = ''
              if block.settings.image != blank
                assign material_image_url = block.settings.image | image_url: width: 900
              elsif material_product != blank and material_product.featured_image != blank
                assign material_image_url = material_product.featured_image | image_url: width: 900
              endif
              assign material_unit_price = block.settings.unit_price
              if material_unit_price == blank and material_product != blank and material_product.selected_or_first_available_variant != blank
                assign material_unit_price = material_product.selected_or_first_available_variant.price | divided_by: 100.0
              endif
              if material_unit_price == blank
                assign material_unit_price = 0
              endif
            -%}
            {
              "id": {{ material_id | json }},
              "name": {{ material_name | json }},
              "category": {{ block.settings.category | json }},
              "unitCost": {{ block.settings.unit_cost | default: 0 | json }},
              "unitPrice": {{ material_unit_price | json }},
              "monthlySales": {{ block.settings.monthly_sales | default: 0 | json }},
              "printSize": {{ block.settings.print_size | strip | json }},
              "speedModifier": {{ block.settings.speed_modifier | default: 1 | json }},
              "imgUrl": {{ material_image_url | json }},
              "productHandle": {{ material_product.handle | json }},
              "defaultSelected": {{ block.settings.default_selected | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  </div>
  
  <script>
  (() => {
              const root = document.getElementById('roi-income-calculator-{{ section.id }}');
              if (!root || root.dataset.roiInitialized === 'true') return;
              root.dataset.roiInitialized = 'true';
  
              const configNode = root.querySelector('[data-roi-config]');
              if (!configNode) return;
  
              let sectionConfig = {};
              try {
                  sectionConfig = JSON.parse(configNode.textContent);
              } catch (error) {
                  console.error('ROI calculator config parse failed.', error);
                  return;
              }
  
              const DEFAULT_MACHINE_CATALOG = Array.isArray(sectionConfig.machineCatalog) ? sectionConfig.machineCatalog : [];
              const DEFAULT_MATERIAL_CATALOG = Array.isArray(sectionConfig.materialCatalog) ? sectionConfig.materialCatalog : [];
              const DEFAULT_MONTH_LABELS = Array.from({ length: 12 }, (_, index) => `M${index + 1}`);
              const WASTE_RATE = Math.max(0, Number(sectionConfig.wasteRatePercent || 15) / 100);
              const DEFAULT_COST_PERIOD_LABELS = {
                  daily: 'Daily Cost',
                  weekly: 'Weekly Cost',
                  monthly: 'Monthly Cost',
                  halfYearly: 'Half-Yearly Cost',
                  yearly: 'Yearly Cost'
              };
              const DEFAULT_COST_CALLOUT_LAYOUTS = {
                  printer: { x: 0.84, y: 0.28, align: 'left' },
                  printhead: { x: 0.88, y: 0.56, align: 'left' },
                  ink: { x: 0.63, y: 0.82, align: 'left' },
                  film: { x: 0.16, y: 0.79, align: 'right' },
                  powder: { x: 0.1, y: 0.52, align: 'right' },
                  waste: { x: 0.15, y: 0.26, align: 'right' },
                  fabric: { x: 0.56, y: 0.15, align: 'left' }
              };
              const DEFAULT_COST_BREAKDOWN_META = {
                  printer: { label: 'Printer($)', color: '#82a5ff' },
                  printhead: { label: 'Printhead($)', color: '#ffd449' },
                  ink: { label: 'Ink($)', color: '#61ea40' },
                  film: { label: 'Film($)', color: '#ff4cc8' },
                  powder: { label: 'Powder($)', color: '#ff5d5d' },
                  waste: { label: `${Math.round(WASTE_RATE * 100)}% Waste Rate($)`, color: '#7adce6' },
                  fabric: { label: 'Fabric($)', color: '#4ea6f1' }
              };
              const mergeObjectSetting = (fallback, parsed) => {
                  const nextValue = { ...fallback };
                  Object.keys(parsed).forEach(key => {
                      const fallbackValue = fallback[key];
                      const parsedValue = parsed[key];
                      if (
                          fallbackValue && typeof fallbackValue === 'object' && !Array.isArray(fallbackValue)
                          && parsedValue && typeof parsedValue === 'object' && !Array.isArray(parsedValue)
                      ) {
                          nextValue[key] = { ...fallbackValue, ...parsedValue };
                          return;
                      }
                      nextValue[key] = parsedValue;
                  });
                  return nextValue;
              };
              const parseJsonSetting = (value, fallback) => {
                  if (typeof value !== 'string' || !value.trim()) return fallback;
                  try {
                      const parsed = JSON.parse(value);
                      if (Array.isArray(fallback)) {
                          return Array.isArray(parsed) && parsed.length ? parsed : fallback;
                      }
                      if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
                          return fallback;
                      }
                      return mergeObjectSetting(fallback, parsed);
                  } catch (error) {
                      console.warn('ROI calculator advanced JSON setting parse failed.', error);
                      return fallback;
                  }
              };
              const machineCatalog = DEFAULT_MACHINE_CATALOG.filter(item => item && item.id);
              const LOCALE = sectionConfig.locale || 'en-US';
              const CURRENCY_CODE = sectionConfig.currencyCode || 'USD';
              const WORKING_DAYS_PER_MONTH = Number(sectionConfig.workingDaysPerMonth) || 30;
              const UNIT_VALUE_CAP = 5000;
              const MONTHLY_SALES_CAP = 20000;
              const MIN_UNIT_COST = Math.min(Number(sectionConfig.minUnitCost) || 1, UNIT_VALUE_CAP);
              const MAX_UNIT_COST = Math.max(MIN_UNIT_COST, Math.min(Number(sectionConfig.maxUnitCost) || UNIT_VALUE_CAP, UNIT_VALUE_CAP));
              const MIN_UNIT_PRICE = Math.min(Number(sectionConfig.minUnitPrice) || 2, UNIT_VALUE_CAP);
              const MAX_UNIT_PRICE = Math.max(MIN_UNIT_PRICE, Math.min(Number(sectionConfig.maxUnitPrice) || UNIT_VALUE_CAP, UNIT_VALUE_CAP));
              const MIN_MONTHLY_SALES = Math.min(Number(sectionConfig.minMonthlySales) || 1, MONTHLY_SALES_CAP);
              const MAX_MONTHLY_SALES = Math.max(MIN_MONTHLY_SALES, Math.min(Number(sectionConfig.maxMonthlySales) || MONTHLY_SALES_CAP, MONTHLY_SALES_CAP));
              const materialCatalog = DEFAULT_MATERIAL_CATALOG
                  .filter(item => item && item.id)
                  .map(material => normalizeMaterialFields(material));
              const HALF_YEAR_DAYS = Number(sectionConfig.halfYearDays) || 182;
              const DEFAULT_MATERIAL_IDS = materialCatalog.filter(item => item.defaultSelected).map(item => item.id);
              const resolvedDefaultMaterialIds = DEFAULT_MATERIAL_IDS.length ? DEFAULT_MATERIAL_IDS : materialCatalog.slice(0, 1).map(item => item.id);
              const MONTH_LABELS = parseJsonSetting(sectionConfig.monthLabelsJson, DEFAULT_MONTH_LABELS);
              const COST_PERIOD_LABELS = parseJsonSetting(sectionConfig.costPeriodLabelsJson, DEFAULT_COST_PERIOD_LABELS);
              const COST_CALLOUT_LAYOUTS = parseJsonSetting(sectionConfig.costCalloutLayoutsJson, DEFAULT_COST_CALLOUT_LAYOUTS);
              const COST_BREAKDOWN_META = parseJsonSetting(sectionConfig.costBreakdownMetaJson, DEFAULT_COST_BREAKDOWN_META);
              const CUSTOM_MATERIAL_DEFAULTS = {
                  unitCost: Number(sectionConfig.customMaterialUnitCost) || 8,
                  unitPrice: Number(sectionConfig.customMaterialUnitPrice) || 24,
                  monthlySales: Number(sectionConfig.customMaterialMonthlySales) || 10000,
                  speedModifier: Number(sectionConfig.customMaterialSpeedModifier) || 1
              };
              const defaultMachineId = machineCatalog.find(item => item.defaultSelected)?.id || machineCatalog[0]?.id || '';
  
              const htmlEntityMap = {
                  "&": "&amp;",
                  "<": "&lt;",
                  ">": "&gt;",
                  '"': "&quot;",
                  "'": "&#39;"
              };
              const machineCatalogById = new Map(machineCatalog.map(machine => [machine.id, machine]));
              const materialCatalogById = new Map(materialCatalog.map(material => [material.id, material]));
  
              const state = {
                  selectedMachineId: defaultMachineId,
                  pendingMachineId: defaultMachineId,
                  pendingMaterialIds: [],
                  materials: [],
                  mobileMaterialIndex: 0,
                  activeInsight: "profit",
                  customMaterialCount: 0,
                  costPeriod: "monthly",
                  costBreakdownParts: [],
                  activeCostPartIndex: -1,
                  showCostGuide: false,
                  costGuideAnchor: null,
                  costLegendSelected: {}
              };
  
              const charts = { profit: null, cost: null };
              const dom = {};
              let dashboardFrameId = null;
              let presetMaterialCount = 0;
              let mobileMaterialScrollFrameId = null;
  
              function currency(value, compact = false) {
                  return new Intl.NumberFormat(LOCALE, {
                      style: "currency",
                      currency: CURRENCY_CODE,
                      minimumFractionDigits: 2,
                      maximumFractionDigits: 2
                  }).format(value);
              }
  
              function preciseCurrency(value) {
                  const numericValue = roundCurrencyValue(Number(value) || 0);
                  const hasDecimals = Math.abs(numericValue - Math.round(numericValue)) > 0.001;
                  return new Intl.NumberFormat(LOCALE, {
                      style: "currency",
                      currency: CURRENCY_CODE,
                      minimumFractionDigits: hasDecimals ? 2 : 0,
                      maximumFractionDigits: 2
                  }).format(numericValue);
              }
  
              function chartLabelCurrency(value) {
                  return new Intl.NumberFormat(LOCALE, {
                      style: "currency",
                      currency: CURRENCY_CODE,
                      minimumFractionDigits: 0,
                      maximumFractionDigits: 0
                  }).format(roundCurrencyValue(Number(value) || 0));
              }
  
              function number(value) {
                  return new Intl.NumberFormat(LOCALE, { maximumFractionDigits: 0 }).format(value);
              }
  
              function compactCurrencyAxis(value) {
                  const numericValue = Number(value) || 0;
                  const absValue = Math.abs(numericValue);
                  if (absValue >= 1000000000) {
                      return `$${(numericValue / 1000000000).toFixed(absValue >= 10000000000 ? 0 : 1).replace(/\.0$/, "")}B`;
                  }
                  if (absValue >= 1000000) {
                      return `$${(numericValue / 1000000).toFixed(absValue >= 10000000 ? 0 : 1).replace(/\.0$/, "")}M`;
                  }
                  if (absValue >= 1000) {
                      return `$${(numericValue / 1000).toFixed(absValue >= 10000 ? 0 : 1).replace(/\.0$/, "")}K`;
                  }
                  return currency(numericValue, true);
              }
  
              function clamp(value, min, max) {
                  return Math.min(max, Math.max(min, value));
              }
  
              function roundCurrencyValue(value) {
                  const numericValue = Number(value) || 0;
                  return Math.round((numericValue + Number.EPSILON) * 100) / 100;
              }
  
              function isPriceField(field) {
                  return field === "unitCost" || field === "unitPrice";
              }
  
              function formatFieldValue(field, value) {
                  const numericValue = Number(value) || 0;
                  return isPriceField(field) ? String(Math.round(numericValue)) : String(numericValue);
              }
  
              function normalizeMaterialFields(material) {
                  const unitPrice = Math.round(clamp(Number(material.unitPrice) || MIN_UNIT_PRICE, MIN_UNIT_PRICE, MAX_UNIT_PRICE));
                  const unitCostMax = Math.min(unitPrice, MAX_UNIT_COST);
                  const unitCost = Math.round(clamp(Number(material.unitCost) || MIN_UNIT_COST, MIN_UNIT_COST, unitCostMax));
                  const monthlySales = Math.round(clamp(Number(material.monthlySales) || MIN_MONTHLY_SALES, MIN_MONTHLY_SALES, MAX_MONTHLY_SALES));
                  const printSize = String(material.printSize || "").trim();
  
                  return {
                      ...material,
                      unitCost,
                      unitPrice,
                      monthlySales,
                      printSize
                  };
              }
  
              function createLinearGradient(stops) {
                  return {
                      type: "linear",
                      x: 0,
                      y: 0,
                      x2: 0,
                      y2: 1,
                      colorStops: stops.map(([offset, color]) => ({ offset, color })),
                      global: false
                  };
              }
  
              function escapeHtml(value) {
                  return String(value).replace(/[&<>"']/g, character => htmlEntityMap[character]);
              }
  
              function escapeSvgText(value) {
                  return escapeHtml(value);
              }
  
              function encodeSvg(svg) {
                  return "data:image/svg+xml;charset=UTF-8," + encodeURIComponent(svg);
              }
  
              function posterSvg(title, subtitle, paletteA, paletteB, icon) {
                  return encodeSvg(`
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 260">
            <defs>
              <linearGradient id="g" x1="0" x2="1" y1="0" y2="1">
                <stop offset="0%" stop-color="${paletteA}" />
                <stop offset="100%" stop-color="${paletteB}" />
              </linearGradient>
            </defs>
            <rect width="400" height="260" rx="36" fill="url(#g)" />
            <text x="34" y="76" fill="#181412" font-family="sans-serif" font-size="34" font-weight="900">${escapeSvgText(icon)}</text>
            <text x="32" y="170" fill="#181412" font-family="sans-serif" font-size="26" font-weight="800">${escapeSvgText(title)}</text>
            <text x="32" y="206" fill="#6e6560" font-family="sans-serif" font-size="18">${escapeSvgText(subtitle)}</text>
          </svg>
        `);
              }
  
              function machineSvg(machine) {
                  return encodeSvg(`
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 220 220">
            <defs>
              <linearGradient id="mb" x1="0" x2="1" y1="0" y2="1">
                <stop offset="0%" stop-color="${machine.accent}" />
                <stop offset="100%" stop-color="#fff3e6" />
              </linearGradient>
            </defs>
            <rect width="220" height="220" rx="30" fill="url(#mb)" />
            <text x="34" y="48" fill="#181412" font-family="sans-serif" font-size="24" font-weight="900">${escapeSvgText(machine.shortName)}</text>
          </svg>
        `);
              }
  
              function materialSvg(material) {
                  const palette = {
                      Apparel: ["#ffd2c8", "#fff5ed", "TS"],
                      Gift: ["#ffdfa4", "#fff5dc", "GF"],
                      Accessory: ["#d5f0e4", "#f3fcf7", "CP"]
                  };
                  const [start, end, icon] = palette[material.category] || ["#ffe4ca", "#fff8f3", "CT"];
                  return posterSvg(material.name, material.category, start, end, icon);
              }
  
              function renderPickerArt(imageUrl, fallbackUrl, altText) {
                  const resolvedSrc = imageUrl || fallbackUrl;
                  return `
          <img
            class="picker-card__art"
            src="${escapeHtml(resolvedSrc)}"
            data-fallback-src="${escapeHtml(fallbackUrl)}"
            alt="${escapeHtml(altText)}"
            loading="lazy"
            onerror="if(this.dataset.fallbackSrc){this.onerror=null;this.src=this.dataset.fallbackSrc;}"
          >
        `;
              }
  
              function renderMaterialImage(material) {
                  const fallbackUrl = materialSvg(material);
                  const resolvedSrc = material.imgUrl || fallbackUrl;
  
                  return `
          <img
            class="nc-mat-img"
            src="${escapeHtml(resolvedSrc)}"
            data-fallback-src="${escapeHtml(fallbackUrl)}"
            alt="${escapeHtml(material.name)}"
            loading="lazy"
            onerror="if(this.dataset.fallbackSrc){this.onerror=null;this.src=this.dataset.fallbackSrc;}"

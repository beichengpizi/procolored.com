              function findMaterialById(materialId) {
                  return state.materials.find(material => material.id === materialId) || null;
              }
  
              function prependSelectedMaterials(materialIds) {
                  const nextMaterials = [...materialIds]
                      .reverse()
                      .map(id => cloneMaterial(materialCatalogById.get(id)))
                      .filter(Boolean);
  
                  if (!nextMaterials.length) return;
                  state.materials = [...nextMaterials, ...state.materials];
                  state.mobileMaterialIndex = 0;
              }
  
              function machineSpeedForMaterial(machine, material) {
                  return Math.max(1, Math.round(machine.speed * material.speedModifier * 10) / 10);
              }
  
              function getSliderBackground(value, min, max) {
                  const safeMax = Math.max(min + 1, max);
                  const percent = ((value - min) / (safeMax - min)) * 100;
                  return `linear-gradient(90deg, #0164FF 0%, #0164FF ${percent}%, #e0e0e0 ${percent}%, #e0e0e0 100%)`;
              }
  
              function getFieldConfig(material, field) {
                  if (field === "unitCost") {
                      return {
                          label: "Unit Cost($)",
                          min: MIN_UNIT_COST,
                          max: clamp(Number(material.unitPrice), MIN_UNIT_COST, MAX_UNIT_COST),
                          step: 1
                      };
                  }
  
                  if (field === "unitPrice") {
                      return {
                          label: "Unit Price($)",
                          min: MIN_UNIT_PRICE,
                          max: MAX_UNIT_PRICE,
                          step: 1
                      };
                  }
  
                  return {
                      label: "Monthly Units",
                      min: MIN_MONTHLY_SALES,
                      max: MAX_MONTHLY_SALES,
                      step: 1
                  };
              }
  
              function normalizeMaterialValue(material, field, rawValue) {
                  const { min, max } = getFieldConfig(material, field);
                  const normalizedValue = clamp(Number(rawValue) || min, min, max);
                  return isPriceField(field) ? Math.round(normalizedValue) : normalizedValue;
              }
  
              function getRangeFieldConfig(material, field) {
                  const config = getFieldConfig(material, field);
                  if (field === "unitCost") {
                      return {
                          ...config,
                          max: MAX_UNIT_COST
                      };
                  }
  
                  if (field === "unitPrice") {
                      return {
                          ...config,
                          max: MAX_UNIT_PRICE
                      };
                  }
  
                  return config;
              }
  
              function syncCoupledMaterialValues(material, field) {
                  if (field === "unitPrice" && Number(material.unitCost) > Number(material.unitPrice)) {
                      material.unitCost = Math.round(clamp(Number(material.unitPrice), MIN_UNIT_COST, MAX_UNIT_COST));
                  }
              }
  
              function renderControlRow(material, field) {
                  const numberConfig = getFieldConfig(material, field);
                  const rangeConfig = getRangeFieldConfig(material, field);
                  const { label, min, max, step } = numberConfig;
                  const value = Number(material[field]);
                  const displayValue = formatFieldValue(field, value);
                  const safeMaterialId = escapeHtml(material.id);
                  return `
          <div class="nc-slider-row">
            <span class="nc-slider-label">${label}</span>
            <input class="nc-range" data-range-input="${field}" data-material-id="${safeMaterialId}" type="range" min="${rangeConfig.min}" max="${rangeConfig.max}" step="${rangeConfig.step}" value="${displayValue}" style="background:${getSliderBackground(value, rangeConfig.min, rangeConfig.max)}">
            <input class="nc-slider-input" data-number-input="${field}" data-material-id="${safeMaterialId}" type="number" min="${min}" max="${max}" step="${step}" value="${displayValue}">
          </div>
        `;
              }
  
              function renderMaterialCard(material, machine) {
                  const speed = machineSpeedForMaterial(machine, material);
                  const safeMaterialId = escapeHtml(material.id);
                  const safeMaterialName = escapeHtml(material.name);
                  const printSizeMarkup = material.printSize
                      ? `<br>Print Size: ${escapeHtml(material.printSize)}`
                      : "";
                  const materialMetaMarkup = material.isCustom ? "" : `<div class="nc-mat-sub">Print Speed: ${speed} pcs/hr${printSizeMarkup}</div>`;
                  const titleMarkup = material.isCustom
                      ? `<input type="text" class="nc-inline-name-input" value="${safeMaterialName}" placeholder="Product Name..." data-name-input="${safeMaterialId}">`
                      : `<div class="nc-mat-title">${safeMaterialName}</div>`;
  
                  const imageMarkup = material.isCustom
                      ? `<div class="nc-mat-img"></div>`
                      : renderMaterialImage(material);
  
                  return `
          <article class="nc-mat-card" data-material-id="${safeMaterialId}">
            <div class="nc-mat-header">

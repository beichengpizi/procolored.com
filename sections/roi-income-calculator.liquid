  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
    <path d="M3.75 4.16666V16.3333C3.75 17.4379 4.64543 18.3333 5.75 18.3333H14.25C15.3546 18.3333 16.25 17.4379 16.25 16.3333V4.16666H3.75Z" stroke="#333333" stroke-width="1.5" stroke-linejoin="round"/>
    <path d="M8.33331 8.33334V13.75" stroke="#333333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M11.6667 8.33334V13.75" stroke="#333333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M1.66669 4.16666H18.3334" stroke="#333333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M6.66669 4.16666L8.0371 1.66666H11.9905L13.3334 4.16666H6.66669Z" stroke="#333333" stroke-width="1.5" stroke-linejoin="round"/>
  </svg>

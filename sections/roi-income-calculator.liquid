              // 成本饼图会同时读取两类机器数据：
              // consumables 表示成本分解口径，unitConsumables 表示单件利润口径。
              function buildEquipmentBreakdown(machine, materials = state.materials) {
                  const normalizedMachine = machine || { bundlePrice: 0, consumables: {}, unitConsumables: {} };
                  const costConsumables = normalizedMachine.consumables || {};
                  const unitConsumables = normalizedMachine.unitConsumables || {};
                  const {
                      printerFactor,
                      printheadFactor,
                      materialsFactor
                  } = getCostPeriodFactors();
                  const monthlyMaterialTotals = (Array.isArray(materials) ? materials : []).reduce((totals, material) => {
                      const monthlyUnits = Number(material.monthlySales) || 0;
                      totals.fabric += (Number(material.unitCost) || 0) * monthlyUnits;
                      totals.ink += (Number(unitConsumables.ink) || 0) * monthlyUnits;
                      totals.film += (Number(unitConsumables.film) || 0) * monthlyUnits;
                      totals.powder += (Number(unitConsumables.powder) || 0) * monthlyUnits;
                      return totals;
                  }, {
                      fabric: 0,
                      ink: 0,
                      film: 0,
                      powder: 0
                  });
  
                  const printerValue = roundCurrencyValue((Number(normalizedMachine.bundlePrice) || 0) * printerFactor);
                  const printheadValue = roundCurrencyValue((Number(costConsumables.printhead) || 0) * printheadFactor);
                  const inkValue = roundCurrencyValue(monthlyMaterialTotals.ink * materialsFactor);
                  const filmValue = roundCurrencyValue(monthlyMaterialTotals.film * materialsFactor);
                  const powderValue = roundCurrencyValue(monthlyMaterialTotals.powder * materialsFactor);
                  const fabricValue = roundCurrencyValue(monthlyMaterialTotals.fabric * materialsFactor);
                  const subtotal = printerValue + printheadValue + inkValue + filmValue + powderValue + fabricValue;
                  const wasteValue = roundCurrencyValue(subtotal * WASTE_RATE);
  
                  const parts = [
                      { key: "printer", ...COST_BREAKDOWN_META.printer, value: printerValue },
                      { key: "printhead", ...COST_BREAKDOWN_META.printhead, value: printheadValue },
                      { key: "ink", ...COST_BREAKDOWN_META.ink, value: inkValue },
                      { key: "film", ...COST_BREAKDOWN_META.film, value: filmValue },
                      { key: "powder", ...COST_BREAKDOWN_META.powder, value: powderValue },
                      { key: "waste", ...COST_BREAKDOWN_META.waste, value: wasteValue },
                      { key: "fabric", ...COST_BREAKDOWN_META.fabric, value: fabricValue }
                  ];
  
                  return {
                      total: roundCurrencyValue(parts.reduce((sum, part) => sum + part.value, 0)),
                      parts
                  };
              }
  

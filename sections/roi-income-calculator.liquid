        `;
              }
  
              function cloneMaterial(material) {
                  if (!material) return null;
                  presetMaterialCount += 1;
                  return normalizeMaterialFields({
                      ...material,
                      id: `preset-${material.id}-${presetMaterialCount}`,
                      sourceId: material.id,
                      isCustom: false
                  });

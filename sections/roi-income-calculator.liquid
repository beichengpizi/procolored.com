              function createCustomMaterial() {
                  state.customMaterialCount += 1;
                  const id = `custom-${state.customMaterialCount}`;
                  return normalizeMaterialFields({
                      id,
                      sourceId: id,
                      name: "",
                      category: "Custom",
                      unitCost: CUSTOM_MATERIAL_DEFAULTS.unitCost,
                      unitPrice: CUSTOM_MATERIAL_DEFAULTS.unitPrice,
                      monthlySales: CUSTOM_MATERIAL_DEFAULTS.monthlySales,

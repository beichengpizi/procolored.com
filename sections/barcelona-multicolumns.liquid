        transform: translate(50%, -50%);
        left: 0;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-save-badge-arrow {
        width: 11px;
        height: 16px;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-save-badge-unit {
        font-size: 10px;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-save-badge-value {
        font-size: 14px;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-sale-price {
        font-size: 20px;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-original-price {

                class="valentines-day-swiper-promotion-nav-button"
                id="valentines-day-swiper-promotion-nextButton-{{ section.id }}-0"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 40 40" fill="none">
                  <g clip-path="url(#clip0_9975_6026)">
                    <circle cx="20" cy="20" r="20" transform="matrix(-1 0 0 1 40 0)" fill="#FF9900"/>
                    <path d="M16.8012 26.4L23.2012 19.6L16.8012 12.8" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </g>
                  <defs>
                    <linearGradient id="paint0_linear_9975_60261" x1="11" y1="3" x2="20" y2="40" gradientUnits="userSpaceOnUse">
                      <stop stop-color="#FA6E98"/>
                      <stop offset="0.340541" stop-color="#F66BA3"/>
                      <stop offset="1" stop-color="#EE66B7"/>
                    </linearGradient>
                    <clipPath id="clip0_9975_6026">
                      <rect width="40" height="40" fill="white" transform="matrix(-1 0 0 1 40 0)"/>
                    </clipPath>
                  </defs>
                </svg>
              </div>
            </div>
          </div>

          <div
            class="valentines-day-swiper-grid-container valentines-day-swiper-grid-{{ section.id }}-0 active"
            data-tab="0"
          >
            {%- for block in section.blocks -%}
              {%- liquid
                assign current_product = block.settings.product
                assign variant_position = block.settings.variant_index | default: 1 | plus: 0 | floor
                if variant_position < 1
                  assign variant_position = 1
                endif
                assign variant_index = variant_position | minus: 1
                assign variant = current_product.variants[variant_index] | default: current_product.variants[0]
                assign product_image_pc = variant.metafields.custom.activity_product_image_pc | default: variant.featured_image | default: current_product.metafields.custom.product_card_image_pc | default: current_product.featured_image
                assign product_image_mb = variant.metafields.custom.activity_product_image_mb | default: variant.featured_image | default: current_product.metafields.custom.product_card_image_mb | default: current_product.featured_image
                assign title = variant.metafields.custom.activity_product_short_name | default: current_product.metafields.custom.activity_page_product_short_name | default: current_product.title
                assign product_price = variant.metafields.custom.activity_sale_price.value | default: current_product.metafields.custom.activity_sale_price.value
                assign product_origin_price = variant.metafields.custom.activity_original_price.value | default: current_product.metafields.custom.activity_original_price.value
                assign product_diff_price = product_origin_price | minus: product_price
              -%}

              {%- if current_product != blank and current_product.available -%}
                <div
                  class="valentines-day-swiper-grid-item"
                >
                  <div class="valentines-day-swiper-promotion-products">
                    <div class="valentines-day-swiper-promotion-products-card">
                      {% if product_diff_price != blank
                        and product_diff_price > 0
                        and product_price > 0
                        and product_origin_price > 0
                      %}
                        <div class="valentines-day-swiper-product-label-container">
                          <div class="valentines-day-swiper-product-label-discount">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                              <path d="M3.77058 10.7559C3.55008 10.5354 3.43353 10.2317 3.44992 9.9203L3.7517 4.18632C3.7665 3.9053 3.99102 3.68078 4.27204 3.66599L10.006 3.3642C10.3174 3.34781 10.6211 3.46436 10.8416 3.68486L16.7531 9.59635C17.3975 10.2407 17.3975 11.2854 16.7531 11.9298L12.0155 16.6674C11.3711 17.3118 10.3264 17.3118 9.68206 16.6674L3.77058 10.7559Z" stroke="white" stroke-width="1.5"/>
                              <circle cx="7.97021" cy="7.99707" r="1.50364" transform="rotate(-45 7.97021 7.99707)" fill="white"/>
                            </svg>
                            <div class="valentines-day-swiper-product-label-discount-text">
                              <span class="valentines-day-swiper-product-label-discount-text-unit">
                                {{- 'general.cart_drawer.save' | t -}}
                              </span>
                              <span class="valentines-day-swiper-product-label-discount-text-value">
                                {{- product_diff_price | money_without_trailing_zeros -}}
                              </span>
                            </div>
                          </div>
                        </div>
                      {% endif %}
                      <a
                        style="aspect-ratio: 1/1"
                        class="valentines-day-swiper-promotion-product-image"
                        href="{{variant.url }}"
                        target="_blank"
                      >
                        {% if product_image_pc %}
                          <img
                            style="aspect-ratio: 1/1"
                            class="pc lazyload"
                            data-sizes="{{100 | divided_by: section.settings.prduct_num}}vw"
                            data-srcset="
                              {%- if product_image_pc.width >= 200 -%}{{ product_image_pc | image_url: width: 200 }} 200w,{%- endif -%}
                              {%- if product_image_pc.width >= 375 -%}{{ product_image_pc | image_url: width: 375 }} 375w,{%- endif -%}
                              {%- if product_image_pc.width >= 550 -%}{{ product_image_pc | image_url: width: 550 }} 550w,{%- endif -%}
                              {%- if product_image_pc.width >= 750 -%}{{ product_image_pc | image_url: width: 750 }} 750w,{%- endif -%}
                              {%- if product_image_pc.width >= 1100 -%}{{ product_image_pc | image_url: width: 1100 }} 1100w,{%- endif -%}
                              {%- if product_image_pc.width >= 1500 -%}{{ product_image_pc | image_url: width: 1500 }} 1500w,{%- endif -%}
                              {%- if product_image_pc.width >= 1780 -%}{{ product_image_pc | image_url: width: 1780 }} 1780w,{%- endif -%}
                              {%- if product_image_pc.width >= 2000 -%}{{ product_image_pc | image_url: width: 2000 }} 2000w,{%- endif -%}
                              {%- if product_image_pc.width >= 3000 -%}{{ product_image_pc | image_url: width: 3000 }} 3000w,{%- endif -%}
                              {%- if product_image_pc.width >= 3840 -%}{{ product_image_pc | image_url: width: 3840 }} 3840w,{%- endif -%}
                              {{ product_image_pc | image_url }} {{ product_image_pc.width }}w
                            "
                            data-src="{{ product_image_pc | image_url:width:750 }}"
                            alt="{{ product_image_pc.alt }}"
                          >
                        {% endif %}
                        {% if product_image_mb %}
                          <img
                            style="aspect-ratio: 1/1"
                            class="mb lazyload"
                            data-sizes="{{100 | divided_by: section.settings.prduct_num_mobile}}vw"
                            data-srcset="
                              {%- if product_image_mb.width >= 200 -%}{{ product_image_mb | image_url: width: 200 }} 200w,{%- endif -%}
                              {%- if product_image_mb.width >= 375 -%}{{ product_image_mb | image_url: width: 375 }} 375w,{%- endif -%}
                              {%- if product_image_mb.width >= 550 -%}{{ product_image_mb | image_url: width: 550 }} 550w,{%- endif -%}
                              {%- if product_image_mb.width >= 750 -%}{{ product_image_mb | image_url: width: 750 }} 750w,{%- endif -%}
                              {%- if product_image_mb.width >= 1100 -%}{{ product_image_mb | image_url: width: 1100 }} 1100w,{%- endif -%}
                              {%- if product_image_mb.width >= 1500 -%}{{ product_image_mb | image_url: width: 1500 }} 1500w,{%- endif -%}
                              {%- if product_image_mb.width >= 1780 -%}{{ product_image_mb | image_url: width: 1780 }} 1780w,{%- endif -%}
                              {%- if product_image_mb.width >= 2000 -%}{{ product_image_mb | image_url: width: 2000 }} 2000w,{%- endif -%}
                              {%- if product_image_mb.width >= 3000 -%}{{ product_image_mb | image_url: width: 3000 }} 3000w,{%- endif -%}
                              {%- if product_image_mb.width >= 3840 -%}{{ product_image_mb | image_url: width: 3840 }} 3840w,{%- endif -%}
                              {{ product_image_mb | image_url }} {{ product_image_mb.width }}w
                            "
                            data-src="{{ product_image_mb | image_url:width:750 }}"
                            alt="{{ product_image_mb.alt }}"
                          >
                        {% endif %}
                      </a>
                      <div class="valentines-day-swiper-promotion-product-content">
                        <div class="valentines-day-swiper-promotion-product-name" title="{{- title | escape -}}">
                          {{- title | escape -}}
                        </div>
                        <div class="valentines-day-swiper-promotion-product-content-bottom">
                          <div class="valentines-day-swiper-promotion-product-price">
                            {% if product_price != blank and product_price > 0 %}
                              <div class="valentines-day-swiper-promotion-product-sale-price">
                                {{ product_price | money_without_trailing_zeros }}
                              </div>
                            {% endif %}
                            {% if product_origin_price != blank
                              and product_origin_price > 0
                              and product_origin_price > product_price
                            %}
                              <div class="valentines-day-swiper-promotion-product-original-price">
                                {{ product_origin_price | money_without_trailing_zeros }}
                              </div>
                            {% endif %}
                          </div>

                          {% if section.settings.product_num == '2'
                            and product_diff_price != blank
                            and product_diff_price > 0
                            and product_price > 0
                            and product_origin_price > 0
                          %}
                            <div class="valentines-day-swiper-product-save-badge">
                              <img
                                class="valentines-day-swiper-product-save-badge-img"
                                src="https://cdn.shopify.com/s/files/1/0509/3454/6613/files/acc72038efdfd0fbbabdac58a0c18850.jpg?v=1778808580"
                                alt=""
                              >
                                <div class="valentines-day-swiper-product-save-badge-content">
                                  <div class="valentines-day-swiper-product-save-badge-arrow">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="16" viewBox="0 0 11 16" fill="none">
                                      <path d="M8.14147 0C8.20092 0 8.24872 0.0543174 8.24889 0.121094V8.88867H10.8729C10.979 8.88867 11.0379 9.01485 10.9715 9.09961L5.5985 15.9521C5.54795 16.0166 5.45186 16.0165 5.40124 15.9521L0.0281903 9.09961C-0.0381805 9.01497 0.0200317 8.88904 0.125847 8.88867H2.74889V0.121094C2.74907 0.0543162 2.79784 0 2.85729 0H8.14147Z" fill="url(#save-arrow-gradient-{{ section.id }}-{{ variant.id }}-grid)"/>
                                      <defs>
                                        <linearGradient id="save-arrow-gradient-{{ section.id }}-{{ variant.id }}-grid" x1="5.5" y1="0" x2="5.5" y2="16" gradientUnits="userSpaceOnUse">
                                          <stop offset="7.15%" stop-color="#FFFFFF" stop-opacity="0"/>
                                          <stop offset="57.99%" stop-color="#FFB039"/>
                                          <stop offset="97.29%" stop-color="#FF9900"/>
                                        </linearGradient>
                                      </defs>
                                    </svg>
                                  </div>
                                  <div class="valentines-day-swiper-product-save-badge-text">
                                    <span class="valentines-day-swiper-product-save-badge-unit">
                                      {{ 'general.cart_drawer.save' | t }}
                                    </span>
                                    <span class="valentines-day-swiper-product-save-badge-value">
                                      {{ product_diff_price | money_without_trailing_zeros }}
                                    </span>
                                  </div>
                                </div>
                            </div>
                          {% endif %}
                        </div>
                      </div>
                      <div class="valentines-day-swiper-promotion-product-button-wrapper">
                        <product-card>
                          <div
                            class="
                               valentines-day-swiper-promotion-product-button-add-to-cart product-btn external-add-to-cart-button product-card--add-to-cart-button product-card--add-to-cart-button-simple button accent
                               {% unless block.settings.show_sale_now -%}
                                  valentines-day-swiper-promotion-product-button-stop-sale
                              {%- endunless -%}
                            "
                            data-product-id="{{ variant.id }}"
                            tabindex="-1"
                            {% if variant.available == false or block.settings.show_sale_now == false %}
                              disabled
                            {% endif %}
                          >
                            {% render 'svg-icons' with 'thb-loading' %}
                            <span class="product-card--add-to-cart-text">
                              {%- if variant.available -%}
                                {%- if section.settings.buy_now_button_text != empty -%}
                                  {%- if block.settings.show_sale_now -%}
                                    {{ section.settings.buy_now_button_text }}
                                  {%- else -%}
                                    {{- 'products.product.sold_out' | t -}}
                                  {%- endif -%}
                                {%- else -%}
                                  {%- if product_diff_price > 0 -%}
                                    {{ 'general.cart_drawer.save' | t }}
                                    {{ product_diff_price | money_without_trailing_zeros -}}
                                  {%- else -%}
                                    {{ 'products.product.buy_now' | t }}
                                  {%- endif -%}
                                {%- endif -%}
                              {%- else -%}
                                {{- 'products.product.sold_out' | t -}}
                              {%- endif -%}
                            </span>
                          </div>
                        </product-card>
                        <div
                          class="valentines-day-swiper-promotion-product-button-view-more"
                          onclick="window.open('{{variant.url }}','_blank');"
                        >
                          {{ section.settings.learn_more_button_text }}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
      </div>
    </div>
  </div>
</section>

<script>
  // 鐩戝惉椤甸潰DOM鍔犺浇锛屽垵濮嬪寲swiper涓巘ab浜や簰
  document.addEventListener('DOMContentLoaded', function () {
  // swiper瀹炰緥鍙橀噺瀹氫箟锛屾敼涓哄姩鎬佹暟閲忎互渚垮悗缁墿灞曪紙姝ゅ鍐?浠ュ吋瀹瑰師缁撴瀯锛?
  const SWIPER_COUNT = {% if blocks_count > 0 %}1{% else %}0{% endif %};
  let productCount = 0;
  if (SWIPER_COUNT == 0) { 
    return;
  }
  let swipers = Array(SWIPER_COUNT).fill(null);

  /**
  * 鏇存柊褰撳墠婵€娲籗wiper瀵瑰簲鐨勫乏鍙冲鑸寜閽姸鎬?
  */
  function updateNavigationButtons(activeIdx = null) {
  swipers.forEach((swiper, i) => {
    const prevBtn = document.getElementById(`valentines-day-swiper-promotion-prevButton-{{ section.id }}-${i}`);
    const nextBtn = document.getElementById(`valentines-day-swiper-promotion-nextButton-{{ section.id }}-${i}`);
    if (swiper && prevBtn && nextBtn) {
      prevBtn.disabled = swiper.isBeginning;
      nextBtn.disabled = swiper.isEnd;
      // 鍙珮浜綋鍓嶆縺娲籹wiper鐨勬寜閽紝鍏跺畠涓嶅彉
      if (activeIdx !== null) {
        prevBtn.classList.toggle('active', i === activeIdx);
        nextBtn.classList.toggle('active', i === activeIdx);
      }
    }
  });
  }
    let slidesPerView = 'auto';
    let slidesPerView1600 = 'auto';
    let slidesPerView1400 = 'auto';
    let slidesPerView1200 = 'auto';
    let slidesPerView768 = 'auto';
    let simulateTouch = true;
    let allowTouchMove = true;
    
    const section_max_width = '{{ section.settings.section_max_width }}';
    const product_num = {{ section.settings.product_num | minus: 0  | default:0 }};

  /**
  * 鍒濆鍖栨墍鏈塻wiper瀹瑰櫒
  * 姣忔鍒囨崲tab浼氶噸鏂伴攢姣佸苟鏂板缓瀵瑰簲swiper锛岀‘淇濆悓姝?
  */
  function initAllSwipers() {
  // 鍏堥攢姣佸凡瀛樺湪鐨剆wiper瀹炰緥锛岄伩鍏嶅唴瀛樻硠婕忎笌浜嬩欢缁戝畾閲嶅
  swipers.forEach((swiper) => {
    if (swiper) swiper.destroy(true, true);
  });

  // 閫氱敤Swiper鍙傛暟
  {% comment %} 绂佹榧犳爣宸﹀彸婊戝姩锛岀Щ鍔ㄧ鍏佽 {% endcomment %}
  const baseConfig = (idx,slidesPerView,slidesPerView1600,slidesPerView1400,slidesPerView1200,simulateTouch,allowTouchMove) => ({
    slidesPerView: slidesPerView,

    spaceBetween: {{ section.settings.card_gap | minus: 0}},
    navigation: {
      nextEl: `#valentines-day-swiper-promotion-nextButton-{{ section.id }}-${idx}`,
      prevEl: `#valentines-day-swiper-promotion-prevButton-{{ section.id }}-${idx}`,
    },
    scrollbar: {
      el: `.swiper-scrollbar-{{ section.id }}-${idx}`,
      hide: false,
    },
  
    loopedSlides: 10, // 瑙ｅ喅寰幆鏃惰竟鐣屾粦鍔ㄩ棶棰?
    observer: true,
    observeParents: true,
    // 绂佹PC绔紶鏍囨嫋鍔ㄥ拰婊戝姩锛屼粎鍏佽绉诲姩绔Е鎽告粦鍔?
    
    simulateTouch: simulateTouch,
    allowTouchMove:  allowTouchMove,  
    // 浜嬩欢缁戝畾寤惰繜鍒颁笅鏂?
    breakpoints: {
      1600: {
          slidesPerView: slidesPerView1600,
          spaceBetween: {{ section.settings.card_gap_mobile | minus: 0 }},
        
      
        },
        1400: {
            slidesPerView: slidesPerView1400,
            spaceBetween: {{ section.settings.card_gap_mobile | minus: 0 }},
          

          },
      1200: {
        slidesPerView: slidesPerView1200,
        spaceBetween: {{ section.settings.card_gap_mobile | minus: 0 }},
        slidesOffsetBefore: 0, 
      
      },
      
      768: {
        slidesPerView: 1.4,
        spaceBetween: {{ section.settings.card_gap_mobile | minus: 0 }},
        simulateTouch: true,
        allowTouchMove:  true,
        slidesOffsetBefore: 16,  // 澧炲姞宸︿晶鍋忕Щ閲?
        slidesOffsetAfter: 16    // 澧炲姞鍙充晶鍋忕Щ閲?
      },
    },
  });
  let navButtons =null;
  // 鍒涘缓swiper瀹炰緥锛屽噺灏戝啑浣?
  for (let i = 0; i < SWIPER_COUNT; i++) {
    const swiperContainer = document.querySelector(`.valentines-day-swiper-promotion-products-swiper-container-{{ section.id }}-${i}`);
    if (swiperContainer) {
      navButtons = swiperContainer.querySelector('.valentines-day-swiper-promotion-navigation-buttons');

    }
      productCount = swiperContainer ? swiperContainer.getAttribute('data-product-count') : null;
      if(product_num>=productCount && productCount>0 && section_max_width !== 'none' ){
          slidesPerView = product_num;
          slidesPerView1600 = product_num;
          slidesPerView1400 = product_num;
          slidesPerView1200 = product_num;
          simulateTouch = false;
          allowTouchMove = false;
          // PC绔缃负0锛岀Щ鍔ㄧ璁剧疆涓?
          if (navButtons) {
            if (window.innerWidth <= 768) {
              navButtons.style.opacity = '1'; // 绉诲姩绔?
              navButtons.style.display = 'flex';
            } else {
              navButtons.style.opacity = '0'; // PC绔?
              navButtons.style.display = 'none';
            }
          }
      }
      else if(productCount >product_num && productCount>0 && section_max_width !== 'none'){ 
          slidesPerView = product_num;
          slidesPerView1600 = product_num;
          slidesPerView1400 = product_num;
          slidesPerView1200 = product_num;
          simulateTouch = true;
          allowTouchMove = true;
      }
      else if(productCount >product_num && productCount>0){ 
          slidesPerView = product_num + 0.6;
          slidesPerView1600 = product_num - 1.6;
          slidesPerView1400 = product_num - 1.6;
          slidesPerView1200 = product_num - 1.6;
      }   else if(productCount < product_num && productCount>0){ 
          slidesPerView = productCount;
          slidesPerView1600 = productCount;
          slidesPerView1400 = productCount;
          slidesPerView1200 = productCount;
      }
    swipers[i] = new Swiper(swiperContainer, baseConfig(i,slidesPerView,slidesPerView1600,slidesPerView1400,slidesPerView1200,simulateTouch,allowTouchMove));
  

  }

  // 涓烘瘡涓猻wiper缁戝畾slideChange涓巌nit浜嬩欢
  swipers.forEach((swiper, idx) => {
    if (swiper) {
      swiper.on('slideChange', () => updateNavigationButtons(idx));
      swiper.on('init', () => updateNavigationButtons(idx));
    }
  });
  }

  // swiper鍒濆鍖?
  initAllSwipers();

  });
</script>

{% schema %}
{
  "name": "Barcelona multicolumns",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Product metafields",
      "info": "The product cards read the existing product and variant metafields."
    },
    {
      "type": "paragraph",
      "content": "Product variant selector: activity page product variant select"
    },
    {
      "type": "paragraph",
      "content": "Product images: product card image pc / product card image mb"
    },
    {
      "type": "paragraph",
      "content": "Product short name: activity page product short name"
    },
    {
      "type": "paragraph",
      "content": "Prices: activity sale price / activity original price"
    },
    {
      "type": "paragraph",
      "content": "Variant images and prices use the same activity metafields on the selected variant first."
    },
    {
      "type": "text",
      "id": "nav_id",
      "label": "Anchor ID",
      "default": "star-products"
    },
    {
      "type": "select",
      "id": "section_max_width",
      "label": "Section max width",
      "options": [
        { "value": "none", "label": "Full width" },
        { "value": "1400", "label": "1400px" },
        { "value": "1280", "label": "1280px" },
        { "value": "1200", "label": "1200px" },
        { "value": "1020", "label": "1020px" },
        { "value": "980", "label": "980px" }
      ],
      "default": "1400"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Title",
      "default": "Stock Up & Save Big on Consumables"
    },
    {
      "type": "html",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Premium DTF & UV DTF films and inks, engineered for consistent quality and reliable performance."
    },
    {
      "type": "html",
      "id": "desc",
      "label": "Description",
      "default": "<div>Our Biggest Offer EVER - <span>Up to $1399 OFF!</span><br>Limited Time, Limited Stock!</div>"
    },
    {
      "type": "checkbox",
      "id": "show_swiper_mb",
      "label": "Enable swiper on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_star_pick",
      "label": "Show star pick",
      "default": false
    },
    {
      "type": "text",
      "id": "learn_more_button_text",
      "label": "Learn more button text",
      "default": "Learn More"
    },

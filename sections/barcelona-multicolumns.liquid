<style>
    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-wrapper {
      background-color: {{ section.settings.bg_color }};
      padding: {{ section.settings.padding_top }}px 0px {{ section.settings.padding_bottom }}px 0px;
      overflow: hidden;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-container {
      position: relative;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-title-wrapper {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      {% if section.settings.section_max_width != 'none' %}
        max-width: {{ section.settings.section_max_width }}px;
        margin: 0 auto;
      {% else %}
        width: 100%;
        margin-right: 0;
      {% endif %}
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-title {
      color: #1E1E1E;
      text-align: center;
      font-size: 40px;
      font-weight: 800;
      line-height: 1.22;
      margin-bottom: 16px;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-subtitle {
      color: rgba(0, 0, 0, 0.90);
      text-align: center;
      font-size: 20px;
      font-weight: 400;
      line-height: 1.33;
      margin-bottom: 48px;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-desc {
      color: #fff;
      text-align: center;
      font-size: 24px;
      font-weight: 500;
      line-height: 1.5;
      margin-bottom: 48px;
      width: 100%;
    }

    .valentines-day-swiper-{{ section.id }} .exhibition-products-main-banner-box {
      {% if section.settings.section_max_width != 'none' %}
        max-width: {{ section.settings.section_max_width }}px;
      {% else %}
        width: 100%;
        max-width: 100%;
      {% endif %}
      margin-top: 24px;
      margin-bottom: 48px;
      padding: 0px 45px;
    }

    .valentines-day-swiper-{{ section.id }} .exhibition-products-main-banner-box img {
      display: flex;
      width: 100%;
      max-width: 100%;
    }

    .valentines-day-swiper-{{ section.id }} .exhibition-products-main-banner-box .pc {
      display: flex;
    }

    .valentines-day-swiper-{{ section.id }} .exhibition-products-main-banner-box .mb {
      display: none;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-content {
      {% if section.settings.section_max_width != 'none' %}
        max-width: {{ section.settings.section_max_width }}px;
        margin: 0 auto;
      {% else %}
      {% endif %}
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-products-card {
      border-radius: 16px;
      background-color: {{ section.settings.card_bg_color }};
      position: relative;
      padding: 20px;
      background-clip: padding-box;
      background: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      height: 100%;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-products-swiper-container .swiper-wrapper {
      align-items: stretch;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-products-slide,
    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-grid-item {
      height: auto;
      display: flex;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-products {
      display: flex;
      width: 100%;
      height: 100%;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-label-container {
      display: flex;
      align-items: center;
      gap: 8px;
      z-index: 1;
      background: #FF9900;
      border-radius: 16px;
      padding: 6px 8px;
      position: absolute;
      left: 12px;
    }

   .valentines-day-swiper-{{ section.id }}  .valentines-day-radio-product-label-discount {
      position: absolute;
      top: 24px;
      left: 24px;
      padding: 6px 8px;
      border-radius: 16px;
      background: #FF9900;
      display: flex;
      justify-content: center;
      line-height: 1;
    }

    .valentines-day-swiper-{{ section.id }}  .valentines-day-swiper-product-label-container img {
      position: absolute;
      left: -25px;
      bottom: -2px;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-label-discount {
      display: flex;
      position: relative;
      gap: 4px;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-label-discount-text {
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      line-height: 1;
      display: flex;
      justify-content: center;
      gap: 4px;
      align-items: center;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-label-discount-text-value {
      font-size: 14px;
      font-weight: 700;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-image {
      width: 100%;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-image img {
      width: 100%;
      max-width: 100%;
      object-fit: cover;
      aspect-ratio: 1;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-image .pc {
      display: block;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-image .mb {
      display: none;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      width: 100%;
      align-items: flex-start;
      gap: 8px;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-name {
      text-align: left;
      font-size: 20px;
      font-weight: 800;
      line-height: 1.4;
      min-height: 45px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      width: 100%;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-tips {
      color: #3D3D3D;
      font-size: 12px;
      font-weight: 400;
      line-height: 1.4;
      padding-top: 4px;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-save-badge {
      position: relative;
      width: 100%;
      max-width: 240px;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-save-badge-img {
      display: block;
      width: 100%;
      max-width: 100%;
      height: auto;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-save-badge-content {
      position: absolute;
      left: 50%;
      top: 52%;
      transform: translate(-50%, -50%);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      z-index: 2;
      color: #ff9900;
      line-height: 1;
      white-space: nowrap;
      pointer-events: none;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-save-badge-arrow {
      width: 20px;
      height: 22px;
      flex-shrink: 0;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-save-badge-arrow svg {
      display: block;
      width: 100%;
      height: 100%;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-save-badge-text {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-save-badge-unit {
      color: #ff9900;
      font-size: 14px;
      font-weight: 500;
      line-height: 1;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-save-badge-value {
      color: #ff9900;
      font-size: 18px;
      font-weight: 800;
      line-height: 1;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-content-bottom {
      display: flex;
      align-items: start;
      width: 100%;
      justify-content: space-between;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-price {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-sale-price {
      font-size: 24px;
      font-weight: 800;
      line-height: 1.3;
      color: #1E1E1E;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-original-price {
      color: #848484;
      font-size: 16px;
      font-weight: 400;
      line-height: 1.4;
      text-decoration-line: line-through;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-button-wrapper {
      display: flex;
      gap: 12px;
      width: 100%;
      padding-top: 12px;
      margin-top: auto;
      justify-content: space-between;
      {% if section.settings.product_num == '2' %}
        flex-direction: row;
      {% elsif section.settings.button_layout == '1' %}
        flex-direction: column;
      {% endif %}
    }

    .valentines-day-swiper-{{ section.id }} product-card,
    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-button-view-more {
      {% if section.settings.product_num == '2' or section.settings.button_layout == '2' %}
        width: calc(50% - 6px);
      {% else %}
        width: 100%;
      {% endif %}
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-button-add-to-cart,
    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-button-view-more {
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: #1E1E1E;
      font-size: 16px;
      font-weight: 700;
      line-height: 1;
      padding: 11px 5px;
      border-radius: 8px;
      min-height: 40px;
      height: 100%;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-button-add-to-cart {
      background: #E32F09;
      color: #fff;
    }
    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-button-stop-sale{

          color: #fff;
          cursor: not-allowed;

  background: #FF9900;
      }

    @media screen and (hover: hover) {
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-button-add-to-cart.button.accent:hover,
      .valentines-day-swiper-{{ section.id }} input[type=submit].accent:hover {
        background: #E32F09;;
        color: #fff;
      }
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-button-view-more {
      border: 1px solid #1E1E1E;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-button-add-to-cart:hover {
      background: #E32F09;
      color: #fff;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-button-view-more:hover {
      color: #1E1E1E;
      border: 1px solid #1E1E1E;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-navigation-buttons {
      display: flex;
      width: 100%;
      position: static;
      z-index: 1;
      justify-content: center;
      gap: 30px;
      align-items: center;
      padding-top: 48px;
    }

    @media screen and (max-width: 768px) {
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-navigation-buttons {
        padding-top: 24px;
      }
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-nav-button {
      cursor: pointer;
      width: 40px;
      height: 40px;
      flex-shrink: 0;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-nav-button.swiper-button-disabled svg circle {
      fill: #fff;
    }
    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-nav-button.swiper-button-disabled svg path {
      stroke: #FF9900;
    }

    .valentines-day-swiper-{{ section.id }} .swiper-scrollbar-drag {
      height: 100%;
      width: 100%;
      position: relative;
      background: #FF9900;
      border-radius: 99px;
      top: 0;
    }

    .valentines-day-swiper-{{ section.id }} .swiper-scrollbar {
      height: 4px;
      width: 191px;
      border-radius: 99px;
      background: #fff;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-products-swiper-container {
      display: none;
      position: static;
      overflow: hidden;
      {% if section.settings.section_max_width != 'none' %}

        {% else %}
          margin-left: calc(18.75% - 20px);
          margin-right: 0;
          padding-left: 20px;
        {% endif %}


    }
    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-grid-container{
        display: none;
    }

    .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-products-swiper-container.active {
      display: flex;
      flex-direction: column;
    }

    .valentines-day-swiper-{{ section.id }} .product-flash-sale-countdown {
      max-width: max-content;
      background: #FF9900;
      margin-bottom: 10px;
      color: #fff;
      padding: 0px 12px;
      border-radius: 17px;
    }

    .valentines-day-swiper-{{ section.id }} .product-flash-sale-countdown .countdown-box > div {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      font-size: 14px;
    }

    .valentines-day-swiper-{{ section.id }} .product-flash-sale-countdown .time-block {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-width: 52px;
      min-height: 56px;
      position: relative;
      {% comment %} border-radius: 6px;
      border: 1px dashed #FFF; {% endcomment %}
    }

    .valentines-day-swiper-{{ section.id }} .product-flash-sale-countdown .time-block:not(:last-child)::after {
      content: ":";
      position: absolute;
      right: -2px;
      top: 0px;
      font-size: 14px;
      font-weight: bold;
      color: #fff;
      line-height: 1;
    }

    .valentines-day-swiper-{{ section.id }} .product-flash-sale-countdown .time-value {
      /* background-color: #000; */
      color: #fff;
      border-radius: 0;
      font-size: 24px;
      line-height: 1;
      margin-bottom: 8px;
    }

    .valentines-day-swiper-{{ section.id }} .product-flash-sale-countdown .time-label {
      font-size: 12px;
      color: #fff;
      line-height: 1;
    }

    @media screen and (max-width: 1400px) {
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-title-wrapper {
        {% if section.settings.section_max_width != 'none' %}
          max-width: {{ section.settings.section_max_width | plus: 32 }}px;
          margin: 0 auto;
          padding: 0 16px;
          overflow: scroll;
          scrollbar-width: none;
        {% else %}
          width: 100%;
          max-width: 100%;
        {% endif %}
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-content {
        margin-left: 16px;
        margin-right: 16px;
      }
    }

    @media screen and (max-width: 768px) {
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-wrapper {
        padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px 0;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-content {
        margin-left: 0;
        margin-right: 0;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-container {
        max-width: 100%;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-title {
        font-size: 24px;
        margin-bottom: 10px;

      }

      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-title-wrapper {
        padding: 0;
      }

      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-label-container {
        left: -52px;
        position: relative;
        top: 9px;
        height: 30px;
      }

      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-label-container img {
        left: -25px;
        bottom: -2px;
      }

      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-grid-container .valentines-day-swiper-product-label-container {
        left: 0;
        top: 4px;
      }
      
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-save-badge-unit {
        font-size: 7px;
      }

      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-grid-container .valentines-day-swiper-product-label-container img {
        left: -43px;
        bottom: -11px;
      }

      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-subtitle {
        font-size: 14px;
        color: rgba(0, 0, 0, 0.80);
        margin-bottom: 20px;
          max-width: 280px;
          margin-left: auto;
          margin-right: auto;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-desc {
        font-size: 16px;
        line-height: 1.4;
        margin-bottom: 24px;
        padding: 0 38px;
      }

      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-save-badge-value {
        font-size: 10px;
      }

      .valentines-day-swiper-{{ section.id }} .exhibition-products-main-banner-box {
        {% if section.settings.section_max_width != 'none' %}
          max-width: {{ section.settings.section_max_width }}px;
        {% else %}
          width: 100%;
          max-width: 100%;
        {% endif %}
        margin-top: 12px;
        margin-bottom: 24px;
        padding: 0;
      }
      .valentines-day-swiper-{{ section.id }} .exhibition-products-main-banner-box .pc {
        display: none;
      }
      .valentines-day-swiper-{{ section.id }} .exhibition-products-main-banner-box .mb {
        display: flex;
      }
      {% comment %}
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-products {
        display: grid;
        grid-template-columns: repeat({{- section.settings.product_num_mobile | minus: 0 -}}, 1fr);
        grid-gap: {{ section.settings.card_gap_mobile }}px;
        padding: 0;
      }
      {% endcomment %}
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-products-card {
        padding: 12px 16px 16px 16px;
        border-radius: 10px;
        margin-left: 0;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-label-discount {}
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-label-discount-text {
        font-size: 12px;
        gap: 2px;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-label-discount-text-value {
        font-size: 14px;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-label-text span {
        display: block;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-image .pc {
        display: none;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-image .mb {
        display: block;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-content {
        width: 100%;
        gap: 8px;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-name {
        font-size: 16px;
        max-width: 100%;
        min-height: 45px;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-tips {
        font-size: 12px;
        line-height: 1.4;
        padding-top: 4px;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-price {
        gap: 10px;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-promotion-product-content-bottom {
        align-items: flex-start;
        gap: 8px;
      }
      .valentines-day-swiper-{{ section.id }} .valentines-day-swiper-product-save-badge {
        width: 100%;
        max-width: 120px;
        flex-shrink: 0;
      }

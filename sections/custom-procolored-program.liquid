<script>
  (() => {
    const sectionId = '{{ section.id }}';
    const selector = `#procolored-program-${sectionId} .infinite-scroll-swiper-container`;

    const initAvatarSwiper = () => {
      const swiperEl = document.querySelector(selector);

      if (!swiperEl || typeof Swiper === 'undefined') return;

      // Shopify 编辑器会重复渲染 section；已初始化时只更新，避免重复创建 Swiper 实例。
      if (swiperEl.swiper) {
        swiperEl.swiper.update();
        return;
      }

      new Swiper(swiperEl, {
        slidesPerView: 5.8,
        observer: true,
        observeParents: true,
        spaceBetween: 0,
        freeMode: true,
        breakpoints: {
          1024: {
            slidesPerView: 5.8,
          },
          768: {
            slidesPerView: 5.2,
          },
        },
      });
    };

    initAvatarSwiper();

    document.addEventListener('DOMContentLoaded', initAvatarSwiper);

    // 支持 Shopify Theme Editor 中 section 重新加载后自动恢复头像 Swiper。
    document.addEventListener('shopify:section:load', (event) => {
      if (event.detail && event.detail.sectionId === sectionId) {
        initAvatarSwiper();
      }
    });
  })();
</script>


<div id="{{ section_dom_id }}" class="procolored-program-section">
  <div class="procolored-program">
    {% if section.settings.show_hero %}
      <div class="user-avatars-wrapper">
        <div class="user-avatars-container">
          <div class="user-avatars">
            <div class="infinite-scroll-swiper-container">
              <div class="swiper-wrapper">
                {% for block in section.blocks %}
                  {% if block.type == 'avatar_item' %}
                    {% liquid
                      assign avatar_url = block.settings.avatar_url
                      if block.settings.avatar_image != blank
                        assign avatar_url = block.settings.avatar_image | image_url: width: 120
                      endif
                    %}
                    {% if avatar_url != blank %}
                      <div class="swiper-slide" {{ block.shopify_attributes }}>
                        <img src="{{ avatar_url }}" alt="{{ block.settings.alt | escape }}" width="43" height="43">
                      </div>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>

          <div class="user-avatars-text">
            <span>{{ section.settings.hero_count | escape }}</span>
            <span>{{ section.settings.hero_count_label | escape }}</span>
          </div>
        </div>

        {% if section.settings.hero_title != blank %}
          <h1>{{ section.settings.hero_title | escape }}</h1>
        {% endif %}

        {% if section.settings.hero_subtitle != blank %}
          <p class="subtitle">{{ section.settings.hero_subtitle | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.show_community %}
      <section class="community-inspiration">
        {% if section.settings.community_heading != blank %}
          <h2>{{ section.settings.community_heading | escape }}</h2>
        {% endif %}

        {% for block in section.blocks %}
          {% if block.type == 'community_card' %}
            {% liquid
              assign desktop_image = block.settings.desktop_image_url
              if block.settings.desktop_image != blank
                assign desktop_image = block.settings.desktop_image | image_url: width: 1600
              endif

              assign mobile_image = block.settings.mobile_image_url
              if block.settings.mobile_image != blank
                assign mobile_image = block.settings.mobile_image | image_url: width: 900
              endif

              if mobile_image == blank
                assign mobile_image = desktop_image
              endif

              assign card_link = block.settings.link_url | default: '#'
            %}

            <div
              class="card{% if block.settings.desktop_image_position == 'right' %} is-image-right{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="card-img">
                {% if desktop_image != blank %}
                  <img
                    class="desktop-show lazyload"
                    src="data:image/gif;base64,R0lGODlhAQABAAAAACw="
                    data-src="{{ desktop_image }}"
                    alt="{{ block.settings.alt | escape }}"
                  >
                {% endif %}

                {% if mobile_image != blank %}
                  <img
                    class="mobile-show lazyload"
                    src="data:image/gif;base64,R0lGODlhAQABAAAAACw="
                    data-src="{{ mobile_image }}"
                    alt="{{ block.settings.alt | escape }}"
                  >
                {% endif %}
              </div>

              <div class="card-content">
                {% if block.settings.title != blank %}
                  <h3>{{ block.settings.title | escape }}</h3>
                {% endif %}

                {% if block.settings.description != blank %}
                  <p>{{ block.settings.description | escape | newline_to_br }}</p>
                {% endif %}

                {% if block.settings.button_label != blank %}
                  <a href="{{ card_link }}" class="learn-more">{{ block.settings.button_label | escape }}</a>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </section>
    {% endif %}

    {% if section.settings.show_business %}
      <section class="business-partnerships">
        {% if section.settings.business_heading != blank %}
          <h2>{{ section.settings.business_heading | escape }}</h2>
        {% endif %}

        <div class="partnership-grid">
          {% for block in section.blocks %}
            {% if block.type == 'partnership_card' %}
              {% liquid
                assign desktop_image = block.settings.desktop_image_url
                if block.settings.desktop_image != blank
                  assign desktop_image = block.settings.desktop_image | image_url: width: 1400
                endif

                assign mobile_image = block.settings.mobile_image_url
                if block.settings.mobile_image != blank
                  assign mobile_image = block.settings.mobile_image | image_url: width: 900
                endif

                if mobile_image == blank
                  assign mobile_image = desktop_image
                endif

                assign card_link = block.settings.link_url | default: '#'
              %}

              <a class="partnership-card" href="{{ card_link }}" {{ block.shopify_attributes }}>
                <div class="partnership-card-img">
                  {% if desktop_image != blank %}
                    <img
                      class="desktop-show lazyload"
                      src="data:image/gif;base64,R0lGODlhAQABAAAAACw="
                      data-src="{{ desktop_image }}"
                      alt="{{ block.settings.alt | escape }}"
                    >
                  {% endif %}

                  {% if mobile_image != blank %}
                    <img
                      class="mobile-show lazyload"
                      src="data:image/gif;base64,R0lGODlhAQABAAAAACw="
                      data-src="{{ mobile_image }}"
                      alt="{{ block.settings.alt | escape }}"
                    >
                  {% endif %}
                </div>

                <div class="partnership-card-content">
                  {% if block.settings.show_icon %}
                    <div class="partnership-card-img-svg">
                      {% if block.settings.custom_icon_svg != blank %}
                        {{ block.settings.custom_icon_svg }}
                      {% else %}
                        {% case block.settings.icon_style %}
                          {% when 'engineer' %}
                            <svg viewBox="0 0 56 56" fill="none" aria-hidden="true">
                              <path d="M28 7c-8.1 0-14.8 6.6-14.8 14.8v1.7h29.6v-1.7C42.8 13.6 36.1 7 28 7Z" fill="currentColor"/>
                              <path d="M14 26h28c-.9 7-6.8 12.5-14 12.5S14.9 33 14 26Z" fill="currentColor"/>
                              <path d="M44 34a8 8 0 1 1 0 16 8 8 0 0 1 0-16Zm0 3.4a1.2 1.2 0 0 0-1.2 1.2v2.2h-2.2a1.2 1.2 0 1 0 0 2.4h2.2v2.2a1.2 1.2 0 1 0 2.4 0v-2.2h2.2a1.2 1.2 0 1 0 0-2.4h-2.2v-2.2a1.2 1.2 0 0 0-1.2-1.2Z" fill="currentColor"/>
                            </svg>
                          {% when 'affiliate' %}
                            <svg viewBox="0 0 56 56" fill="none" aria-hidden="true">
                              <path d="M24 26a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z" fill="currentColor"/>
                              <path d="M7 49c1.5-11 8.3-18 17-18 3.5 0 6.6 1.1 9.2 3.1A11 11 0 0 0 39 51c-4.5.8-9.8 1.2-15 1.2-6.7 0-12.8-1-17-3.2Z" fill="currentColor"/>
                              <path d="M42 34.2c3.2 0 5.8 2.5 5.8 5.7 0 4.8-5.8 8.3-5.8 8.3s-5.8-3.5-5.8-8.3c0-3.2 2.6-5.7 5.8-5.7Zm0 3.1a2.6 2.6 0 1 0 0 5.2 2.6 2.6 0 0 0 0-5.2Z" fill="currentColor"/>
                            </svg>
                          {% when 'distributor' %}
                            <svg viewBox="0 0 56 56" fill="none" aria-hidden="true">
                              <path d="M24 26a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z" fill="currentColor"/>
                              <path d="M8 49c1.6-10.5 8.2-17.4 16.5-17.4 2.6 0 5 .7 7.2 2l-3 10.8a4 4 0 0 0 .9 3.8l2.6 2.6c-2.4.4-5 .6-7.7.6-6.6 0-12.3-.9-16.5-2.4Z" fill="currentColor"/>
                              <path d="M42 34a8 8 0 1 1 0 16 8 8 0 0 1 0-16Zm0 3.4a1.2 1.2 0 0 0-1.2 1.2v2.2h-2.2a1.2 1.2 0 1 0 0 2.4h2.2v2.2a1.2 1.2 0 1 0 2.4 0v-2.2h2.2a1.2 1.2 0 1 0 0-2.4h-2.2v-2.2a1.2 1.2 0 0 0-1.2-1.2Z" fill="currentColor"/>
                            </svg>
                          {% else %}
                            <svg viewBox="0 0 56 56" fill="none" aria-hidden="true">
                              <path d="M12 30.2 22.3 34c3.8 1.4 8 1.3 11.7-.4l7.4-3.4a3 3 0 0 1 3.9 1.2 3 3 0 0 1-1 4L35 41.7a12 12 0 0 1-9.6 1.5L12 39.4v-9.2Z" fill="currentColor"/>
                              <path d="M8 27h6l2.5 16H8V27Z" fill="currentColor"/>
                              <path d="M33 5a11 11 0 1 1 0 22 11 11 0 0 1 0-22Zm1.5 4h-3v2.1a5 5 0 0 0-3.6 4.6c0 3 2.5 4 4.6 4.6 1.8.5 2.5.8 2.5 1.8 0 .9-.8 1.5-2 1.5-1.5 0-2.5-.8-2.8-2.2l-3 .8c.4 2.2 1.9 3.8 4.3 4.3V29h3v-2.5a5 5 0 0 0 3.7-4.8c0-3-2.4-4.1-4.8-4.8-1.5-.5-2.2-.8-2.2-1.6 0-.8.6-1.4 1.7-1.4 1.1 0 1.8.6 2.2 1.6l2.8-1.1c-.5-1.8-1.6-3-3.4-3.5V9Z" fill="currentColor"/>
                            </svg>
                        {% endcase %}
                      {% endif %}
                    </div>
                  {% endif %}

                  {% if block.settings.title != blank %}
                    <h3>{{ block.settings.title | escape }}</h3>
                  {% endif %}

                  {% if block.settings.description != blank %}
                    <p>{{ block.settings.description | escape | newline_to_br }}</p>
                  {% endif %}

                  {% if block.settings.button_label != blank %}
                    <div class="learn-more">{{ block.settings.button_label | escape }}</div>
                  {% endif %}
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if section.settings.show_financing %}
      <section class="financing">
        {% if section.settings.financing_heading != blank %}
          <h2>{{ section.settings.financing_heading | escape }}</h2>

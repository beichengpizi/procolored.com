                    "min": 1,
                    "max": 10,
                    "default": 1,
                    "step": 1
                },
                {
                    "type": "range",
                    "id": "mobile_column",
                    "label": "Mobile column",
                    "min": 1,
                    "max": 10,
                    "default": 1,
                    "step": 1
                },
                {
                    "type": "range",
                    "id": "row",
                    "label": "Row",
                    "min": 1,
                    "max": 10,
                    "default": 1,
                    "step": 1
                },
                {
                    "type": "range",
                    "id": "mobile_row",
                    "label": "Mobile row",
                    "min": 1,
                    "max": 10,
                    "default": 1,
                    "step": 1
                },
                {
                    "type": "range",
                    "id": "mobile_order",
                    "label": "Mobile order",
                    "min": 1,
                    "max": 10,
                    "default": 1,
                    "step": 1
                },
            ]
        },
        {
            "type": "icon",
            "name": "Icon",
            "settings": [
                {
                    "type": "liquid",
                    "id": "icon",
                    "label": "Icon"
                },
                {
                    "type": "text",
                    "id": "title",
                    "label": "Title"
                },
                {
                    "type": "text",
                    "id": "text",
                    "label": "Text"
                },
                {
                    "type": "range",
                    "id": "column",
                    "label": "Column",
                    "min": 1,
                    "max": 10,
                    "default": 1,
                    "step": 1
                },
                {
                    "type": "range",
                    "id": "mobile_column",
                    "label": "Mobile column",
                    "min": 1,
                    "max": 10,
                    "default": 1,
                    "step": 1
                },
                {
                    "type": "range",
                    "id": "row",
                    "label": "Row",
                    "min": 1,
                    "max": 10,
                    "default": 1,
                    "step": 1
                },
                {
                    "type": "range",
                    "id": "mobile_row",
                    "label": "Mobile row",
                    "min": 1,
                    "max": 10,
                    "default": 1,
                    "step": 1
                },
                {
                    "type": "range",
                    "id": "mobile_order",
                    "label": "Mobile order",
                    "min": 1,
                    "max": 10,
                    "default": 1,
                    "step": 1
                },
            ]
        }
    ],
    "presets": [
      {
        "name": "Custom grid",
        "settings": {
        }
      }
    ]
  }
{% endschema %}
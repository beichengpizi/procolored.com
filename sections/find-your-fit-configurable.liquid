<script>
  (() => {
    const section = document.getElementById('find-fit-{{ section.id }}');
    if (!section) return;

    const dataNode = section.querySelector('[data-find-fit-data]');
    const tabNavContainer = section.querySelector('[data-find-fit-tabs]');
    const contentTitle = section.querySelector('[data-find-fit-content-title]');
    const contentDesc = section.querySelector('[data-find-fit-content-desc]');
    const contentBtn = section.querySelector('[data-find-fit-content-btn]');
    const mediaContainer = section.querySelector('[data-find-fit-media-container]');

    if (!dataNode || !tabNavContainer || !contentTitle || !contentDesc || !contentBtn || !mediaContainer) return;

    let tabData = [];

    try {
      tabData = JSON.parse(dataNode.textContent || '[]');
    } catch (error) {
      console.warn('Find Your Fit: invalid section data.', error);
      return;
    }

    if (!Array.isArray(tabData) || !tabData.length) return;

    const mobileQuery = window.matchMedia('(max-width: 768px)');
    const mediaCache = new Map();
    let currentTabId = tabData[0].id;
    let currentMediaKey = '';
    let mediaLoadToken = 0;

    const cleanHtml = (value) => (typeof value === 'string' ? value : '');
    const isMobile = () => mobileQuery.matches;

    const getResponsiveValue = (data, baseKey) => {
      const pcValue = cleanHtml(data[`${baseKey}Pc`]);
      const mobileValue = cleanHtml(data[`${baseKey}Mobile`]);
      return isMobile() && mobileValue.trim() ? mobileValue : pcValue;
    };

    const getResponsiveMedia = (data) => {
      const useMobile = isMobile();
      const mediaType = data.mediaType === 'video' ? 'video' : 'image';

      if (mediaType === 'video') {
        const mobileUrl = cleanHtml(data.videoMobile);
        const pcUrl = cleanHtml(data.videoPc);
        return {
          type: 'video',
          url: useMobile && mobileUrl ? mobileUrl : pcUrl,
          width: useMobile && Number(data.videoMobileWidth) ? Number(data.videoMobileWidth) : Number(data.videoPcWidth) || 0,
          height: useMobile && Number(data.videoMobileHeight) ? Number(data.videoMobileHeight) : Number(data.videoPcHeight) || 0,
          poster: useMobile && cleanHtml(data.posterMobile) ? cleanHtml(data.posterMobile) : cleanHtml(data.posterPc),
          objectFit: data.objectFit || 'cover'
        };
      }

      const mobileUrl = cleanHtml(data.imageMobile);
      const pcUrl = cleanHtml(data.imagePc);
      return {
        type: 'image',
        url: useMobile && mobileUrl ? mobileUrl : pcUrl,
        width: useMobile && Number(data.imageMobileWidth) ? Number(data.imageMobileWidth) : Number(data.imagePcWidth) || 0,
        height: useMobile && Number(data.imageMobileHeight) ? Number(data.imageMobileHeight) : Number(data.imagePcHeight) || 0,
        poster: '',
        objectFit: data.objectFit || 'cover'
      };
    };

    const getMediaKey = (data) => {
      const media = getResponsiveMedia(data);
      return `${media.type}::${media.url}`;
    };

    const setMediaAspectRatio = (width, height) => {
      const safeWidth = Number(width) || 0;
      const safeHeight = Number(height) || 0;
      if (safeWidth <= 0 || safeHeight <= 0) return;
      mediaContainer.style.setProperty('--media-aspect-ratio', `${safeWidth} / ${safeHeight}`);
    };

    const pauseHiddenVideo = (element) => {
      if (element && element.tagName === 'VIDEO') {
        element.pause();
      }
    };

    const playVisibleVideo = (element) => {
      if (element && element.tagName === 'VIDEO') {
        element.currentTime = element.currentTime || 0;
        element.play().catch(() => {});
      }
    };

    const showMediaElement = (targetElement) => {
      mediaContainer.querySelectorAll('.find-fit__media-element').forEach((element) => {
        const isTarget = element === targetElement;
        element.classList.toggle('is-visible', isTarget);

        if (isTarget) {
          mediaContainer.style.setProperty('--media-object-fit', element.dataset.objectFit || 'cover');
          playVisibleVideo(element);
        } else {
          pauseHiddenVideo(element);
        }
      });
    };

    const createImageElement = (data, media) => {
      const image = document.createElement('img');
      image.className = 'find-fit__media-element';
      image.alt = cleanHtml(data.alt) || cleanHtml(getResponsiveValue(data, 'title')).replace(/<[^>]*>/g, '');
      image.decoding = 'async';
      image.loading = 'eager';
      image.dataset.objectFit = media.objectFit;
      image.src = media.url;
      return image;
    };

    const createVideoElement = (data, media) => {
      const video = document.createElement('video');
      video.className = 'find-fit__media-element';
      video.src = media.url;
      video.autoplay = true;
      video.loop = true;
      video.muted = true;
      video.playsInline = true;
      video.preload = 'auto';
      video.dataset.objectFit = media.objectFit;
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');
      video.setAttribute('aria-label', cleanHtml(data.alt) || cleanHtml(getResponsiveValue(data, 'title')).replace(/<[^>]*>/g, ''));

      if (media.poster) {
        video.poster = media.poster;
      }

      return video;
    };

    const cacheAndRevealMedia = (key, element, width, height, token) => {
      if (token !== mediaLoadToken || key !== currentMediaKey) return;

      setMediaAspectRatio(width, height);
      element.dataset.mediaWidth = String(width || 16);
      element.dataset.mediaHeight = String(height || 11);
      mediaCache.set(key, element);
      showMediaElement(element);
    };

    const loadImageWithoutBlank = (data, media, key, token) => {
      if (!media.url) return;

      const image = createImageElement(data, media);
      mediaContainer.appendChild(image);

      const reveal = () => {
        const width = image.naturalWidth || media.width || 16;
        const height = image.naturalHeight || media.height || 11;
        const finish = () => cacheAndRevealMedia(key, image, width, height, token);

        if (typeof image.decode === 'function') {
          image.decode().then(finish).catch(finish);
        } else {
          finish();
        }
      };

      image.onload = reveal;
      image.onerror = () => {
        if (token !== mediaLoadToken || key !== currentMediaKey) return;
        image.remove();
        setMediaAspectRatio(16, 11);
      };

      if (media.width && media.height) {
        setMediaAspectRatio(media.width, media.height);
      }

      if (image.complete && image.naturalWidth && image.naturalHeight) {
        reveal();
      }
    };

    const loadVideoWithoutBlank = (data, media, key, token) => {
      if (!media.url) return;

      const video = createVideoElement(data, media);
      mediaContainer.appendChild(video);

      const reveal = () => {
        const width = video.videoWidth || media.width || 16;
        const height = video.videoHeight || media.height || 11;
        cacheAndRevealMedia(key, video, width, height, token);
      };

      video.onloadeddata = reveal;
      video.oncanplay = reveal;
      video.onerror = () => {
        if (token !== mediaLoadToken || key !== currentMediaKey) return;
        video.remove();
        setMediaAspectRatio(16, 11);
      };

      if (media.width && media.height) {
        setMediaAspectRatio(media.width, media.height);
      }

      video.load();

      if (video.readyState >= 2 && video.videoWidth && video.videoHeight) {
        reveal();
      }
    };

    const updateMediaWithoutBlank = (data) => {
      const media = getResponsiveMedia(data);
      const key = getMediaKey(data);
      const token = ++mediaLoadToken;
      currentMediaKey = key;

      const cachedElement = mediaCache.get(key);
      if (cachedElement) {
        setMediaAspectRatio(
          Number(cachedElement.dataset.mediaWidth) || media.width || 16,
          Number(cachedElement.dataset.mediaHeight) || media.height || 11
        );
        showMediaElement(cachedElement);
        return;
      }

      if (media.width && media.height) {
        setMediaAspectRatio(media.width, media.height);
      }

      if (media.type === 'video') {
        loadVideoWithoutBlank(data, media, key, token);
        return;
      }

      loadImageWithoutBlank(data, media, key, token);
    };

    const scrollToCenter = (btn) => {
      const containerWidth = tabNavContainer.clientWidth;
      const btnOffsetLeft = btn.offsetLeft;
      const btnWidth = btn.clientWidth;
      const scrollPosition = btnOffsetLeft - (containerWidth / 2) + (btnWidth / 2);

      tabNavContainer.scrollTo({
        left: scrollPosition,
        behavior: 'smooth'
      });
    };

    const updateDOMContent = (data) => {
      contentTitle.innerHTML = getResponsiveValue(data, 'title');
      contentDesc.innerHTML = getResponsiveValue(data, 'desc');
      contentBtn.innerHTML = getResponsiveValue(data, 'buttonText');
      contentBtn.href = cleanHtml(data.buttonLink) || '#';

      if (data.buttonNewTab) {
        contentBtn.target = '_blank';
        contentBtn.rel = 'noopener noreferrer';
      } else {
        contentBtn.removeAttribute('target');
        contentBtn.removeAttribute('rel');
      }

      const hasButtonText = Boolean(contentBtn.textContent.trim());
      contentBtn.style.display = hasButtonText ? 'inline-flex' : 'none';

      updateMediaWithoutBlank(data);
    };

    const syncTabLabels = () => {
      tabNavContainer.querySelectorAll('.find-fit__tab').forEach((btn) => {
        const data = tabData.find((item) => item.id === btn.dataset.id);
        if (!data) return;
        btn.innerHTML = getResponsiveValue(data, 'label');
      });
    };

    const handleTabClick = (id, targetBtn) => {
      if (id === currentTabId) return;

      const newData = tabData.find((item) => item.id === id);
      if (!newData) return;

      currentTabId = id;

      tabNavContainer.querySelectorAll('.find-fit__tab').forEach((btn) => {
        const isActive = btn.dataset.id === id;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        btn.tabIndex = isActive ? 0 : -1;
      });

      scrollToCenter(targetBtn);
      updateDOMContent(newData);
    };

    const renderTabs = () => {
      tabNavContainer.innerHTML = '';

      tabData.forEach((tab, index) => {
        const btn = document.createElement('button');
        const isActive = tab.id === currentTabId;

        btn.className = `find-fit__tab${isActive ? ' is-active' : ''}`;
        btn.innerHTML = getResponsiveValue(tab, 'label');
        btn.type = 'button';
        btn.dataset.id = tab.id;
        btn.setAttribute('role', 'tab');
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        btn.tabIndex = isActive ? 0 : -1;

        btn.addEventListener('click', (event) => handleTabClick(tab.id, event.currentTarget));
        btn.addEventListener('keydown', (event) => {
          const buttons = Array.from(tabNavContainer.querySelectorAll('.find-fit__tab'));
          const currentIndex = buttons.indexOf(event.currentTarget);
          let nextIndex = currentIndex;

          if (event.key === 'ArrowRight') nextIndex = Math.min(currentIndex + 1, buttons.length - 1);
          if (event.key === 'ArrowLeft') nextIndex = Math.max(currentIndex - 1, 0);
          if (event.key === 'Home') nextIndex = 0;
          if (event.key === 'End') nextIndex = buttons.length - 1;

          if (nextIndex !== currentIndex) {
            event.preventDefault();
            buttons[nextIndex].focus();
            buttons[nextIndex].click();
          }
        });

        tabNavContainer.appendChild(btn);

        if (index === 0) {
          currentTabId = tab.id;
        }
      });

      updateDOMContent(tabData.find((item) => item.id === currentTabId) || tabData[0]);
    };

    const refreshResponsiveContent = () => {
      syncTabLabels();
      const activeData = tabData.find((item) => item.id === currentTabId) || tabData[0];
      updateDOMContent(activeData);

      const activeBtn = tabNavContainer.querySelector('.find-fit__tab.is-active');
      if (activeBtn) scrollToCenter(activeBtn);
    };

    renderTabs();

    if (typeof mobileQuery.addEventListener === 'function') {
      mobileQuery.addEventListener('change', refreshResponsiveContent);
    } else if (typeof mobileQuery.addListener === 'function') {
      mobileQuery.addListener(refreshResponsiveContent);
    }

    document.addEventListener('shopify:section:load', (event) => {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        refreshResponsiveContent();
      }
    });
  })();
</script>


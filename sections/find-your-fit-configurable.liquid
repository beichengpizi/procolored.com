      margin-bottom: clamp(calc({{ section.settings.content_title_margin_bottom_mobile }}px * 0.85), calc(100vw * {{ section.settings.content_title_margin_bottom_mobile }} / 375), calc({{ section.settings.content_title_margin_bottom_mobile }}px * 1.15));

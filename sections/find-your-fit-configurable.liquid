{% liquid
  assign section_heading_html_pc = section.settings.heading_html_pc
  assign section_heading_html_mobile = section.settings.heading_html_mobile
  if section_heading_html_mobile == blank
    assign section_heading_html_mobile = section_heading_html_pc
  endif

  assign section_subtitle_html_pc = section.settings.subtitle_html_pc
  assign section_subtitle_html_mobile = section.settings.subtitle_html_mobile
  if section_subtitle_html_mobile == blank
    assign section_subtitle_html_mobile = section_subtitle_html_pc
  endif
%}

<section
  id="find-fit-{{ section.id }}"
  class="find-fit find-fit-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="find-fit__container">
    <div class="find-fit__header">
      {% if section_heading_html_pc != blank %}
        <div class="find-fit__title">
          <div class="find-fit__html find-fit__html--pc">{{ section_heading_html_pc }}</div>
          <div class="find-fit__html find-fit__html--mobile">{{ section_heading_html_mobile }}</div>
        </div>
      {% endif %}

      {% if section_subtitle_html_pc != blank %}
        <div class="find-fit__subtitle">
          <div class="find-fit__html find-fit__html--pc">{{ section_subtitle_html_pc }}</div>
          <div class="find-fit__html find-fit__html--mobile">{{ section_subtitle_html_mobile }}</div>
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="find-fit__tabs-wrapper">
        <div class="find-fit__tabs" data-find-fit-tabs role="tablist" aria-label="{{ section.settings.tabs_aria_label | escape }}"></div>
      </div>

      <div class="find-fit__content-wrapper">
        <div class="find-fit__content" data-find-fit-content>
          <div class="find-fit__text-side">
            <div class="find-fit__content-title" data-find-fit-content-title></div>
            <div class="find-fit__content-desc" data-find-fit-content-desc></div>
            <a href="#" class="find-fit__btn" data-find-fit-content-btn></a>
          </div>

          <div class="find-fit__media-side" data-find-fit-media-container aria-live="polite"></div>
        </div>
      </div>

      <script type="application/json" data-find-fit-data>
        [
          {%- for block in section.blocks -%}
            {%- liquid
              assign image_pc_url = block.settings.external_image_pc
              assign image_pc_width = 0
              assign image_pc_height = 0
              if block.settings.image_pc != blank
                assign image_pc_url = block.settings.image_pc | image_url: width: 2400
                assign image_pc_width = block.settings.image_pc.width
                assign image_pc_height = block.settings.image_pc.height
              endif

              assign image_mobile_url = block.settings.external_image_mobile
              assign image_mobile_width = 0
              assign image_mobile_height = 0
              if block.settings.image_mobile != blank
                assign image_mobile_url = block.settings.image_mobile | image_url: width: 1200
                assign image_mobile_width = block.settings.image_mobile.width
                assign image_mobile_height = block.settings.image_mobile.height
              endif
              if image_mobile_url == blank
                assign image_mobile_url = image_pc_url
                assign image_mobile_width = image_pc_width
                assign image_mobile_height = image_pc_height
              endif

              assign video_pc_url = block.settings.external_video_pc
              assign video_pc_width = 0
              assign video_pc_height = 0
              if block.settings.video_pc != blank
                assign video_pc_mp4 = block.settings.video_pc.sources | where: 'format', 'mp4' | first
                if video_pc_mp4 != blank
                  assign video_pc_url = video_pc_mp4.url
                  assign video_pc_width = video_pc_mp4.width
                  assign video_pc_height = video_pc_mp4.height
                endif
              endif

              assign video_mobile_url = block.settings.external_video_mobile
              assign video_mobile_width = 0
              assign video_mobile_height = 0
              if block.settings.video_mobile != blank
                assign video_mobile_mp4 = block.settings.video_mobile.sources | where: 'format', 'mp4' | first
                if video_mobile_mp4 != blank
                  assign video_mobile_url = video_mobile_mp4.url
                  assign video_mobile_width = video_mobile_mp4.width
                  assign video_mobile_height = video_mobile_mp4.height
                endif
              endif
              if video_mobile_url == blank
                assign video_mobile_url = video_pc_url
                assign video_mobile_width = video_pc_width
                assign video_mobile_height = video_pc_height
              endif

              assign poster_pc_url = block.settings.external_poster_pc
              if block.settings.poster_pc != blank
                assign poster_pc_url = block.settings.poster_pc | image_url: width: 1800
              endif

              assign poster_mobile_url = block.settings.external_poster_mobile
              if block.settings.poster_mobile != blank
                assign poster_mobile_url = block.settings.poster_mobile | image_url: width: 900
              endif
              if poster_mobile_url == blank
                assign poster_mobile_url = poster_pc_url
              endif

              assign button_link = block.settings.button_link
              if button_link == blank
                assign button_link = '#'
              endif
            -%}
            {
              "id": {{ block.id | json }},
              "labelPc": {{ block.settings.tab_label_html_pc | json }},
              "labelMobile": {{ block.settings.tab_label_html_mobile | json }},
              "titlePc": {{ block.settings.content_title_html_pc | json }},
              "titleMobile": {{ block.settings.content_title_html_mobile | json }},
              "descPc": {{ block.settings.content_desc_html_pc | json }},
              "descMobile": {{ block.settings.content_desc_html_mobile | json }},
              "buttonTextPc": {{ block.settings.button_label_html_pc | json }},
              "buttonTextMobile": {{ block.settings.button_label_html_mobile | json }},
              "buttonLink": {{ button_link | json }},
              "buttonNewTab": {{ block.settings.button_new_tab | json }},
              "mediaType": {{ block.settings.media_type | json }},
              "objectFit": {{ block.settings.media_object_fit | json }},
              "alt": {{ block.settings.media_alt_text | json }},
              "imagePc": {{ image_pc_url | default: '' | json }},
              "imagePcWidth": {{ image_pc_width | default: 0 | json }},
              "imagePcHeight": {{ image_pc_height | default: 0 | json }},
              "imageMobile": {{ image_mobile_url | default: '' | json }},
              "imageMobileWidth": {{ image_mobile_width | default: 0 | json }},
              "imageMobileHeight": {{ image_mobile_height | default: 0 | json }},
              "videoPc": {{ video_pc_url | default: '' | json }},
              "videoPcWidth": {{ video_pc_width | default: 0 | json }},
              "videoPcHeight": {{ video_pc_height | default: 0 | json }},
              "videoMobile": {{ video_mobile_url | default: '' | json }},
              "videoMobileWidth": {{ video_mobile_width | default: 0 | json }},
              "videoMobileHeight": {{ video_mobile_height | default: 0 | json }},
              "posterPc": {{ poster_pc_url | default: '' | json }},
              "posterMobile": {{ poster_mobile_url | default: '' | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      </script>
    {% endif %}
  </div>
</section>

<style>
  .find-fit-{{ section.id }},
  .find-fit-{{ section.id }} * {
    box-sizing: border-box;
  }

  .find-fit-{{ section.id }} {
    width: 100%;
    background: {{ section.settings.section_background }};
    padding-top: clamp(calc({{ section.settings.section_padding_top_pc }}px * 0.667), calc(100vw * {{ section.settings.section_padding_top_pc }} / 1920), calc({{ section.settings.section_padding_top_pc }}px * 2));
    padding-bottom: clamp(calc({{ section.settings.section_padding_bottom_pc }}px * 0.667), calc(100vw * {{ section.settings.section_padding_bottom_pc }} / 1920), calc({{ section.settings.section_padding_bottom_pc }}px * 2));
  }

  .find-fit-{{ section.id }} button {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font: inherit;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  .find-fit-{{ section.id }} a {
    color: inherit;
    text-decoration: none;
  }

  .find-fit-{{ section.id }} .find-fit__container {
    max-width: clamp(calc({{ section.settings.container_max_width_pc }}px * 0.667), calc(100vw * {{ section.settings.container_max_width_pc }} / 1920), calc({{ section.settings.container_max_width_pc }}px * 2));
    margin: 0 auto;
    padding-left: clamp(calc({{ section.settings.container_padding_inline_pc }}px * 0.667), calc(100vw * {{ section.settings.container_padding_inline_pc }} / 1920), calc({{ section.settings.container_padding_inline_pc }}px * 2));
    padding-right: clamp(calc({{ section.settings.container_padding_inline_pc }}px * 0.667), calc(100vw * {{ section.settings.container_padding_inline_pc }} / 1920), calc({{ section.settings.container_padding_inline_pc }}px * 2));
  }

  .find-fit-{{ section.id }} .find-fit__header {
    text-align: center;
    margin-bottom: clamp(calc({{ section.settings.header_margin_bottom_pc }}px * 0.667), calc(100vw * {{ section.settings.header_margin_bottom_pc }} / 1920), calc({{ section.settings.header_margin_bottom_pc }}px * 2));
  }

  .find-fit-{{ section.id }} .find-fit__html--mobile {
    display: none;
  }

  .find-fit-{{ section.id }} .find-fit__title {
    color: {{ section.settings.heading_color }};
    text-align: center;
    font-size: clamp(calc({{ section.settings.heading_font_size_pc }}px * 0.667), calc(100vw * {{ section.settings.heading_font_size_pc }} / 1920), calc({{ section.settings.heading_font_size_pc }}px * 2));
    font-weight: {{ section.settings.heading_font_weight }};
    line-height: {{ section.settings.heading_line_height }};
    margin-bottom: clamp(calc({{ section.settings.heading_margin_bottom_pc }}px * 0.667), calc(100vw * {{ section.settings.heading_margin_bottom_pc }} / 1920), calc({{ section.settings.heading_margin_bottom_pc }}px * 2));
  }

  .find-fit-{{ section.id }} .find-fit__title p,
  .find-fit-{{ section.id }} .find-fit__subtitle p,
  .find-fit-{{ section.id }} .find-fit__content-title p,
  .find-fit-{{ section.id }} .find-fit__content-desc p {
    margin: 0;
  }

  .find-fit-{{ section.id }} .find-fit__subtitle {
    color: {{ section.settings.subtitle_color }};
    text-align: center;
    font-size: clamp(calc({{ section.settings.subtitle_font_size_pc }}px * 0.667), calc(100vw * {{ section.settings.subtitle_font_size_pc }} / 1920), calc({{ section.settings.subtitle_font_size_pc }}px * 2));
    font-weight: {{ section.settings.subtitle_font_weight }};
    line-height: {{ section.settings.subtitle_line_height }};
  }

  .find-fit-{{ section.id }} .find-fit__tabs-wrapper {
    width: max-content;
    max-width: 100%;
    border-bottom: 1px solid {{ section.settings.tabs_border_color }};
    margin-bottom: clamp(calc({{ section.settings.tabs_margin_bottom_pc }}px * 0.667), calc(100vw * {{ section.settings.tabs_margin_bottom_pc }} / 1920), calc({{ section.settings.tabs_margin_bottom_pc }}px * 2));
    display: flex;
    justify-content: center;
    margin-left: auto;
    margin-right: auto;
  }

  .find-fit-{{ section.id }} .find-fit__tabs {
    display: flex;
    gap: clamp(calc({{ section.settings.tabs_gap_pc }}px * 0.667), calc(100vw * {{ section.settings.tabs_gap_pc }} / 1920), calc({{ section.settings.tabs_gap_pc }}px * 2));
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    white-space: nowrap;
    position: relative;
    scroll-behavior: auto;
  }

  .find-fit-{{ section.id }} .find-fit__tabs::-webkit-scrollbar {
    display: none;
  }

  .find-fit-{{ section.id }} .find-fit__tab {
    padding-bottom: clamp(calc({{ section.settings.tab_padding_bottom_pc }}px * 0.667), calc(100vw * {{ section.settings.tab_padding_bottom_pc }} / 1920), calc({{ section.settings.tab_padding_bottom_pc }}px * 2));
    color: {{ section.settings.tab_text_color }};
    font-size: clamp(calc({{ section.settings.tab_font_size_pc }}px * 0.667), calc(100vw * {{ section.settings.tab_font_size_pc }} / 1920), calc({{ section.settings.tab_font_size_pc }}px * 2));
    font-weight: {{ section.settings.tab_font_weight }};
    line-height: {{ section.settings.tab_line_height }};
    position: relative;
    flex-shrink: 0;
    transition: color 0.3s ease;
  }

  .find-fit-{{ section.id }} .find-fit__tab::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: clamp(calc({{ section.settings.active_line_height_pc }}px * 0.667), calc(100vw * {{ section.settings.active_line_height_pc }} / 1920), calc({{ section.settings.active_line_height_pc }}px * 2));
    background-color: {{ section.settings.active_line_color }};
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s ease;
  }

  .find-fit-{{ section.id }} .find-fit__tab.is-active {
    color: {{ section.settings.tab_active_text_color }};
    font-weight: {{ section.settings.tab_active_font_weight }};
  }

  .find-fit-{{ section.id }} .find-fit__tab.is-active::after {
    transform: scaleX(1);
  }

  .find-fit-{{ section.id }} .find-fit__content-wrapper {
    position: relative;
  }

  .find-fit-{{ section.id }} .find-fit__content {
    display: flex;
    gap: clamp(calc({{ section.settings.content_gap_pc }}px * 0.667), calc(100vw * {{ section.settings.content_gap_pc }} / 1920), calc({{ section.settings.content_gap_pc }}px * 2));
    align-items: center;
  }

  .find-fit-{{ section.id }} .find-fit__text-side {
    flex: 1;
    min-width: 0;
    max-width: clamp(calc({{ section.settings.text_max_width_pc }}px * 0.667), calc(100vw * {{ section.settings.text_max_width_pc }} / 1920), calc({{ section.settings.text_max_width_pc }}px * 2));
    margin-top: clamp(calc({{ section.settings.text_margin_top_pc }}px * 0.667), calc(100vw * {{ section.settings.text_margin_top_pc }} / 1920), calc({{ section.settings.text_margin_top_pc }}px * 2));
  }

  .find-fit-{{ section.id }} .find-fit__content-title {
    color: {{ section.settings.content_title_color }};
    font-size: clamp(calc({{ section.settings.content_title_font_size_pc }}px * 0.667), calc(100vw * {{ section.settings.content_title_font_size_pc }} / 1920), calc({{ section.settings.content_title_font_size_pc }}px * 2));
    font-weight: {{ section.settings.content_title_font_weight }};
    line-height: {{ section.settings.content_title_line_height }};
    margin-bottom: clamp(calc({{ section.settings.content_title_margin_bottom_pc }}px * 0.667), calc(100vw * {{ section.settings.content_title_margin_bottom_pc }} / 1920), calc({{ section.settings.content_title_margin_bottom_pc }}px * 2));
  }

  .find-fit-{{ section.id }} .find-fit__content-desc {
    color: {{ section.settings.content_desc_color }};
    font-size: clamp(calc({{ section.settings.content_desc_font_size_pc }}px * 0.667), calc(100vw * {{ section.settings.content_desc_font_size_pc }} / 1920), calc({{ section.settings.content_desc_font_size_pc }}px * 2));
    font-weight: {{ section.settings.content_desc_font_weight }};
    line-height: {{ section.settings.content_desc_line_height }};
    margin-bottom: clamp(calc({{ section.settings.content_desc_margin_bottom_pc }}px * 0.667), calc(100vw * {{ section.settings.content_desc_margin_bottom_pc }} / 1920), calc({{ section.settings.content_desc_margin_bottom_pc }}px * 2));
  }

  .find-fit-{{ section.id }} .find-fit__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: clamp(calc({{ section.settings.button_radius_pc }}px * 0.667), calc(100vw * {{ section.settings.button_radius_pc }} / 1920), calc({{ section.settings.button_radius_pc }}px * 2));
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    font-size: clamp(calc({{ section.settings.button_font_size_pc }}px * 0.667), calc(100vw * {{ section.settings.button_font_size_pc }} / 1920), calc({{ section.settings.button_font_size_pc }}px * 2));
    font-weight: {{ section.settings.button_font_weight }};
    line-height: 1;
    padding-top: clamp(calc({{ section.settings.button_padding_y_pc }}px * 0.667), calc(100vw * {{ section.settings.button_padding_y_pc }} / 1920), calc({{ section.settings.button_padding_y_pc }}px * 2));
    padding-bottom: clamp(calc({{ section.settings.button_padding_y_pc }}px * 0.667), calc(100vw * {{ section.settings.button_padding_y_pc }} / 1920), calc({{ section.settings.button_padding_y_pc }}px * 2));
    padding-left: clamp(calc({{ section.settings.button_padding_x_pc }}px * 0.667), calc(100vw * {{ section.settings.button_padding_x_pc }} / 1920), calc({{ section.settings.button_padding_x_pc }}px * 2));
    padding-right: clamp(calc({{ section.settings.button_padding_x_pc }}px * 0.667), calc(100vw * {{ section.settings.button_padding_x_pc }} / 1920), calc({{ section.settings.button_padding_x_pc }}px * 2));
    min-height: clamp(calc({{ section.settings.button_min_height_pc }}px * 0.667), calc(100vw * {{ section.settings.button_min_height_pc }} / 1920), calc({{ section.settings.button_min_height_pc }}px * 2));
    transition: background-color 0.3s ease, color 0.3s ease, transform 0.2s ease;
  }

  .find-fit-{{ section.id }} .find-fit__btn:hover {
    background: {{ section.settings.button_background_hover }};
    color: {{ section.settings.button_text_color_hover }};
    transform: translateY(-1px);
  }

  .find-fit-{{ section.id }} .find-fit__media-side {
    flex: 1;
    min-width: 0;
    position: relative;
    border-radius: clamp(calc({{ section.settings.media_radius_pc }}px * 0.667), calc(100vw * {{ section.settings.media_radius_pc }} / 1920), calc({{ section.settings.media_radius_pc }}px * 2));
    overflow: hidden;
    aspect-ratio: var(--media-aspect-ratio, 16 / 11);
    background-color: {{ section.settings.media_background }};
  }

  .find-fit-{{ section.id }} .find-fit__media-element {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: var(--media-object-fit, cover);
    display: block;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .find-fit-{{ section.id }} .find-fit__media-element.is-visible {
    opacity: 1;
    visibility: visible;
  }

  @media (max-width: 768px) {
    .find-fit-{{ section.id }} {
      padding-top: clamp(calc({{ section.settings.section_padding_top_mobile }}px * 0.85), calc(100vw * {{ section.settings.section_padding_top_mobile }} / 375), calc({{ section.settings.section_padding_top_mobile }}px * 1.15));
      padding-bottom: clamp(calc({{ section.settings.section_padding_bottom_mobile }}px * 0.85), calc(100vw * {{ section.settings.section_padding_bottom_mobile }} / 375), calc({{ section.settings.section_padding_bottom_mobile }}px * 1.15));
    }

    .find-fit-{{ section.id }} .find-fit__container {
      max-width: 100%;
      padding-left: 0;
      padding-right: 0;
    }

    .find-fit-{{ section.id }} .find-fit__html--pc {
      display: none;
    }

    .find-fit-{{ section.id }} .find-fit__html--mobile {
      display: block;
    }

    .find-fit-{{ section.id }} .find-fit__header {
      padding-left: clamp(calc({{ section.settings.mobile_side_padding }}px * 0.85), calc(100vw * {{ section.settings.mobile_side_padding }} / 375), calc({{ section.settings.mobile_side_padding }}px * 1.15));
      padding-right: clamp(calc({{ section.settings.mobile_side_padding }}px * 0.85), calc(100vw * {{ section.settings.mobile_side_padding }} / 375), calc({{ section.settings.mobile_side_padding }}px * 1.15));
      margin-bottom: clamp(calc({{ section.settings.header_margin_bottom_mobile }}px * 0.85), calc(100vw * {{ section.settings.header_margin_bottom_mobile }} / 375), calc({{ section.settings.header_margin_bottom_mobile }}px * 1.15));
    }

    .find-fit-{{ section.id }} .find-fit__title {
      font-size: clamp(calc({{ section.settings.heading_font_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.heading_font_size_mobile }} / 375), calc({{ section.settings.heading_font_size_mobile }}px * 1.15));
      margin-bottom: clamp(calc({{ section.settings.heading_margin_bottom_mobile }}px * 0.85), calc(100vw * {{ section.settings.heading_margin_bottom_mobile }} / 375), calc({{ section.settings.heading_margin_bottom_mobile }}px * 1.15));
    }

    .find-fit-{{ section.id }} .find-fit__subtitle {
      font-size: clamp(calc({{ section.settings.subtitle_font_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.subtitle_font_size_mobile }} / 375), calc({{ section.settings.subtitle_font_size_mobile }}px * 1.15));
    }

    .find-fit-{{ section.id }} .find-fit__tabs-wrapper {
      width: 100%;
      justify-content: flex-start;
      margin-bottom: clamp(calc({{ section.settings.tabs_margin_bottom_mobile }}px * 0.85), calc(100vw * {{ section.settings.tabs_margin_bottom_mobile }} / 375), calc({{ section.settings.tabs_margin_bottom_mobile }}px * 1.15));
    }

    .find-fit-{{ section.id }} .find-fit__tabs {
      width: 100%;
      padding-left: clamp(calc({{ section.settings.mobile_side_padding }}px * 0.85), calc(100vw * {{ section.settings.mobile_side_padding }} / 375), calc({{ section.settings.mobile_side_padding }}px * 1.15));
      padding-right: clamp(calc({{ section.settings.mobile_side_padding }}px * 0.85), calc(100vw * {{ section.settings.mobile_side_padding }} / 375), calc({{ section.settings.mobile_side_padding }}px * 1.15));
      gap: clamp(calc({{ section.settings.tabs_gap_mobile }}px * 0.85), calc(100vw * {{ section.settings.tabs_gap_mobile }} / 375), calc({{ section.settings.tabs_gap_mobile }}px * 1.15));
    }

    .find-fit-{{ section.id }} .find-fit__tab {
      padding-bottom: clamp(calc({{ section.settings.tab_padding_bottom_mobile }}px * 0.85), calc(100vw * {{ section.settings.tab_padding_bottom_mobile }} / 375), calc({{ section.settings.tab_padding_bottom_mobile }}px * 1.15));
      font-size: clamp(calc({{ section.settings.tab_font_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.tab_font_size_mobile }} / 375), calc({{ section.settings.tab_font_size_mobile }}px * 1.15));
    }

    .find-fit-{{ section.id }} .find-fit__tab::after {
      height: clamp(calc({{ section.settings.active_line_height_mobile }}px * 0.85), calc(100vw * {{ section.settings.active_line_height_mobile }} / 375), calc({{ section.settings.active_line_height_mobile }}px * 1.15));
    }

    .find-fit-{{ section.id }} .find-fit__content {
      flex-direction: column;
      gap: clamp(calc({{ section.settings.content_gap_mobile }}px * 0.85), calc(100vw * {{ section.settings.content_gap_mobile }} / 375), calc({{ section.settings.content_gap_mobile }}px * 1.15));
    }

    .find-fit-{{ section.id }} .find-fit__content-wrapper {
      padding-left: clamp(calc({{ section.settings.mobile_side_padding }}px * 0.85), calc(100vw * {{ section.settings.mobile_side_padding }} / 375), calc({{ section.settings.mobile_side_padding }}px * 1.15));
      padding-right: clamp(calc({{ section.settings.mobile_side_padding }}px * 0.85), calc(100vw * {{ section.settings.mobile_side_padding }} / 375), calc({{ section.settings.mobile_side_padding }}px * 1.15));
    }

    .find-fit-{{ section.id }} .find-fit__media-side {
      order: -1;
      width: 100%;
      border-radius: clamp(calc({{ section.settings.media_radius_mobile }}px * 0.85), calc(100vw * {{ section.settings.media_radius_mobile }} / 375), calc({{ section.settings.media_radius_mobile }}px * 1.15));
    }

    .find-fit-{{ section.id }} .find-fit__text-side {
      width: 100%;
      max-width: 100%;
      margin-top: 0;
    }

    .find-fit-{{ section.id }} .find-fit__content-title {

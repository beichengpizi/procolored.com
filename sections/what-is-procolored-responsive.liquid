{%- liquid
  assign title_desktop = section.settings.title_desktop
  assign title_mobile = section.settings.title_mobile | default: title_desktop
  assign hero_image_desktop = section.settings.hero_image_desktop
  assign hero_image_mobile = section.settings.hero_image_mobile | default: hero_image_desktop
-%}

<style>
  #shopify-section-{{ section.id }} .What-is-Procolored {
    --wip-section-bg: {{ section.settings.section_bg_color }};
    --wip-title-color: {{ section.settings.title_color }};
    --wip-value-color: {{ section.settings.value_color }};
    --wip-label-color: {{ section.settings.label_color }};
    --wip-default-card-bg: {{ section.settings.default_card_bg_color }};
    --wip-hero-placeholder-bg: {{ section.settings.hero_placeholder_bg_color }};

    background-color: var(--wip-section-bg);
    padding-top: clamp(calc({{ section.settings.section_padding_top_pc }}px * 0.667), calc(100vw * {{ section.settings.section_padding_top_pc }} / 1920), calc({{ section.settings.section_padding_top_pc }}px * 2));
    padding-bottom: clamp(calc({{ section.settings.section_padding_bottom_pc }}px * 0.667), calc(100vw * {{ section.settings.section_padding_bottom_pc }} / 1920), calc({{ section.settings.section_padding_bottom_pc }}px * 2));
    width: 100%;
  }

  #shopify-section-{{ section.id }} .What-is-Procolored__inner {
    max-width: clamp(calc({{ section.settings.inner_max_width_pc }}px * 0.667), calc(100vw * {{ section.settings.inner_max_width_pc }} / 1920), calc({{ section.settings.inner_max_width_pc }}px * 2));
    margin: 0 auto;
    padding-left: clamp(calc({{ section.settings.inner_padding_x_pc }}px * 0.667), calc(100vw * {{ section.settings.inner_padding_x_pc }} / 1920), calc({{ section.settings.inner_padding_x_pc }}px * 2));
    padding-right: clamp(calc({{ section.settings.inner_padding_x_pc }}px * 0.667), calc(100vw * {{ section.settings.inner_padding_x_pc }} / 1920), calc({{ section.settings.inner_padding_x_pc }}px * 2));
  }

  #shopify-section-{{ section.id }} .What-is-Procolored__title {
    color: var(--wip-title-color);
    text-align: center;
    font-size: clamp(calc({{ section.settings.title_font_size_pc }}px * 0.667), calc(100vw * {{ section.settings.title_font_size_pc }} / 1920), calc({{ section.settings.title_font_size_pc }}px * 2));
    font-weight: 800;
    line-height: 1.22;
    margin: 0 0 clamp(calc({{ section.settings.title_margin_bottom_pc }}px * 0.667), calc(100vw * {{ section.settings.title_margin_bottom_pc }} / 1920), calc({{ section.settings.title_margin_bottom_pc }}px * 2));
  }

  #shopify-section-{{ section.id }} .What-is-Procolored__title--mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .What-is-Procolored__hero {
    position: relative;
    width: 100%;
    aspect-ratio: 1400 / 788;
    overflow: hidden;
    background-color: var(--wip-hero-placeholder-bg);
    border-radius: clamp(calc({{ section.settings.hero_radius_pc }}px * 0.667), calc(100vw * {{ section.settings.hero_radius_pc }} / 1920), calc({{ section.settings.hero_radius_pc }}px * 2));
  }

  #shopify-section-{{ section.id }} .What-is-Procolored__hero-img,
  #shopify-section-{{ section.id }} .What-is-Procolored__hero-fallback {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .What-is-Procolored__hero-fallback {
    background-image: var(--wip-hero-fallback-image, none);
    background-size: cover;
    background-position: center;
  }

  #shopify-section-{{ section.id }} .What-is-Procolored__stats {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: clamp(calc({{ section.settings.stats_gap_pc }}px * 0.667), calc(100vw * {{ section.settings.stats_gap_pc }} / 1920), calc({{ section.settings.stats_gap_pc }}px * 2));
    margin-top: clamp(calc({{ section.settings.stats_margin_top_pc }}px * 0.667), calc(100vw * {{ section.settings.stats_margin_top_pc }} / 1920), calc({{ section.settings.stats_margin_top_pc }}px * 2));
  }

  #shopify-section-{{ section.id }} .What-is-Procolored__card {
    border-radius: clamp(calc({{ section.settings.card_radius_pc }}px * 0.667), calc(100vw * {{ section.settings.card_radius_pc }} / 1920), calc({{ section.settings.card_radius_pc }}px * 2));
    background: var(--wip-card-bg, var(--wip-default-card-bg));
    padding: clamp(calc({{ section.settings.card_padding_y_pc }}px * 0.667), calc(100vw * {{ section.settings.card_padding_y_pc }} / 1920), calc({{ section.settings.card_padding_y_pc }}px * 2)) clamp(calc({{ section.settings.card_padding_x_pc }}px * 0.667), calc(100vw * {{ section.settings.card_padding_x_pc }} / 1920), calc({{ section.settings.card_padding_x_pc }}px * 2));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .What-is-Procolored__icon {
    width: clamp(calc({{ section.settings.icon_size_pc }}px * 0.667), calc(100vw * {{ section.settings.icon_size_pc }} / 1920), calc({{ section.settings.icon_size_pc }}px * 2));
    height: clamp(calc({{ section.settings.icon_size_pc }}px * 0.667), calc(100vw * {{ section.settings.icon_size_pc }} / 1920), calc({{ section.settings.icon_size_pc }}px * 2));
    margin-bottom: clamp(calc({{ section.settings.icon_margin_bottom_pc }}px * 0.667), calc(100vw * {{ section.settings.icon_margin_bottom_pc }} / 1920), calc({{ section.settings.icon_margin_bottom_pc }}px * 2));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--wip-icon-primary-color, #3FA9FF);
  }

  #shopify-section-{{ section.id }} .What-is-Procolored__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .What-is-Procolored__value {
    color: var(--wip-value-color);
    font-size: clamp(calc({{ section.settings.value_font_size_pc }}px * 0.667), calc(100vw * {{ section.settings.value_font_size_pc }} / 1920), calc({{ section.settings.value_font_size_pc }}px * 2));
    font-weight: 700;
    line-height: 1.12;
    margin: 0 0 clamp(calc({{ section.settings.value_margin_bottom_pc }}px * 0.667), calc(100vw * {{ section.settings.value_margin_bottom_pc }} / 1920), calc({{ section.settings.value_margin_bottom_pc }}px * 2));
  }

  #shopify-section-{{ section.id }} .What-is-Procolored__label {
    color: var(--wip-label-color);
    text-align: center;
    font-size: clamp(calc({{ section.settings.label_font_size_pc }}px * 0.667), calc(100vw * {{ section.settings.label_font_size_pc }} / 1920), calc({{ section.settings.label_font_size_pc }}px * 2));
    font-weight: 400;
    line-height: 1.38;
  }

  #shopify-section-{{ section.id }} .What-is-Procolored__label--mobile,
  #shopify-section-{{ section.id }} .What-is-Procolored__value--mobile {
    display: none;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .What-is-Procolored {
      padding-top: clamp(calc({{ section.settings.section_padding_top_mobile }}px * 0.85), calc(100vw * {{ section.settings.section_padding_top_mobile }} / 375), calc({{ section.settings.section_padding_top_mobile }}px * 1.15));
      padding-bottom: clamp(calc({{ section.settings.section_padding_bottom_mobile }}px * 0.85), calc(100vw * {{ section.settings.section_padding_bottom_mobile }} / 375), calc({{ section.settings.section_padding_bottom_mobile }}px * 1.15));
    }

    #shopify-section-{{ section.id }} .What-is-Procolored__inner {
      max-width: none;
      padding-left: clamp(calc({{ section.settings.inner_padding_x_mobile }}px * 0.85), calc(100vw * {{ section.settings.inner_padding_x_mobile }} / 375), calc({{ section.settings.inner_padding_x_mobile }}px * 1.15));
      padding-right: clamp(calc({{ section.settings.inner_padding_x_mobile }}px * 0.85), calc(100vw * {{ section.settings.inner_padding_x_mobile }} / 375), calc({{ section.settings.inner_padding_x_mobile }}px * 1.15));
    }

    #shopify-section-{{ section.id }} .What-is-Procolored__title {
      font-size: clamp(calc({{ section.settings.title_font_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.title_font_size_mobile }} / 375), calc({{ section.settings.title_font_size_mobile }}px * 1.15));
      line-height: 1.33;
      margin-bottom: clamp(calc({{ section.settings.title_margin_bottom_mobile }}px * 0.85), calc(100vw * {{ section.settings.title_margin_bottom_mobile }} / 375), calc({{ section.settings.title_margin_bottom_mobile }}px * 1.15));
    }

    #shopify-section-{{ section.id }} .What-is-Procolored__title--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .What-is-Procolored__title--mobile {
      display: block;
    }

    #shopify-section-{{ section.id }} .What-is-Procolored__hero {
      margin-top: clamp(calc({{ section.settings.hero_margin_top_mobile }}px * 0.85), calc(100vw * {{ section.settings.hero_margin_top_mobile }} / 375), calc({{ section.settings.hero_margin_top_mobile }}px * 1.15));
      aspect-ratio: 327 / 208;
      border-radius: clamp(calc({{ section.settings.hero_radius_mobile }}px * 0.85), calc(100vw * {{ section.settings.hero_radius_mobile }} / 375), calc({{ section.settings.hero_radius_mobile }}px * 1.15));
    }

    #shopify-section-{{ section.id }} .What-is-Procolored__stats {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      gap: clamp(calc({{ section.settings.stats_gap_mobile }}px * 0.85), calc(100vw * {{ section.settings.stats_gap_mobile }} / 375), calc({{ section.settings.stats_gap_mobile }}px * 1.15));
      margin-top: clamp(calc({{ section.settings.stats_margin_top_mobile }}px * 0.85), calc(100vw * {{ section.settings.stats_margin_top_mobile }} / 375), calc({{ section.settings.stats_margin_top_mobile }}px * 1.15));
    }

    #shopify-section-{{ section.id }} .What-is-Procolored__card {
      border-radius: clamp(calc({{ section.settings.card_radius_mobile }}px * 0.85), calc(100vw * {{ section.settings.card_radius_mobile }} / 375), calc({{ section.settings.card_radius_mobile }}px * 1.15));
      padding: clamp(calc({{ section.settings.card_padding_y_mobile }}px * 0.85), calc(100vw * {{ section.settings.card_padding_y_mobile }} / 375), calc({{ section.settings.card_padding_y_mobile }}px * 1.15)) clamp(calc({{ section.settings.card_padding_x_mobile }}px * 0.85), calc(100vw * {{ section.settings.card_padding_x_mobile }} / 375), calc({{ section.settings.card_padding_x_mobile }}px * 1.15));
    }

    #shopify-section-{{ section.id }} .What-is-Procolored__icon {
      width: clamp(calc({{ section.settings.icon_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.icon_size_mobile }} / 375), calc({{ section.settings.icon_size_mobile }}px * 1.15));
      height: clamp(calc({{ section.settings.icon_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.icon_size_mobile }} / 375), calc({{ section.settings.icon_size_mobile }}px * 1.15));
      margin-bottom: clamp(calc({{ section.settings.icon_margin_bottom_mobile }}px * 0.85), calc(100vw * {{ section.settings.icon_margin_bottom_mobile }} / 375), calc({{ section.settings.icon_margin_bottom_mobile }}px * 1.15));
    }

    #shopify-section-{{ section.id }} .What-is-Procolored__value {
      font-size: clamp(calc({{ section.settings.value_font_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.value_font_size_mobile }} / 375), calc({{ section.settings.value_font_size_mobile }}px * 1.15));
      line-height: 1.5;
      margin-bottom: clamp(calc({{ section.settings.value_margin_bottom_mobile }}px * 0.85), calc(100vw * {{ section.settings.value_margin_bottom_mobile }} / 375), calc({{ section.settings.value_margin_bottom_mobile }}px * 1.15));
    }

    #shopify-section-{{ section.id }} .What-is-Procolored__label {
      font-size: clamp(calc({{ section.settings.label_font_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.label_font_size_mobile }} / 375), calc({{ section.settings.label_font_size_mobile }}px * 1.15));
      line-height: 1.4;
    }

    #shopify-section-{{ section.id }} .What-is-Procolored__label--desktop,
    #shopify-section-{{ section.id }} .What-is-Procolored__value--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .What-is-Procolored__label--mobile,
    #shopify-section-{{ section.id }} .What-is-Procolored__value--mobile {
      display: block;
    }
  }
</style>

<div class="What-is-Procolored">
  <div class="What-is-Procolored__inner">
    {%- if title_desktop != blank -%}
      <div class="What-is-Procolored__title What-is-Procolored__title--desktop">{{ title_desktop }}</div>
    {%- endif -%}

    {%- if title_mobile != blank -%}
      <div class="What-is-Procolored__title What-is-Procolored__title--mobile">{{ title_mobile }}</div>
    {%- endif -%}

    <div class="What-is-Procolored__hero"{% if section.settings.hero_fallback_url != blank %} style="--wip-hero-fallback-image: url('{{ section.settings.hero_fallback_url }}');"{% endif %}>
      {%- if hero_image_desktop != blank or hero_image_mobile != blank -%}
        <picture>
          {%- if hero_image_mobile != blank -%}
            <source
              media="(max-width: 768px)"
              data-srcset="{{ hero_image_mobile | image_url: width: 750 }} 750w, {{ hero_image_mobile | image_url: width: 1000 }} 1000w, {{ hero_image_mobile | image_url: width: 1200 }} 1200w"
              sizes="100vw"
            >
          {%- endif -%}
          {%- if hero_image_desktop != blank -%}
            <img
              class="What-is-Procolored__hero-img lazyload"
              src="data:image/gif;base64,R0lGODlhAQABAAAAACw="
              data-src="{{ hero_image_desktop | image_url: width: 2400 }}"
              data-srcset="{{ hero_image_desktop | image_url: width: 1200 }} 1200w, {{ hero_image_desktop | image_url: width: 1800 }} 1800w, {{ hero_image_desktop | image_url: width: 2400 }} 2400w, {{ hero_image_desktop | image_url: width: 3200 }} 3200w"
              data-sizes="auto"
              alt="{{ section.settings.hero_alt | escape }}"
              width="{{ hero_image_desktop.width }}"
              height="{{ hero_image_desktop.height }}"
              loading="lazy"
            >
          {%- elsif hero_image_mobile != blank -%}
            <img
              class="What-is-Procolored__hero-img lazyload"
              src="data:image/gif;base64,R0lGODlhAQABAAAAACw="
              data-src="{{ hero_image_mobile | image_url: width: 1200 }}"
              data-srcset="{{ hero_image_mobile | image_url: width: 750 }} 750w, {{ hero_image_mobile | image_url: width: 1000 }} 1000w, {{ hero_image_mobile | image_url: width: 1200 }} 1200w"
              data-sizes="auto"
              alt="{{ section.settings.hero_alt | escape }}"
              width="{{ hero_image_mobile.width }}"
              height="{{ hero_image_mobile.height }}"
              loading="lazy"
            >
          {%- endif -%}
        </picture>
      {%- else -%}
        <div class="What-is-Procolored__hero-fallback" role="img" aria-label="{{ section.settings.hero_alt | escape }}"></div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="What-is-Procolored__stats">
        {%- for block in section.blocks -%}
          {%- liquid
            assign value_desktop = block.settings.value_desktop
            assign value_mobile = block.settings.value_mobile | default: value_desktop
            assign label_desktop = block.settings.label_desktop
            assign label_mobile = block.settings.label_mobile | default: label_desktop
            assign card_bg_color = block.settings.card_bg_color | default: section.settings.default_card_bg_color
          -%}
          <div
            class="What-is-Procolored__card"
            style="--wip-card-bg: {{ card_bg_color }}; --wip-icon-primary-color: {{ block.settings.icon_primary_color }}; --wip-icon-soft-color: {{ block.settings.icon_soft_color }}; --wip-icon-line-color: {{ block.settings.icon_line_color }};"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.icon_svg_html != blank -%}
              <div class="What-is-Procolored__icon">{{ block.settings.icon_svg_html }}</div>
            {%- endif -%}

            {%- if value_desktop != blank -%}
              <div class="What-is-Procolored__value What-is-Procolored__value--desktop">{{ value_desktop }}</div>
            {%- endif -%}
            {%- if value_mobile != blank -%}
              <div class="What-is-Procolored__value What-is-Procolored__value--mobile">{{ value_mobile }}</div>
            {%- endif -%}

            {%- if label_desktop != blank -%}
              <div class="What-is-Procolored__label What-is-Procolored__label--desktop">{{ label_desktop }}</div>
            {%- endif -%}
            {%- if label_mobile != blank -%}
              <div class="What-is-Procolored__label What-is-Procolored__label--mobile">{{ label_mobile }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "What is Procolored",
  "tag": "section",
  "class": "section-what-is-procolored",
  "settings": [
    {
      "type": "header",
      "content": "模块内容"
    },
    {
      "type": "html",
      "id": "title_desktop",
      "label": "主标题 HTML（PC）",
      "default": "What is Procolored?"
    },
    {
      "type": "html",
      "id": "title_mobile",
      "label": "主标题 HTML（移动端）",
      "placeholder": "留空时自动使用 PC 主标题"
    },
    {
      "type": "image_picker",
      "id": "hero_image_desktop",
      "label": "主图（PC）"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "主图（移动端）"
    },
    {
      "type": "text",
      "id": "hero_alt",
      "label": "主图 Alt 文案",
      "default": "What is Procolored"
    },
    {
      "type": "text",
      "id": "hero_fallback_url",
      "label": "主图兜底外链 URL（未选择图片时使用）",
      "default": "https://images.unsplash.com/photo-1579762593175-20226054cad0?q=80&w=2400&auto=format&fit=crop"
    },
    {
      "type": "header",
      "content": "颜色配置"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "模块背景颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "主标题颜色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "value_color",
      "label": "数字颜色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "说明文字颜色",
      "default": "#6D6D6D"
    },
    {
      "type": "color",
      "id": "default_card_bg_color",
      "label": "卡片默认背景颜色",
      "default": "#F8F9FC"
    },
    {
      "type": "color",
      "id": "hero_placeholder_bg_color",
      "label": "未配置主图时背景颜色",
      "default": "#F8F9FC"
    },
    {
      "type": "header",
      "content": "PC 布局尺寸"
    },
    {
      "type": "range",
      "id": "inner_max_width_pc",
      "label": "内容最大宽度（PC）",
      "min": 1000,
      "max": 1800,
      "step": 8,
      "unit": "px",
      "default": 1448
    },
    {
      "type": "range",
      "id": "inner_padding_x_pc",
      "label": "内容左右边距（PC）",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "section_padding_top_pc",
      "label": "模块上边距（PC）",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "section_padding_bottom_pc",
      "label": "模块下边距（PC）",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "title_font_size_pc",
      "label": "主标题字号（PC）",
      "min": 20,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "title_margin_bottom_pc",
      "label": "主标题下边距（PC）",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "hero_radius_pc",
      "label": "主图圆角（PC）",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "stats_margin_top_pc",
      "label": "卡片区域上边距（PC）",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "stats_gap_pc",
      "label": "卡片间距（PC）",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_radius_pc",
      "label": "卡片圆角（PC）",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_padding_y_pc",
      "label": "卡片上下内边距（PC）",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "card_padding_x_pc",
      "label": "卡片左右内边距（PC）",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "icon_size_pc",
      "label": "SVG 图标尺寸（PC）",
      "min": 20,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "icon_margin_bottom_pc",
      "label": "SVG 图标下边距（PC）",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "value_font_size_pc",
      "label": "数字字号（PC）",
      "min": 12,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",

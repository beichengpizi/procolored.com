    #shopify-section-{{ section.id }} .how-works--{{ section.id }} .how-works__steps::after {
      content: none;
      display: none;
    }

    #shopify-section-{{ section.id }} .how-works--{{ section.id }} .how-works__steps.is-overflowing {
      justify-content: flex-start;
      overflow-x: auto;
      scrollbar-width: none;
      touch-action: pan-x;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
    }

    #shopify-section-{{ section.id }} .how-works--{{ section.id }} .how-works__steps.is-overflowing::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .how-works--{{ section.id }} .step-item {
      position: relative;
      z-index: 1;
      margin-left: 0;
      margin-top: 0;
      padding: clamp(calc({{ section.settings.step_padding_top_mobile }}px * 0.85), calc(100vw * {{ section.settings.step_padding_top_mobile }} / 375), calc({{ section.settings.step_padding_top_mobile }}px * 1.15)) 0 0;
      border-left: 0;
      border-top: 0;
      color: var(--hw-color-step-text);
      font-size: clamp(calc({{ section.settings.step_font_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.step_font_size_mobile }} / 375), calc({{ section.settings.step_font_size_mobile }}px * 1.15));
      font-weight: {{ section.settings.step_font_weight_mobile }};
      line-height: {{ section.settings.step_line_height_mobile | divided_by: 100.0 }};
      scroll-snap-align: center;
    }

    #shopify-section-{{ section.id }} .how-works--{{ section.id }} .step-item::before {
      content: '';
      display: block;
      position: absolute;
      z-index: 2;
      top: 0;
      left: 0;
      right: 0;
      height: clamp(calc({{ section.settings.step_active_thickness_mobile }}px * 0.85), calc(100vw * {{ section.settings.step_active_thickness_mobile }} / 375), calc({{ section.settings.step_active_thickness_mobile }}px * 1.15));
      background: var(--hw-color-step-active-line);
      opacity: 0;
      transform: scaleX(0.65);
      transform-origin: center;
      transition: opacity 0.25s ease, transform 0.3s ease;
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .how-works--{{ section.id }} .step-item::after {
      content: none;
      display: none;
    }

    #shopify-section-{{ section.id }} .how-works--{{ section.id }} .step-item.is-active {
      border-left-color: transparent;
      font-weight: {{ section.settings.step_active_font_weight_mobile }};
    }

    #shopify-section-{{ section.id }} .how-works--{{ section.id }} .step-item.is-active::before {
      opacity: 1;
      transform: scaleX(1);
    }

    #shopify-section-{{ section.id }} .how-works--{{ section.id }} .how-works__info {
      font-size: clamp(calc({{ section.settings.info_font_size_mobile }}px * 0.85), calc(100vw * {{ section.settings.info_font_size_mobile }} / 375), calc({{ section.settings.info_font_size_mobile }}px * 1.15));
      line-height: {{ section.settings.info_line_height_mobile | divided_by: 100.0 }};
      min-height: auto;
    }

  }
</style>

<div class="how-works how-works--{{ section.id }}" data-how-works-section="{{ section.id }}">
  <div class="how-works__container">
    <div class="how-works__header">
      <div class="how-works__title">
        <span class="how-works__text-pc">{{ section.settings.title_pc_html }}</span>
        <span class="how-works__text-mobile">
          {% if section.settings.title_mobile_html != blank %}
            {{ section.settings.title_mobile_html }}
          {% else %}
            {{ section.settings.title_pc_html }}
          {% endif %}
        </span>
      </div>

      <div class="how-works__desc">
        <span class="how-works__text-pc">{{ section.settings.desc_pc_html }}</span>
        <span class="how-works__text-mobile">
          {% if section.settings.desc_mobile_html != blank %}
            {{ section.settings.desc_mobile_html }}
          {% else %}
            {{ section.settings.desc_pc_html }}
          {% endif %}
        </span>
      </div>
    </div>

    <div class="how-works__nav-main" id="HowWorksNavMain-{{ section.id }}">
      <div class="nav-main__indicator" id="HowWorksNavIndicator-{{ section.id }}"></div>
      {%- for block in section.blocks -%}
        {%- if block.type == 'tab' -%}
          {%- liquid
            assign tab_key = block.settings.tab_key | default: block.id | handleize
            capture tab_title_pc
              echo block.settings.title_pc_html
            endcapture
            capture tab_title_mobile
              echo block.settings.title_mobile_html
            endcapture
          -%}
          <button
            type="button"
            class="nav-main__btn{% if tab_key == hw_default_type %} is-active{% endif %}"
            data-type="{{ tab_key | escape }}"
            aria-pressed="{% if tab_key == hw_default_type %}true{% else %}false{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span class="how-works__text-pc">{{ tab_title_pc }}</span>
            <span class="how-works__text-mobile">
              {%- if tab_title_mobile != blank -%}{{ tab_title_mobile }}{%- else -%}{{ tab_title_pc }}{%- endif -%}
            </span>
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="how-works__content">
      <div class="how-works__display" id="HowWorksMediaDisplay-{{ section.id }}" aria-live="polite"></div>

      <div class="how-works__side">
        <div class="how-works__steps" id="HowWorksStepContainer-{{ section.id }}"></div>
        <div class="how-works__info" id="HowWorksInfoText-{{ section.id }}"></div>
      </div>
    </div>
  </div>

  <script type="application/json" data-how-works-config>
    {
      "defaultType": {{ hw_default_type | json }},
      "videoLoop": {{ section.settings.video_loop | json }},
      "scrollSafePadding": {{ section.settings.mobile_scroll_safe_padding | json }},
      "infoDelay": {{ section.settings.info_change_delay | json }},
      "fallbackAspectPc": {{ section.settings.media_aspect_ratio | json }},
      "fallbackAspectMobile": {{ section.settings.media_aspect_ratio_mobile | json }},
      "tabs": [
        {%- assign first_tab_json = true -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'tab' -%}
            {%- liquid
              assign tab_key = block.settings.tab_key | default: block.id | handleize
              capture tab_title_pc_json
                echo block.settings.title_pc_html
              endcapture
              capture tab_title_mobile_json
                echo block.settings.title_mobile_html
              endcapture
              assign tab_title_text = tab_title_pc_json | strip_html | strip
            -%}
            {%- unless first_tab_json -%},{%- endunless -%}
            {
              "key": {{ tab_key | json }},
              "titlePc": {{ tab_title_pc_json | json }},
              "titleMobile": {{ tab_title_mobile_json | json }},
              "titleText": {{ tab_title_text | json }},
              "active": {{ block.settings.default_active | json }}
            }
            {%- assign first_tab_json = false -%}
          {%- endif -%}
        {%- endfor -%}
      ],
      "steps": [
        {%- assign first_step_json = true -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- liquid
              assign step_group_key = block.settings.tab_key | default: hw_default_type | handleize

              capture step_label_pc_json
                echo block.settings.label_pc_html
              endcapture

              capture step_label_mobile_json
                echo block.settings.label_mobile_html
              endcapture

              capture step_info_pc_json
                echo block.settings.info_pc_html
              endcapture

              capture step_info_mobile_json
                echo block.settings.info_mobile_html
              endcapture

              capture step_svg_pc_json
                echo block.settings.svg_pc_html
              endcapture

              capture step_svg_mobile_json
                echo block.settings.svg_mobile_html
              endcapture

              assign step_label_text = step_label_pc_json | strip_html | strip

              assign image_pc_aspect = 0
              if block.settings.image_pc != blank and block.settings.image_pc.aspect_ratio != blank
                assign image_pc_aspect = block.settings.image_pc.aspect_ratio
              endif

              assign image_mobile_aspect = 0
              if block.settings.image_mobile != blank and block.settings.image_mobile.aspect_ratio != blank
                assign image_mobile_aspect = block.settings.image_mobile.aspect_ratio
              endif

              assign poster_pc_aspect = 0
              if block.settings.video_poster_pc != blank and block.settings.video_poster_pc.aspect_ratio != blank
                assign poster_pc_aspect = block.settings.video_poster_pc.aspect_ratio
              endif

              assign poster_mobile_aspect = 0
              if block.settings.video_poster_mobile != blank and block.settings.video_poster_mobile.aspect_ratio != blank
                assign poster_mobile_aspect = block.settings.video_poster_mobile.aspect_ratio
              endif

              assign image_pc_url = ''
              if block.settings.image_pc != blank
                assign image_pc_url = block.settings.image_pc | image_url: width: 2400
              elsif block.settings.image_url_pc != blank
                assign image_pc_url = block.settings.image_url_pc
              endif

              assign image_mobile_url = ''
              if block.settings.image_mobile != blank
                assign image_mobile_url = block.settings.image_mobile | image_url: width: 1400
              elsif block.settings.image_url_mobile != blank
                assign image_mobile_url = block.settings.image_url_mobile
              endif

              assign poster_pc_url = ''
              if block.settings.video_poster_pc != blank
                assign poster_pc_url = block.settings.video_poster_pc | image_url: width: 2400
              elsif block.settings.video_poster_url_pc != blank
                assign poster_pc_url = block.settings.video_poster_url_pc
              endif

              assign poster_mobile_url = ''
              if block.settings.video_poster_mobile != blank
                assign poster_mobile_url = block.settings.video_poster_mobile | image_url: width: 1400
              elsif block.settings.video_poster_url_mobile != blank
                assign poster_mobile_url = block.settings.video_poster_url_mobile
              endif
            -%}
            {%- unless first_step_json -%},{%- endunless -%}
            {
              "groupKey": {{ step_group_key | json }},
              "labelPc": {{ step_label_pc_json | json }},
              "labelMobile": {{ step_label_mobile_json | json }},
              "labelText": {{ step_label_text | json }},
              "infoPc": {{ step_info_pc_json | json }},
              "infoMobile": {{ step_info_mobile_json | json }},
              "mediaType": {{ block.settings.media_type | json }},
              "imagePc": {{ image_pc_url | json }},
              "imageMobile": {{ image_mobile_url | json }},
              "imageAspectPc": {{ image_pc_aspect | json }},
              "imageAspectMobile": {{ image_mobile_aspect | json }},
              "imageAlt": {{ block.settings.image_alt | json }},
              "videoPc": {{ block.settings.video_url_pc | json }},
              "videoMobile": {{ block.settings.video_url_mobile | json }},
              "posterPc": {{ poster_pc_url | json }},
              "posterMobile": {{ poster_mobile_url | json }},
              "posterAspectPc": {{ poster_pc_aspect | json }},
              "posterAspectMobile": {{ poster_mobile_aspect | json }},
              "svgPc": {{ step_svg_pc_json | json }},
              "svgMobile": {{ step_svg_mobile_json | json }}
            }
            {%- assign first_step_json = false -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
</div>

<script>
  (() => {
    class HowWorksShowcase {
      constructor(root) {
        this.root = root;
        this.config = this.readConfig();
        this.tabs = Array.isArray(this.config.tabs) ? this.config.tabs : [];
        this.steps = Array.isArray(this.config.steps) ? this.config.steps : [];
        this.state = {
          type: this.config.defaultType || (this.tabs[0] && this.tabs[0].key) || '',
          step: 0
        };
        this.resizeTimer = null;
        this.infoTimer = null;

        this.dom = {
          navMain: this.root.querySelector('.how-works__nav-main'),
          navIndicator: this.root.querySelector('.nav-main__indicator'),
          navBtns: Array.from(this.root.querySelectorAll('.nav-main__btn')),
          stepContainer: this.root.querySelector('.how-works__steps'),
          mediaDisplay: this.root.querySelector('.how-works__display'),
          infoText: this.root.querySelector('.how-works__info')
        };

        this.init();
      }

      readConfig() {
        const configNode = this.root.querySelector('[data-how-works-config]');

        if (!configNode) return {};

        try {
          return JSON.parse(configNode.textContent || '{}');
        } catch (error) {
          console.warn('How Works config parse failed:', error);
          return {};
        }
      }

      init() {
        if (!this.dom.navMain || !this.dom.stepContainer || !this.dom.mediaDisplay || !this.dom.infoText) return;
        if (!this.tabs.length) return;

        this.bindNavEvents();
        this.renderAll();

        window.addEventListener('resize', () => {
          window.clearTimeout(this.resizeTimer);
          this.resizeTimer = window.setTimeout(() => {
            this.refreshLayout();
            this.updateActiveMediaAspectRatio();
            this.refreshActiveVideoSource();
          }, 80);
        });
      }

      bindNavEvents() {
        this.dom.navBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const type = btn.getAttribute('data-type');

            if (!type) return;

            if (this.state.type === type) {
              this.scrollElementIntoView(btn, this.dom.navMain);
              return;
            }

            this.state.type = type;
            this.state.step = 0;
            this.renderAll();

            requestAnimationFrame(() => {
              this.scrollElementIntoView(btn, this.dom.navMain);
            });
          });
        });
      }

      isMobile() {
        return window.matchMedia('(max-width: 768px)').matches;
      }

      getViewportValue(pcValue, mobileValue) {
        return this.isMobile() && mobileValue ? mobileValue : pcValue;
      }

      sanitizeAspectRatio(value) {
        if (value === null || value === undefined || value === '') return '';

        const numberValue = Number(value);
        if (Number.isFinite(numberValue) && numberValue > 0) {
          return `${numberValue} / 1`;
        }

        const stringValue = String(value).trim();
        if (/^\d+(?:\.\d+)?\s*\/\s*\d+(?:\.\d+)?$/.test(stringValue)) {
          return stringValue;
        }

        return '';
      }

      getFallbackAspectRatio() {
        return this.sanitizeAspectRatio(this.isMobile() ? this.config.fallbackAspectMobile : this.config.fallbackAspectPc) || '16 / 10';
      }

      getItemAspectRatio(item) {
        if (!item) return this.getFallbackAspectRatio();

        const aspect = this.isMobile()
          ? item.imageAspectMobile || item.posterAspectMobile || item.imageAspectPc || item.posterAspectPc
          : item.imageAspectPc || item.posterAspectPc || item.imageAspectMobile || item.posterAspectMobile;

        return this.sanitizeAspectRatio(aspect) || this.getFallbackAspectRatio();
      }

      setDisplayAspectRatio(aspectRatio) {
        const safeAspectRatio = this.sanitizeAspectRatio(aspectRatio) || this.getFallbackAspectRatio();
        this.dom.mediaDisplay.style.setProperty('--hw-active-media-aspect-ratio', safeAspectRatio);
      }

      updateActiveMediaAspectRatio() {
        const steps = this.getCurrentSteps();
        const activeItemData = steps[this.state.step];
        const activeItem = this.dom.mediaDisplay.querySelector('.how-works__media-item.is-active');
        const activeMedia = activeItem ? activeItem.querySelector('img, video') : null;

        this.setDisplayAspectRatio(this.getItemAspectRatio(activeItemData));

        if (!activeMedia) return;

        this.updateDisplayAspectRatioFromMedia(activeMedia);
      }

      updateDisplayAspectRatioFromMedia(media) {
        if (!media) return;

        if (media.tagName === 'IMG' && media.naturalWidth && media.naturalHeight) {
          this.setDisplayAspectRatio(`${media.naturalWidth} / ${media.naturalHeight}`);
          return;
        }

        if (media.tagName === 'VIDEO' && media.videoWidth && media.videoHeight) {
          this.setDisplayAspectRatio(`${media.videoWidth} / ${media.videoHeight}`);
        }
      }

      getResponsiveHtml(pcHtml, mobileHtml) {
        const pc = pcHtml || '';
        const mobile = mobileHtml || pc;

        return `<span class="how-works__text-pc">${pc}</span><span class="how-works__text-mobile">${mobile}</span>`;
      }

      getCurrentSteps() {
        return this.steps.filter((item) => item.groupKey === this.state.type);
      }

      updateOverflowClass(container) {
        if (!container) return false;

        const isOverflowing = container.scrollWidth > container.clientWidth + 1;
        container.classList.toggle('is-overflowing', isOverflowing);

        if (!isOverflowing) {
          container.scrollLeft = 0;
        }

        return isOverflowing;
      }

      refreshLayout() {
        this.updateOverflowClass(this.dom.navMain);
        this.updateOverflowClass(this.dom.stepContainer);

        requestAnimationFrame(() => {
          this.moveMainIndicator();
          this.scrollActiveStepIntoView();
        });
      }

      scrollElementIntoView(element, container) {
        if (!element || !container) return;
        if (!container.classList.contains('is-overflowing')) return;

        const safePadding = Number(this.config.scrollSafePadding || 24);
        const elementLeft = element.offsetLeft;
        const elementRight = elementLeft + element.offsetWidth;
        const visibleLeft = container.scrollLeft;
        const visibleRight = visibleLeft + container.clientWidth;
        let targetLeft = container.scrollLeft;

        if (elementLeft < visibleLeft + safePadding) {
          targetLeft = elementLeft - safePadding;
        } else if (elementRight > visibleRight - safePadding) {
          targetLeft = elementRight - container.clientWidth + safePadding;
        }

        const maxScrollLeft = Math.max(0, container.scrollWidth - container.clientWidth);

        container.scrollTo({
          left: Math.max(0, Math.min(targetLeft, maxScrollLeft)),
          behavior: 'smooth'
        });
      }

      scrollActiveStepIntoView() {
        if (!this.isMobile()) return;

        const activeStep = this.dom.stepContainer.querySelector('.step-item.is-active');
        this.scrollElementIntoView(activeStep, this.dom.stepContainer);
      }

      moveMainIndicator() {
        const activeBtn = this.dom.navBtns.find((btn) => btn.classList.contains('is-active'));

        if (!activeBtn || !this.dom.navIndicator) return;

        this.dom.navIndicator.style.opacity = '1';
        this.dom.navIndicator.style.width = `${activeBtn.offsetWidth}px`;
        this.dom.navIndicator.style.height = `${activeBtn.offsetHeight}px`;
        this.dom.navIndicator.style.left = `${activeBtn.offsetLeft}px`;
        this.dom.navIndicator.style.top = `${activeBtn.offsetTop}px`;
      }

      renderAll() {
        this.renderNavState();
        this.renderSteps();
        this.renderMedia();
        this.updateActiveMediaAspectRatio();
        this.updateInfo(true);

        requestAnimationFrame(() => {
          this.refreshLayout();
          this.playActiveMedia();
        });
      }

      renderNavState() {
        this.dom.navBtns.forEach((btn) => {
          const isActive = btn.getAttribute('data-type') === this.state.type;
          btn.classList.toggle('is-active', isActive);
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
      }

      renderSteps() {
        const steps = this.getCurrentSteps();
        this.dom.stepContainer.innerHTML = '';

        if (!steps.length) return;

        if (this.state.step >= steps.length) {
          this.state.step = 0;
        }

        steps.forEach((item, index) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = `step-item${index === this.state.step ? ' is-active' : ''}`;
          btn.innerHTML = this.getResponsiveHtml(item.labelPc, item.labelMobile);
          btn.setAttribute('aria-pressed', index === this.state.step ? 'true' : 'false');
          btn.setAttribute('aria-label', item.labelText || `Step ${index + 1}`);

          btn.addEventListener('click', () => {
            this.switchStep(index, btn);
          });

          this.dom.stepContainer.appendChild(btn);
        });
      }

      switchStep(index, btnElement) {
        if (this.state.step === index) {
          this.scrollElementIntoView(btnElement, this.dom.stepContainer);
          return;
        }

        this.state.step = index;

        const buttons = Array.from(this.dom.stepContainer.querySelectorAll('.step-item'));
        buttons.forEach((btn, btnIndex) => {
          const isActive = btnIndex === index;
          btn.classList.toggle('is-active', isActive);
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });

        this.updateOverflowClass(this.dom.stepContainer);
        this.scrollElementIntoView(btnElement, this.dom.stepContainer);
        this.activateMedia(index);
        this.updateInfo(false);
      }

      renderMedia() {
        const steps = this.getCurrentSteps();
        this.dom.mediaDisplay.innerHTML = '';

        steps.forEach((item, index) => {
          const wrapper = document.createElement('div');
          wrapper.className = `how-works__media-item${index === this.state.step ? ' is-active' : ''}`;
          wrapper.dataset.index = String(index);

          if (item.mediaType === 'video') {
            wrapper.appendChild(this.createVideo(item));
          } else if (item.mediaType === 'svg_html') {
            wrapper.appendChild(this.createSvg(item));
          } else {
            wrapper.appendChild(this.createImage(item));
          }

          this.dom.mediaDisplay.appendChild(wrapper);
        });
      }

      createImage(item) {
        const picture = document.createElement('picture');
        const source = document.createElement('source');
        const img = document.createElement('img');
        const pcSrc = item.imagePc || item.imageMobile || '';
        const mobileSrc = item.imageMobile || item.imagePc || '';

        picture.className = 'how-works__picture';
        source.media = '(max-width: 768px)';
        source.dataset.srcset = mobileSrc;
        img.className = 'how-works__img lazyload';
        img.dataset.src = pcSrc;
        img.alt = item.imageAlt || item.labelText || '';
        img.loading = 'lazy';
        img.decoding = 'async';

        img.addEventListener('load', () => {
          if (img.closest('.how-works__media-item.is-active')) {
            this.updateDisplayAspectRatioFromMedia(img);
          }
        });

        picture.appendChild(source);
        picture.appendChild(img);

        // 关键兜底：主题未加载 lazysizes 时，仍然使用原生 loading="lazy" 正常显示图片。
        if (!window.lazySizes) {
          if (mobileSrc) source.srcset = mobileSrc;
          if (pcSrc) img.src = pcSrc;
        }

        return picture;
      }

      createVideo(item) {
        const video = document.createElement('video');
        const poster = this.getViewportValue(item.posterPc || item.posterMobile || '', item.posterMobile || item.posterPc || '');

        video.className = 'how-works__video';
        video.muted = true;
        video.loop = Boolean(this.config.videoLoop);
        video.playsInline = true;
        video.preload = 'metadata';
        video.addEventListener('loadedmetadata', () => {
          if (video.closest('.how-works__media-item.is-active')) {
            this.updateDisplayAspectRatioFromMedia(video);
          }
        });
        video.dataset.srcPc = item.videoPc || item.videoMobile || '';
        video.dataset.srcMobile = item.videoMobile || item.videoPc || '';

        if (poster) {
          video.poster = poster;
        }

        return video;
      }

      createSvg(item) {
        const holder = document.createElement('div');
        holder.className = 'how-works__svg';
        holder.innerHTML = this.getResponsiveHtml(item.svgPc, item.svgMobile);
        return holder;
      }

      activateMedia(index) {
        const mediaItems = Array.from(this.dom.mediaDisplay.querySelectorAll('.how-works__media-item'));

        mediaItems.forEach((item, itemIndex) => {
          const video = item.querySelector('video');
          const isActive = itemIndex === index;

          item.classList.toggle('is-active', isActive);

          if (!video) return;

          if (isActive) {
            this.ensureVideoSource(video);
            video.currentTime = 0;
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });

        this.updateActiveMediaAspectRatio();
      }

      playActiveMedia() {
        const activeItem = this.dom.mediaDisplay.querySelector('.how-works__media-item.is-active');
        const activeVideo = activeItem ? activeItem.querySelector('video') : null;

        if (!activeVideo) return;

        this.ensureVideoSource(activeVideo);
        this.updateActiveMediaAspectRatio();
        activeVideo.play().catch(() => {});
      }

      ensureVideoSource(video) {
        if (!video) return;

        const nextSrc = this.getViewportValue(video.dataset.srcPc || '', video.dataset.srcMobile || '');

        if (!nextSrc || video.dataset.currentSrc === nextSrc) return;

        video.pause();
        video.src = nextSrc;
        video.dataset.currentSrc = nextSrc;
        video.load();
      }

      refreshActiveVideoSource() {
        const activeItem = this.dom.mediaDisplay.querySelector('.how-works__media-item.is-active');
        const activeVideo = activeItem ? activeItem.querySelector('video') : null;

        if (!activeVideo) return;

        this.ensureVideoSource(activeVideo);
        this.updateActiveMediaAspectRatio();
        activeVideo.play().catch(() => {});
      }

      updateInfo(isImmediate) {
        const steps = this.getCurrentSteps();
        const data = steps[this.state.step];

        window.clearTimeout(this.infoTimer);

        if (!data) {
          this.dom.infoText.innerHTML = '';
          this.dom.infoText.classList.remove('is-changing');
          return;
        }

        const nextHtml = this.getResponsiveHtml(data.infoPc, data.infoMobile);
        const delay = Number(this.config.infoDelay || 300);

        if (isImmediate || delay <= 0) {
          this.dom.infoText.innerHTML = nextHtml;
          this.dom.infoText.classList.remove('is-changing');
          return;
        }

        // 文案切换采用纯淡入淡出：先淡出旧文案，再替换内容并淡入，避免上下位移导致移动端抖动。
        this.dom.infoText.classList.add('is-changing');

        this.infoTimer = window.setTimeout(() => {
          this.dom.infoText.innerHTML = nextHtml;

          requestAnimationFrame(() => {
            this.dom.infoText.classList.remove('is-changing');
          });
        }, delay);
      }
    }

    const initHowWorksSections = (scope = document) => {
      scope.querySelectorAll('[data-how-works-section]').forEach((root) => {
        if (root.dataset.howWorksInitialized === 'true') return;

        root.dataset.howWorksInitialized = 'true';
        new HowWorksShowcase(root);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initHowWorksSections());
    } else {
      initHowWorksSections();
    }

    document.addEventListener('shopify:section:load', (event) => {
      initHowWorksSections(event.target);
    });
  })();
</script>


{% liquid
  assign hw_default_type = ''
  assign hw_first_type = ''

  for block in section.blocks
    if block.type == 'tab'
      assign hw_tab_key = block.settings.tab_key | default: block.id | handleize

      if hw_first_type == blank
        assign hw_first_type = hw_tab_key
      endif

      if block.settings.default_active
        assign hw_default_type = hw_tab_key
      endif
    endif
  endfor

  if hw_default_type == blank
    assign hw_default_type = hw_first_type
  endif
%}


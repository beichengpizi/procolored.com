        "custom_liquid_1": "<!--产品单独库存banner --> \n\n<style>\n.full-discount-banner-wrapper {\n    margin-bottom: 16px;\n}\n\n.full-discount-banner-container1 {\n    display: flex;\n    width: 100%;\n    padding: 6px;\n    border-radius: 10px;\n    background: linear-gradient(90deg, #FFBF00 -9.86%, #F10 51.87%, #FF00E0 115.74%);\n\n\n}\n\n.full-discount-banner-content1 {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    gap: 4px;\n    width: 100%;\n    background-color: #FFF5F5;\n    border-radius: 8px;\n    padding: 0 18px;\n    min-height: 84px;\n    overflow: hidden;\n}\n\n\n\n.full-discount-banner-title1 {\n\n    display: flex;\n    align-items: center;\n    gap: 6px;\n\n    width: 100%;\n}\n\n.full-discount-banner-title1-icon {\n    width: 26px;\n    height: 26px;\n    flex-shrink: 0;\n\n}\n\n\n.full-discount-banner-title1-text {\n    color: #000;\n    font-size: 16px;\n    font-weight: 700;\n    line-height: 1.4;\n    /* 140% */\n}\n\n.full-discount-banner-progress1-wrapper1 {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    width: 100%;\n    gap: 12px;\n\n}\n\n.full-discount-banner-progress1-info1 {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    border-radius: 99px;\n    padding: 2px 10px;\n    min-height: 26px;\n    background: linear-gradient(90deg, #FFBF00 -9.86%, #F10 51.87%, #FF00E0 115.74%);\n\n}\n\n.full-discount-banner-progress1-info1-icon {\n    display: flex;\n    width: 14px;\n    height: 14px;\n    flex-shrink: 0;\n}\n\n\n\n.full-discount-banner-progress1-info1-text {\n    color: #FFF;\n\n    font-size: 12px;\n\n    font-weight: 400;\n    line-height: 1.63;\n    /* 163.333% */\n}\n\n/* 进度条容器 */\n.full-discount-banner-progress1 {\n    --p: 40%;\n    position: relative;\n\n    flex: 1;\n    height: 16px;\n    border-radius: 12px;\n    /* 渐变动画过渡 */\n    transition: --p 0.5s;\n}\n\n/* 轨道：左渐变，右白色 */\n/* .full-discount-banner-progress1-track1 {\n    width: 100%;\n    height: 100%;\n    border-radius: inherit;\n    background: linear-gradient(90deg, #ff2ace 0%, #19d2fc 100%) 0 0 / var(--p) 100% no-repeat, #FFE7E9;\n    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3);\n\n\n    transition: background-size 0.5s cubic-bezier(0.4, 1, 0.7, 1);\n} */\n.full-discount-banner-progress1-track1 {\n    width: 100%;\n    height: 100%;\n    border-radius: inherit;\n\n\n    background:\n        /* 斜向条纹层 */\n        repeating-linear-gradient(135deg,\n            rgba(255, 255, 255, 0.25) 0px,\n            rgba(255, 255, 255, 0.25) 16px,\n            rgba(255, 255, 255, 0.05) 16px,\n            rgba(255, 255, 255, 0.05) 32px),\n        /* 橙 → 粉 渐变层 */\n        linear-gradient(90deg,\n            #ffb400 0%,\n            #ff8a4c 40%,\n            #ff6a88 70%,\n            #ff4d94 100%) 0 0 / var(--p) 100% no-repeat,\n        /* 右侧底色 */\n        #FFE7E9;\n\n    transition: background-size 0.5s cubic-bezier(0.4, 1, 0.7, 1);\n}\n\n.full-discount-banner-progress1-thumb1 {\n    position: absolute;\n    top: 50%;\n    left: calc(var(--p) - 16px);\n    width: 32px;\n    height: 32px;\n\n    transform: translateY(-50%);\n    /* 滑块位置动画 */\n    transition: left 0.5s cubic-bezier(0.4, 1, 0.7, 1);\n}\n\n\n\n\n\n@media screen and (max-width: 768px) {\n    .full-discount-banner-wrapper {\n        margin-bottom: 16px;\n    }\n\n    .full-discount-banner-container1 {\n\n        border-radius: 6px;\n\n\n\n    }\n\n    .full-discount-banner-content1 {\n\n        gap: 2px;\n\n        border-radius: 6px;\n        padding: 0 12px;\n\n    }\n\n\n\n    .full-discount-banner-title1 {\n\n\n        gap: 8px;\n\n\n    }\n\n    .full-discount-banner-title1-icon {\n        width: 24px;\n        height: 24px;\n    }\n\n\n    .full-discount-banner-title1-text {\n\n        font-size: 14px;\n\n    }\n\n    .full-discount-banner-progress1-wrapper1 {\n\n        gap: 8px;\n\n    }\n\n    .full-discount-banner-progress1-info1 {\n\n        padding: 2px 12px;\n        min-height: 20px;\n\n\n    }\n\n    .full-discount-banner-progress1-info1-icon {\n        display: flex;\n        width: 12px;\n        height: 12px;\n        flex-shrink: 0;\n    }\n\n\n\n    .full-discount-banner-progress1-info1-text {\n        font-size: 10px;\n    }\n\n    /* 进度条容器 */\n    .full-discount-banner-progress1 {\n        --p: 40%;\n        position: relative;\n\n        height: 14px;\n        border-radius: 99px;\n        /* 渐变动画过渡 */\n        transition: --p 0.5s;\n    }\n\n    /* 轨道：左渐变，右白色 */\n    /* .full-discount-banner-progress1-track1 {\n    width: 100%;\n    height: 100%;\n    border-radius: inherit;\n    background: linear-gradient(90deg, #ff2ace 0%, #19d2fc 100%) 0 0 / var(--p) 100% no-repeat, #FFE7E9;\n    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3);\n\n\n    transition: background-size 0.5s cubic-bezier(0.4, 1, 0.7, 1);\n} */\n\n\n    .full-discount-banner-progress1-thumb1 {\n        position: absolute;\n        top: 50%;\n        left: calc(var(--p) - 16px);\n        width: 32px;\n        height: 32px;\n\n        transform: translateY(-50%);\n        /* 滑块位置动画 */\n        transition: left 0.5s cubic-bezier(0.4, 1, 0.7, 1);\n    }\n\n\n\n\n\n\n\n}\n</style>\n<div class=\"full-discount-banner-wrapper\">\n<div class=\"full-discount-banner-container1\">\n    <div class=\"full-discount-banner-content1\">\n        <div class=\"full-discount-banner-title1\">\n            <span class=\"full-discount-banner-title1-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 26 26\"\n                    fill=\"none\">\n                    <path\n                        d=\"M15.1083 2.2687C14.5202 1.76749 13.7728 1.49219 13.0001 1.49219C12.2274 1.49219 11.48 1.76749 10.8919 2.2687L9.43159 3.51345C9.25814 3.66141 9.04243 3.75088 8.81518 3.76912L6.9031 3.92078C6.13287 3.98221 5.40974 4.31604 4.86338 4.8624C4.31702 5.40876 3.98319 6.1319 3.92176 6.902
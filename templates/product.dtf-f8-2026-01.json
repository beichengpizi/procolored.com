    "custom_liquid_XDRjqw": {
      "type": "custom-liquid",
      "name": "Custom liquid",
      "settings": {
        "custom_liquid": "<style>\n  .smooth-workflow-wrapper {\n      background: #000;\n      padding-top: 50px;\n      padding-bottom: 50px;\n  }\n\n  .smooth-workflow-container {\n      max-width: 1248px;\n      margin: 0 auto;\n      padding-left: 24px;\n      padding-right: 24px;\n  }\n\n  .smooth-workflow-title {\n      color: #FFF;\n      width: 100%;\n      text-align: center;\n      font-size: 40px;\n      font-weight: 800;\n      line-height: 1.22;\n      margin-bottom: 50px;\n  }\n\n  .smooth-workflow-content {\n      width: 100%;\n      display: flex;\n      gap: 10px;\n      flex-wrap: nowrap;\n      \n  }\n\n  .smooth-workflow-content-item {\n      display: flex;\n      flex-direction: column;\n      gap: 12.5%;\n      align-items: center;\n      width: 12.5%;\n      max-width:150px ;\n  }\n\n  .smooth-workflow-content-item-icon {\n      width: 100%;\n      height: auto;\n      flex-shrink: 1;\n  }\n  .smooth-workflow-content-item-icon img{\n      width: 100%;\n      max-width: 100%;\n      object-fit: cover;\n  }\n\n  .smooth-workflow-content-item-title {\n      color: #FFF;\n      text-align: center;\n      font-size: 18px;\n      font-weight: 400;\n      line-height: 1.38;\n      width: 100%;\n      max-width: 150px;\n      flex: 1;\n  }\n\n  .smooth-workflow-content-divider-line {\n      width: 38px;\n      height: 2px;\n      flex-shrink: 0;\n      border-bottom: 2px dashed #E7E7E7;\n      margin-top: 6.25%;\n  }\n\n  @media screen and (max-width: 768px) {\n      .smooth-workflow-wrapper {\n          padding-top: 30px;\n          padding-bottom: 30px;\n      }\n\n      .smooth-workflow-container {\n          max-width: 100%;\n          padding-left: 0;\n          padding-right: 0;\n      }\n\n      .smooth-workflow-title {\n          padding-left: 24px;\n          padding-right: 24px;\n          font-size: 26px;\n          margin-bottom: 30px;\n      }\n\n      .smooth-workflow-content {\n          width: 100%;\n          display: flex;\n          gap: 5px;\n          flex-wrap: nowrap;\n          max-width: 100%;\n          overflow-x: auto;\n          -webkit-overflow-scrolling: touch;\n          padding-left: 24px;\n          padding-right: 24px;\n          padding-bottom: 22px;\n          scrollbar-width: thin;\n          scrollbar-color: #e7e7e7 #fff;\n      }\n\n      .smooth-workflow-content::-webkit-scrollbar {\n          height: 8px;\n          background: #fff;\n          border-radius: 4px;\n      }\n      .smooth-workflow-content::-webkit-scrollbar-thumb {\n          background: #e7e7e7;\n          border-radius: 4px;\n      }\n\n\n\n      .smooth-workflow-content-item {\n          gap: 14px;\n          width: 100%;\n      }\n\n      .smooth-workflow-content-item-icon {\n          width: 94px;\n          height: 94px;\n      }\n\n      .smooth-workflow-content-item-title {\n          font-size: 14px;\n          max-width: 94px;\n      }\n\n      .smooth-workflow-content-divider-line {\n          width: 30px;\n          height: 1px;\n          flex-shrink: 0;\n          border-bottom: 1px dashed #E7E7E7;\n          margin-top: 47px;\n      }\n  }\n</style>\n<section class=\"smooth-workflow\" id=\"smooth-workflow\">\n      <div class=\"smooth-workflow-wrapper\">\n          <div class=\"smooth-workflow-container\">\n              <div class=\"smooth-workflow-title\">\n                  Printing Steps\n              </div>\n              <div class=\"smooth-workflow-content\">\n\n                  <div class=\"smooth-workflow-content-item\">\n                      <div class=\"smooth-workflow-content-item-icon\">\n                          <img class=\"lazyload\" data-src=\"https://cdn.shopify.com/s/files/1/0509/3454/6613/files/1_0504a3ac-adfc-4fec-a94d-2c92149a8502.png?v=1765162454\" alt=\"\">\n                      </div>\n                      <div class=\"smooth-workflow-content-item-title\">1.Adjust Design</div>\n                  </div>\n                  <div class=\"smooth-workflow-content-divider-line\">\n                  </div>\n                  <div class=\"smooth-workflow-content-item\">\n                      <div class=\"smooth-workflow-content-item-icon\">\n                          <img class=\"lazyload\" data-src=\"https://cdn.shopify.com/s/files/1/0509/3454/6613/files/Ellipse_201.png?v=1767688547\" alt=\"\">\n                      </div>\n                      <div class=\"smooth-workflow-content-item-title\">2.Printing</div>\n                  </div>\n                  <div class=\"smooth-workflow-content-divider-line\">\n                      <!-- <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 38 2\"\n                          fill=\"none\">\n                          <path d=\"M0 1H38\" stroke=\"#E7E7E7\" stroke-width=\"2\" stroke-dasharray=\"5 5\" />\n                      </svg> -->\n                  </div>\n                  <div class=\"smooth-workflow-content-item\">\n                      <div class=\"smooth-workflow-content-item-icon\">\n                          <img class=\"lazyload\" data-src=\"https://cdn.shopify.com/s/files/1/0509/3454/6613/files/3_e7a0e187-b973-401c-a8d6-f1ab360b5739.png?v=1765162453\" alt=\"\">\n                      </div>\n                      <div class=\"smooth-workflow-content-item-title\">3.Shake Powder</div>\n                  </div>\n                  <div class=\"smooth-workflow-content-divider-line\">\n\n                  </div>\n                  <div class=\"smooth-workflow-content-item\">\n                      <div class=\"smooth-workflow-content-item-icon\">\n                          <img class=\"lazyload\" data-src=\"https://cdn.shopify.com/s/files/1/0509/3454/6613/files/4_e214e5d5-ba72-4c61-be67-ba65313a54d5.png?v=1765162454\" alt=\"\">\n                      </div>\n                      <div class=\"smooth-workflow-content-item-title\">4.Oven Dry</div>\n                  </div>\n                  <div class=\"smooth-workflow-content-divider-line\">\n\n                  </div>\n                  <div class=\"smooth-workflow-content-item\">\n                      <div class=\"smooth-workflow-content-item-icon\">\n                          <img class=\"lazyload\" data-src=\"https://cdn.shopify.com/s/files/1/0509/3454/6613/files/5_feeac855-3f47-45da-a168-b287ec0e59e7.png?v=1765162453\" alt=\"\">\n                      </div>\n                      <div class=\"smooth-workflow-content-item-title\"> 5.Heat Transfer</div>\n                  </div>\n                  <div class=\"smooth-workflow-content-divider-line\">\n\n                  </div>\n                  <div class=\"smooth-workflow-content-item\">\n                      <div class=\"smooth-workflow-content-item-icon\">\n                          <img class=\"lazyload\" data-src=\"https://cdn.shopify.com/s/files/1/0509/3454/6613/files/6_352a7d16-ab35-4c7c-b79a-56235510dfad.png?v=1765162453\" alt=\"\">\n                      </div>\n                      <div class=\"smooth-workflow-content-item-title\"> 6.Peel Off Film</div>\n                  </div>\n              </div>\n          </div>\n      </div>\n  </section>"
      }
    },

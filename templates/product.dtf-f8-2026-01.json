Row.style.borderBottom = \"1px solid #eee\";\n          } else {\n              console.log(\"not collapsed\");\n              firstRow.style.borderBottom = \"1px solid #eee\";\n              lastRow.style.borderBottom = \"none\";\n          }\n          learnMore.innerHTML = infoTable.classList.contains(\"collapsed\")\n              ? `Learn more <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"7\" viewBox=\"0 0 10 7\" fill=\"none\">\n<path d=\"M9 1L5 6L1 1\" stroke=\"#1677FF\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n</svg>`\n              : `Learn more <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"7\" viewBox=\"0 0 10 7\" fill=\"none\">\n<path d=\"M9 6L5 1L1 6\" stroke=\"#1677FF\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n</svg>`;\n      });\n\n  </script>"

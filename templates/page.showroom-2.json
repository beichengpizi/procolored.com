    "custom_product_faqs_qfXCzn": {
      "type": "custom-product-faqs",
      "blocks": {
        "faq_tab_nrzUxe": {
          "type": "faq_tab",
          "name": "How long does a showroom tour take?",
          "settings": {
            "question": "How long does a showroom tour take?",
            "answer": "<p>The showroom tour time is typically 1-2 hours. </p>"
          }
        },
        "faq_tab_TwwzB6": {
          "type": "faq_tab",
          "name": "Do I need to make an appointment in advance?",
          "settings": {
            "question": "Do I need to make an appointment in advance?",
            "answer": "<p>While walk-ins are welcome, we highly recommend booking your personalized tour in advance to ensure the best possible experience. This allows us to tailor the visit to your needs and provide dedicated time with our experts.</p>"
          }
        },
        "faq_tab_PQbQER": {
          "type": "faq_tab",
          "name": "Can I schedule a group tour?",
          "settings": {
            "question": "Can I schedule a group tour?",
            "answer": "<p>Yes, we offer group tours for businesses, schools, or any organization interested in exploring our showroom. Please contact us in advance to arrange a customized group experience that suits your needs.</p>"
          }
        },
        "faq_tab_4bnBTG": {
          "type": "faq_tab",
          "name": "Is there a fee for visiting the showroom?",
          "settings": {
            "question": "Is there a fee for visiting the showroom?",
            "answer": "<p>No, visiting our showroom is completely free. We want you to have the opportunity to explore our products, ask questions, and experience our technology firsthand without any obligation.</p>"
          }
        },
        "faq_tab_ztzmJg": {
          "type": "faq_tab",
          "name": "Can I purchase the products on display in the showroom?",
          "settings": {
            "question": "Can I purchase the products on display in the showroom?",
            "answer": "<p>Yes, many of the products displayed in our showroom are available for purchase. Our staff can assist you in selecting the right products and help you with the ordering process.</p>"
          }
        },
        "faq_tab_qDr3BL": {
          "type": "faq_tab",
          "name": "How can I reschedule or cancel my booking?",
          "settings": {
            "question": "How can I reschedule or cancel my booking?",
            "answer": "<p>You can reschedule or cancel your booking directly from the order details page. </p><p>Please note: Changes are not allowed within 24 hours of the scheduled service time.</p>"
          }
        }
      },

    "custom_product_faqs_8UpJWz": {
      "type": "custom-product-faqs",
      "blocks": {
        "faq_tab_8zwCna": {
          "type": "faq_tab",
          "settings": {
            "question": "Q1: Is the exhibition invitation really free to attend?",
            "answer": "<p>No, this is not free. You can enter our invitation code \"PROC\" at checkout and get a certain discount.</p>"
          }
        },
        "faq_tab_xyVYMV": {
          "type": "faq_tab",
          "settings": {
            "question": "Q2: How long will the Exhibition Promotion Event last?",
            "answer": "<p>The Exhibition Promotion Event is a limited-time offer, running from May 19th to May 22nd (PT).</p>"
          }
        },
        "faq_tab_jP7ncr": {
          "type": "faq_tab",
          "settings": {
            "question": "Q3: Are all consumables included in the exhibition promotion?",
            "answer": "<p>Yes, all consumables are included in this promotion.</p>"
          }
        },
        "faq_tab_kUakqj": {
          "type": "faq_tab",
          "settings": {
            "question": "Q4: How can I save more on consumables?",
            "answer": "<p>The more consumables you buy, the more you save. Discounts auto apply at checkout.</p>"
          }
        },
        "faq_tab_hW77bP": {
          "type": "faq_tab",
          "settings": {
            "question": "Q5: Can I buy products at the exhibition?",
            "answer": "<p>Yes, you can purchase the machine on-site, and our staff can assist you in selecting the right products and help you with the ordering process.</p>"
          }
        },
        "faq_tab_emWdUN": {
          "type": "faq_tab",
          "settings": {
            "question": "Q6: What is your return policy for the Exhibition Promotion Event?",
            "answer": "<p>The exhibition promotion event is covered by our standard return policy. If the printer is received within one week and no ink is added, it can be shipped back in its original packaging, and returns and exchanges are accepted. Please check our full <a href=\"https://www.procolored.com/policies/refund-policy\"><strong>Return Policy page</strong></a> for more details.</p>"
          }
        },
        "faq_tab_VCY9Qq": {
          "type": "faq_tab",
          "settings": {
            "question": "Q7: What if I have issues with my order during the sale?",
            "answer": "<p>Our support team is here to help! Contact us anytime through<a href=\"https://chat.quickcep.com/h5.html?platform=others&accessId=7b656e18-cb12-4e09-aa92-8df7c651bd30\"> live chat</a> or<strong> Support@procolored.com</strong>, and we’ll assist you as soon as possible.</p>"
          }
        },
        "faq_tab_Vf9DqL": {
          "type": "faq_tab",
          "disabled": true,
          "settings": {
            "question": "Q8: Can I use installment payments to purchase products?",
            "answer": "<p>Yes, we offer flexible installment options on our website. Simply select the installment payment plan at checkout to buy your favorite printers and accessories with ease. Note: Availability, number of installments, and payment amounts may vary by region and individual eligibility.</p>"
          }
        },
        "faq_tab_aQrfUk": {
          "type": "faq_tab",
          "disabled": true,
          "settings": {
            "question": "Q9: What is your return policy for Mother's Day Promotion purchases?",
            "answer": "<p>Mother's Day Promotion purchases are covered by our standard return policy. Returns and exchanges are accepted within 7 days of delivery. To be eligible, the printer must be unused (no ink added) and returned in its original packaging. Please check our full <a href=\"https://www.procolored.com/policies/refund-policy\"><strong>Return Policy page</strong></a> for more details.<br/><br/></p>"
          }
        },
        "faq_tab_MBtbaQ": {
          "type": "faq_tab",
          "disabled": true,
          "settings": {
            "question": "Q10: What if I have issues with my order during the sale?",
            "answer": "<p>Our support team is here to help! Contact us anytime through<a href=\"https://chat.quickcep.com/h5.html?platform=others&accessId=7b656e18-cb12-4e09-aa92-8df7c651bd30\"> live chat</a> or<strong> Support@procolored.com</strong>, and we’ll assist you as soon as possible.</p>"
          }
        }
      },

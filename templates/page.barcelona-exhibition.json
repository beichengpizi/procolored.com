-section-{{ section.id }} .fespa-hero__content {\n  position: absolute;\n  left: 56px;\n  top: 50%;\n  transform: translateY(-50%);\n  width: 52%;\n  max-width: 650px;\n  z-index: 2;\ntext-align: left;\n}\n\n#shopify-section-{{ section.id }} .fespa-hero__date {\n  margin: 0 0 4px;\n  color: #1d1d1f;\n  font-size: 18px;\n  font-weight: 500;\n  line-height: 1.35;\ntext-align: left;\n}\n\n#shopify-section-{{ section.id }} .fespa-hero__title {\n  max-width: 640px;\n  margin: 0 0 16px;\n  color: #1d1d1f;\n  font-size: 32px;\n  font-weight: 800;\n  line-height: 1.18;\n  letter-spacing: 0;\ntext-align: left;\n}\n\n#shopify-section-{{ section.id }} .fespa-hero__meta {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  margin-bottom: 25px;\n}\n\n#shopify-section-{{ section.id }} .fespa-hero__meta-group {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 16px;\n}\n\n#shopify-section-{{ section.id }} .fespa-hero__meta-row {\n  display: inline-flex;\n  align-items: center;\n  width: max-content;\n  max-width: 100%;\n  min-height: 28px;\n  overflow: hidden;\n  border-radius: 999px;\n  color: #1E1E1E;\n  font-size: 14px;\n  line-height: 1;\nfont-weight: 500;\n}\n\n#shopify-section-{{ section.id }} .fespa-hero__label {\n  display: inline-flex;\n  align-items: center;\n  align-self: stretch;\n  padding: 0 12px;\n  color: #ef2d12;\n  background: #fff;\nfont-weight: 700;\n}\n\n#shopify-section-{{ section.id }} .fespa-hero__value {\n      padding: 0 12px;\n    white-space: nowrap;\n    border: 0.5px solid #000;\n    height: 28px;\n    border-radius: 0 99px 99px 0;\n    border-left: none;\n    display: flex;\n    align-items: center;\n}\n\n#shopify-section-{{ section.id }} .fespa-hero__button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 226px;\n  min-height: 48px;\n  padding: 0 28px;\n  border-radius: 999px;\n  background: #ef2d12;\n  color: #fff;\n  font-size: 18px;\n  font-weight: 800;\n  line-height: 1;\n  text-decoration: none;\n}\n\n#shopify-section-{{ section.id }} .fespa-hero__button:hover {\n  color: #fff;\n  background: #d92710;\n}\n\n@media screen and (max-width: 768px) {\n#shopify-section-{{ section.id }} .desktop {\ndisplay: none;\n}\n#shopify-section-{{ section.id }} .mb{\ndisplay: block;\n}\n\n  #shopify-section-{{ section.id }} .fespa-hero__inner {\n    border-radius: 8px;\n  }\n\n  #shopify-section-{{ section.id }} .fespa-hero__content {\n    left: 0;\n    right: 0;\n    top: 32px;\n    transform: none;\n    width: 100%;\n    max-width: none;\n    padding: 0 24px;\n    text-align: center;\n    box-sizing: border-box;\n  }\n\n  #shopify-section-{{ section.id }} .fespa-hero__date {\n    margin-bottom: 4px;\n    font-size: 12px;\ntext-align: center;\n  }\n\n  #shopify-section-{{ section.id }} .fespa-hero__title {\n    max-width: 340px;\n    margin: 0 auto 6px;\n    font-size: 24px;\n    line-height: 1.28;\ntext-align: center;\n  }\n\n  #shopify-section-{{ section.id }} .fespa-hero__meta {\n    align-items: center;\n    gap: 8px;\n    margin-bottom: 16px;\n  }\n\n  #shopify-section-{{ section.id }} .fespa-hero__meta-group {\n    flex-direction: column;\n    align-items: center;\n    gap: 8px;\n  }\n\n  #shopify-section-{{ section.id }} .fespa-hero__meta-row {\n    min-height: auto;\n    border: 0;\n    border-radius: 0;\n    background: transparent;\n    font-size: 15px;\n    line-height: 1.35;\n  }\n\n  #shopify-section-{{ section.id }} .fespa-hero__meta-row--location::before {\n    content: \"\";\n    width: 12px;\n    height: 12px;\n    margin-right: 5px;\n    background: currentColor;\n    clip-path: path(\"M6 0C3.24 0 1 2.2 1 4.92C1 8.44 6 12 6 12C6 12 11 8.44 11 4.92C11 2.2 8.76 0 6 0ZM6 6.7C5.03 6.7 4.25 5.92 4.25 4.95C4.25 3.98 5.03 3.2 6 3.2C6.97 3.2 7.75 3.98 7.75 4.95C7.75 5.92 6.97 6.7 6 6.7Z\");\n  }\n\n  #shopify-section-{{ section.id }} .fespa-hero__label {\n    display: none;\n  }\n\n  #shopify-section-{{ section.id }} .fespa-hero__value {\n    padding: 0;\n    whi
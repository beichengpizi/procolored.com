      "blocks": {
        "faq_tab_8zwCna": {
          "type": "faq_tab",
          "settings": {
            "question": "Q1: As a beginner, which printer/bundle is best for me?",
            "answer": "<p>For beginners, the K13 Lite is the perfect choice! Paired with the smokeless oven, this bundle offers a hassle-free experience for creating professional-quality prints right out of the box.</p>"
          }
        },
        "faq_tab_xyVYMV": {
          "type": "faq_tab",
          "settings": {
            "question": "Q2: What are the special Mother’s Day rewards?",
            "answer": "<p>Beyond the lucky draw, order any K13 Lite or K13 (unit or bundle) and get free consumables worth $503 with each printer.</p>"
          }
        },
        "faq_tab_jP7ncr": {
          "type": "faq_tab",
          "settings": {
            "question": "Q3: Which products can I buy to enter the lucky draw?",
            "answer": "<p>Purchase any printer between April 30 and May 10 (PT, Pacific Time) to enter the lucky draw.</p>"
          }
        },
        "faq_tab_kUakqj": {
          "type": "faq_tab",
          "settings": {
            "question": "Q4: How long is the gift card valid?",
            "answer": "<p>The gift card becomes valid once it is sent to your email. Procolored gift cards are valid for 6 months from that date.</p>"
          }
        },
        "faq_tab_hW77bP": {
          "type": "faq_tab",
          "settings": {
            "question": "Q5: What if a prize cannot be shipped to my region or is out of stock?",
            "answer": "<p>For physical prizes, if your delivery address is outside our overseas warehouse regions or the item is unavailable in your region, it will be replaced with an equivalent gift card.</p>"
          }
        },
        "faq_tab_emWdUN": {
          "type": "faq_tab",
          "settings": {
            "question": "Q6: What if I want to return my order after winning a prize?",
            "answer": "<p>If you return an order that has won a prize, unused gift cards will be cancelled, and used gift cards will be deducted from the refund at their full value.</p>"
          }
        },
        "faq_tab_VCY9Qq": {
          "type": "faq_tab",
          "settings": {
            "question": "Q7: Do I need a promo code to get a discount?",
